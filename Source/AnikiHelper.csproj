    <Error Condition="!Exists('packages\VideoLAN.LibVLC.Windows.3.0.23.1\build\x86\libvlc.dll')" Text="VideoLAN.LibVLC.Windows x86 native files are missing or incomplete. Clear the NuGet cache and restore packages." />
    <Error Condition="!Exists('packages\VideoLAN.LibVLC.Windows.3.0.23.1\build\x64\libvlc.dll')" Text="VideoLAN.LibVLC.Windows x64 native files are missing or incomplete. Clear the NuGet cache and restore packages." />
  </Target>
  <Target Name="EnsureWebView2NuGetPackage" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('packages\Microsoft.Web.WebView2.1.0.4078.44\build\Microsoft.Web.WebView2.targets')" Text="Microsoft.Web.WebView2 1.0.4078.44 is missing. Restore NuGet packages before building Aniki Helper." />
