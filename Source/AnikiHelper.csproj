  <!-- Copy x86/x64 LibVLC files without rewriting unchanged files. -->
  <Target Name="CopyAnikiLibVlcNativeFiles" AfterTargets="Build">
    <PropertyGroup>
      <AnikiLibVlcPackageBuildDir>$(MSBuildProjectDirectory)\packages\VideoLAN.LibVLC.Windows.3.0.23.1\build</AnikiLibVlcPackageBuildDir>
    </PropertyGroup>
    <ItemGroup>
      <AnikiLibVlcX86Files Include="$(AnikiLibVlcPackageBuildDir)\x86\**\*.*" Condition="Exists('$(AnikiLibVlcPackageBuildDir)\x86\libvlc.dll')" />
      <AnikiLibVlcX64Files Include="$(AnikiLibVlcPackageBuildDir)\x64\**\*.*" Condition="Exists('$(AnikiLibVlcPackageBuildDir)\x64\libvlc.dll')" />
    </ItemGroup>
    <Message Importance="high" Text="[AnikiHelper] Syncing native LibVLC x86 files (unchanged files skipped)." Condition="'@(AnikiLibVlcX86Files)' != ''" />
    <Copy SourceFiles="@(AnikiLibVlcX86Files)" DestinationFiles="@(AnikiLibVlcX86Files->'$(TargetDir)libvlc\win-x86\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Retries="2" RetryDelayMilliseconds="100" Condition="'@(AnikiLibVlcX86Files)' != ''" />
    <Message Importance="high" Text="[AnikiHelper] Syncing native LibVLC x64 files (unchanged files skipped)." Condition="'@(AnikiLibVlcX64Files)' != ''" />
    <Copy SourceFiles="@(AnikiLibVlcX64Files)" DestinationFiles="@(AnikiLibVlcX64Files->'$(TargetDir)libvlc\win-x64\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Retries="2" RetryDelayMilliseconds="100" Condition="'@(AnikiLibVlcX64Files)' != ''" />
  </Target>
