  <Target Name="EnsureLibVLCNuGetPackages" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('packages\LibVLCSharp.3.9.7.1\lib\net40\LibVLCSharp.dll')" Text="LibVLCSharp 3.9.7.1 is missing. Restore NuGet packages before building Aniki Helper." />
    <Error Condition="!Exists('packages\LibVLCSharp.WPF.3.9.7.1\lib\net461\LibVLCSharp.WPF.dll')" Text="LibVLCSharp.WPF 3.9.7.1 is missing. Restore NuGet packages before building Aniki Helper." />
