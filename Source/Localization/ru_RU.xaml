    <!-- ========= STEAM FEATURES ========= -->
    <sys:String x:Key="GroupSteamFeatures">Функции Steam</sys:String>

    <!-- Steam updates -->
    <sys:String x:Key="SteamUpdates_GroupTitle">Обновления Steam</sys:String>
    <sys:String x:Key="SteamUpdates_GroupDesc">Если включено, плагин проверяет обновления игр напрямую в Steam. Это позволяет теме показывать как новые, так и более старые записи обновлений.</sys:String>

    <sys:String x:Key="SteamUpdates_Title">Обновления игр</sys:String>
    <sys:String x:Key="SteamUpdates_Desc">Проверяет наличие недавних обновлений у ваших игр Steam.</sys:String>
    <sys:String x:Key="SteamUpdates_Enable">Включить проверку обновлений</sys:String>
    <sys:String x:Key="SteamUpdates_Enable_Help">Полностью включает или отключает проверку обновлений.</sys:String>

    <!-- Update data -->
    <sys:String x:Key="SteamInitCache_ProgressTitle">Данные обновлений</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressDesc">Плагин проверяет обновления игр Steam по мере просмотра библиотеки. Можно запустить полное сканирование библиотеки, чтобы заранее заполнить данные обновлений для всех игр, вместо ожидания при открытии каждой игры. Это снижает число ложных уведомлений и улучшает производительность навигации.</sys:String>
    <sys:String x:Key="SteamInitCache">Сканировать библиотеку</sys:String>
    <sys:String x:Key="SteamInitCache_Tooltip">Сканирует ваши игры Steam и подготавливает данные обновлений.</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressNote">Рекомендуется просканировать библиотеку, чтобы избежать ложных уведомлений и повысить производительность.</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressText">Сканирование… {0}/{1}</sys:String>
    <sys:String x:Key="LOCSteamLastScan">Последнее сканирование:</sys:String>
    <sys:String x:Key="ConfirmInitSteamCache">Просканировать библиотеку сейчас?</sys:String>
    <sys:String x:Key="InitSteamCacheDoneMsg">Сканирование завершено.</sys:String>

    <!-- Current players -->
    <sys:String x:Key="SteamPlayers_GroupTitle">Игроки сейчас</sys:String>
    <sys:String x:Key="SteamPlayers_GroupDesc">Показывает число игроков в реальном времени для поддерживаемых игр Steam.</sys:String>

    <sys:String x:Key="SteamPlayers_Title">Текущие игроки</sys:String>
    <sys:String x:Key="SteamPlayers_Desc">Показывает, сколько людей сейчас играет в игру.</sys:String>
    <sys:String x:Key="SteamPlayers_Enable">Включить счётчик игроков</sys:String>
    <sys:String x:Key="SteamPlayers_Help">Показывает текущее количество игроков для поддерживаемых игр Steam.</sys:String>

    <!-- Steam Store -->
    <sys:String x:Key="SteamStore_GroupTitle">Магазин Steam</sys:String>
    <sys:String x:Key="SteamStore_GroupDesc">Настройте отображение контента Steam Store в теме.</sys:String>

    <sys:String x:Key="SteamStore_Language_Title">Язык магазина</sys:String>
    <sys:String x:Key="SteamStore_Language_Desc">Выберите язык для контента Steam Store.</sys:String>
    <sys:String x:Key="SteamStore_Language_Label">Язык</sys:String>

    <sys:String x:Key="SteamStore_Country_Title">Страна магазина</sys:String>
    <sys:String x:Key="SteamStore_Country_Desc">Выберите страну для цен и валюты.</sys:String>
    <sys:String x:Key="SteamStore_Country_Label">Страна</sys:String>
    <sys:String x:Key="SteamStore_Country_Help">Влияет на региональные цены и отображаемую валюту.</sys:String>

    <sys:String x:Key="SteamStore_Enable_Title">Интеграция магазина</sys:String>
    <sys:String x:Key="SteamStore_Enable">Включить Steam Store</sys:String>
    <sys:String x:Key="SteamStore_Enable_Desc">Включает разделы Steam Store внутри темы.</sys:String>
    <sys:String x:Key="SteamStore_Enable_Help">Если отключено, разделы магазина больше не будут отображаться в теме.</sys:String>


    <!-- Steam account / connection -->
    <sys:String x:Key="SteamAccount_GroupTitle">Подключение аккаунта Steam</sys:String>
    <sys:String x:Key="SteamAccount_GroupDesc">Подключитесь один раз, чтобы использовать Друзей Steam, «Мой список желаемого», «Для вас» и персональные рекомендации Steam.</sys:String>
    <sys:String x:Key="SteamAccount_ConnectButton">Подключиться к Steam</sys:String>
    <sys:String x:Key="SteamAccount_ReconnectButton">Переподключиться к Steam</sys:String>
    <sys:String x:Key="SteamAccount_CheckButton">Проверить подключение</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectButton">Отключить</sys:String>
    <sys:String x:Key="SteamAccount_StatusLabel">Состояние подключения</sys:String>
    <sys:String x:Key="SteamAccount_SteamIdLabel">Аккаунт Steam:</sys:String>
    <sys:String x:Key="SteamAccount_ConfiguredBadge">НАСТРОЕНО</sys:String>
    <sys:String x:Key="SteamAccount_MissingBadge">ОТСУТСТВУЕТ</sys:String>
    <sys:String x:Key="SteamAccount_OptionalBadge">НЕОБЯЗАТЕЛЬНО</sys:String>
    <sys:String x:Key="SteamAccount_ConnectedTitle">Подключено к Steam</sys:String>
    <sys:String x:Key="SteamAccount_ConnectedDesc">Сессия Steam активна. Друзья Steam, «Мой список желаемого» и «Для вас» готовы к использованию.</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectedTitle">Нет подключения к Steam</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectedDesc">Подключите аккаунт Steam. Официальная страница входа Steam откроется и автоматически закроется после авторизации.</sys:String>
    <sys:String x:Key="SteamAccount_ProfileLabel">Обнаруженный профиль Steam / SteamID</sys:String>
    <sys:String x:Key="SteamAccount_ApiKeyTitle">Ключ Steam Web API</sys:String>
    <sys:String x:Key="SteamAccount_ApiKeyDesc">Требуется для Друзей Steam и помогает улучшать рекомендации магазина на основе ваших игр и недавней активности. Магазин может работать и без ключа, но данные о друзьях и часть персонализации будут недоступны.</sys:String>
    <sys:String x:Key="SteamAccount_ManualSteamIdTitle">Резервный SteamID</sys:String>
    <sys:String x:Key="SteamAccount_ManualSteamIdDesc">Необязательно. Используйте только если автоматическое определение SteamID не срабатывает.</sys:String>
    <sys:String x:Key="SteamAccount_PrivacyNotice">Ключ Steam Web API не требуется, а список друзей Steam может оставаться закрытым.</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoTitle">Одно подключение Steam для всего</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoDesc">Одно подключение используется для Друзей Steam, «Моего списка желаемого», «Для вас» и персональных рекомендаций. Если сессия истечёт, просто подключитесь снова.</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoPrivacy">API-ключ не требуется. Список друзей Steam может оставаться закрытым.</sys:String>
    <sys:String x:Key="SteamAccount_TokenMissingTitle">Сервисы Steam не готовы</sys:String>
    <sys:String x:Key="SteamAccount_TokenMissingDesc">Аккаунт Steam подключён, но сессию нужно обновить. Используйте «Проверить подключение» или отключитесь и подключитесь снова.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheTitle">Вход Steam постоянно перезагружается?</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheDesc">Повреждённый веб-кэш Playnite может мешать правильной загрузке страницы входа Steam.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheNote">Это очищает общий кэш браузера Playnite и перезапускает Playnite. Интеграции через браузер могут потребовать повторного входа. Вручную: Playnite Settings → Advanced → Clear web cache.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheButton">Очистить веб-кэш и перезапустить</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheConfirm">Playnite необходимо перезапустить, чтобы очистить общий веб-кэш. Интеграции через браузер могут запросить повторный вход. Продолжить?</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheError">Не удалось перезапустить Playnite и очистить веб-кэш. Используйте Playnite Settings → Advanced → Clear web cache.</sys:String>
    <sys:String x:Key="SteamFullscreen_DisconnectedSummary">Вход в Steam доступен в настройках Aniki Helper в режиме рабочего стола Playnite.</sys:String>
    <sys:String x:Key="SteamFullscreen_PrivacyHelp">Подключитесь там, вернитесь в полноэкранный режим и выберите «Проверить подключение».</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesLabel">Сервисы Steam</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesReady">Готово</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesMissing">Требуется обновление</sys:String>
    <sys:String x:Key="SteamFullscreen_ConnectedSummary">Используйте «Проверить подключение», если отображаемый статус устарел или какая-либо функция Steam перестала работать.</sys:String>

    <sys:String x:Key="SteamFullscreen_AccountLabel">Аккаунт Steam подключён</sys:String>
    <sys:String x:Key="SteamFullscreen_SteamIdLabel">SteamID обнаружен или задан</sys:String>
    <sys:String x:Key="SteamFullscreen_ApiKeyLabel">Ключ Steam Web API</sys:String>

    <sys:String x:Key="SteamFullscreen_StatusReady">Настроено</sys:String>
    <sys:String x:Key="SteamFullscreen_StatusMissing">Отсутствует</sys:String>

    <sys:String x:Key="SteamFullscreen_ConfigurationReady">Настройка Steam завершена.</sys:String>
    <sys:String x:Key="SteamFullscreen_ConfigurationMissing">Настройка Steam не завершена. Переключитесь в режим рабочего стола и откройте настройки Aniki Helper, чтобы подключить аккаунт Steam или указать недостающие данные.</sys:String>

    <!-- Steam Friends -->
    <sys:String x:Key="LOCSteamFriends_Title">Друзья Steam</sys:String>
    <sys:String x:Key="LOCSteamFriends_Subtitle">Показывает статус друзей Steam в теме Aniki: кто онлайн, текущие игры, карточки профилей и уведомления внутри темы.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Enable">Включить интеграцию Друзей Steam</sys:String>
    <sys:String x:Key="LOCSteamFriends_EnableHelp">Включает или отключает данные Друзей Steam, используемые темой.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Display">Отображение</sys:String>
    <sys:String x:Key="LOCSteamFriends_OnlineInfo">Тема может одновременно показывать до 15 друзей онлайн. Приоритет по статусу: сначала в игре, затем в сети, отошёл и занят.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ShowOffline">Показывать друзей не в сети</sys:String>
    <sys:String x:Key="LOCSteamFriends_OfflineInfo">Друзья не в сети отображаются по желанию и ограничены 40 одновременно, чтобы навигация оставалась плавной.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Notifications">Уведомления</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStart">Уведомлять, когда друг запускает игру</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStartHelp">Показывает уведомление в теме, когда друг Steam начинает играть.</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnect">Уведомлять, когда друг появляется в сети</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnectHelp">Показывает уведомление в теме, когда друг Steam появляется в сети.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedDetails_Title">Сведения об игре</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Section">Игры друзей</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Refresh">Обновить игры друзей</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Help">Создаёт локальный кэш Steam, который используется в сведениях об игре, чтобы показывать друзей, уже игравших в выбранную игру. Время сканирования зависит от количества друзей.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Preparing">Подготовка обновления игр друзей...</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Refreshing">Обновление игр друзей... {0}/{1}</sys:String>
