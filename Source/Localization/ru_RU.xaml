    <sys:String x:Key="GameLaunchSplash_VideoSound_Help">Управляет звуком только для видео splash-экранов.</sys:String>
    <sys:String x:Key="LOCAnikiHelperManageSplashScreens">Управление экранами запуска</sys:String>
    <sys:String x:Key="GameLaunchSplash_VideoEndBehavior_Title">Когда splash-видео заканчивается раньше</sys:String>
