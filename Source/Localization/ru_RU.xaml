    <sys:String x:Key="HubFeature_MusicPlayer">Музыкальный проигрыватель</sys:String>
    <sys:String x:Key="HubFeature_VideoPlayer">Aniki Media Center</sys:String>
    <sys:String x:Key="HubFeature_MusicPlayerRequiresUPS">Для открытия Музыкального плеера необходимо установить UniPlaySong.</sys:String>
