    <sys:String x:Key="WelcomeHubStartup_Desc">Choose which screen is shown when Playnite starts: your library or the Hub.</sys:String>
    <sys:String x:Key="WelcomeHubStartup_Enable">Open Hub on startup</sys:String>

    <sys:String x:Key="HubApps_Title">Hub Apps</sys:String>
    <sys:String x:Key="HubApps_Desc">Display up to 4 selected Playnite Software Tools directly in the Hub.</sys:String>
    <sys:String x:Key="HubApps_Enable">Show Apps page in the Hub</sys:String>
