    <sys:String x:Key="AppTitle">Aniki Helper</sys:String>
    <sys:String x:Key="AppSubtitle">Settings</sys:String>
    <sys:String x:Key="AppInfo">Aniki Helper provides Steam services, external plugin integrations and Aniki exclusive features for compatible themes.</sys:String>
    
    <sys:String x:Key="MoreOptionsDesktop">More options are available in the plugin settings from Playnite desktop mode.</sys:String>
    <sys:String x:Key="GroupAdditionalFeatures">Additional features</sys:String>

    <sys:String x:Key="GroupGeneral">General</sys:String>
