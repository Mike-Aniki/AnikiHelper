    <!-- ========= MEDIA GALLERY ========= -->

    <sys:String x:Key="MediaGallery_Title">Capture Gallery</sys:String>
    <sys:String x:Key="MediaGallery_Desc">Aniki Helper reads media from Screenshots Visualizer and Screenshot Utilities. Configure your screenshot folders in those plugins; Aniki Helper only reads their data and generates thumbnails to speed up navigation in the theme.</sys:String>

    <sys:String x:Key="MediaGallery_Provider_Title">Screenshot plugin</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Visualizer">Screenshots Visualizer</sys:String>
    <sys:String x:Key="MediaGallery_Provider_UtilitiesLocal">Screenshot Utilities - Local</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Help">The theme will use Aniki Helper's media list instead of binding directly to the selected screenshot plugin.</sys:String>

    <sys:String x:Key="MediaGallery_GenerateThumbnails">Media thumbnails</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Button">Generate thumbnails</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Help">Pre-generates thumbnails for all images from the screenshot plugins. The first generation may take some time, but future runs should be faster.</sys:String>

