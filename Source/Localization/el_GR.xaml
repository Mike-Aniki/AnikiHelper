    <!-- ========= DYNAMIC COLORS FEATURES ========= -->
    <sys:String x:Key="GroupDynColors">Δυναμικά χρώματα</sys:String>
    <sys:String x:Key="DynColors_Help">Χρησιμοποιήστε το αν τα χρώματα δεν ταιριάζουν με τα τρέχοντα φόντα παιχνιδιών.</sys:String>

    <sys:String x:Key="L_ClearColorCache">Επαναφορά προσωρινής μνήμης χρωμάτων</sys:String>
    <sys:String x:Key="L_ClearColorCache_Desc">Τα χρώματα αποθηκεύονται με βάση το φόντο κάθε παιχνιδιού. Αν αλλάξετε φόντα, τα αποθηκευμένα χρώματα μπορεί να μην είναι πλέον ενημερωμένα.</sys:String>
    <sys:String x:Key="L_ClearColorCache_Tooltip">Διαγράφει όλα τα αποθηκευμένα δεδομένα χρωμάτων και τα δημιουργεί ξανά από τα τρέχοντα φόντα.</sys:String>
    <sys:String x:Key="L_ClearColorCache_Done_Title">Aniki Helper</sys:String>
    <sys:String x:Key="L_ClearColorCache_Done_Body">Η προσωρινή μνήμη χρωμάτων καθαρίστηκε. Τα χρώματα θα δημιουργηθούν ξανά αυτόματα.</sys:String>
    <sys:String x:Key="L_ClearColorCache_Error_Title">Aniki Helper</sys:String>
    <sys:String x:Key="L_ClearColorCache_Error_Body">Αποτυχία εκκαθάρισης της προσωρινής μνήμης χρωμάτων:</sys:String>

    <sys:String x:Key="L_DynAutoPrecache_Title">Επεξεργασία χρωμάτων στο παρασκήνιο</sys:String>
    <sys:String x:Key="L_EnableDynamicAutoPrecache">Προφόρτωση χρωμάτων στο παρασκήνιο</sys:String>
    <sys:String x:Key="L_EnableDynamicAutoPrecache_Note">Βελτιώνει την ομαλότητα της πλοήγησης. Ενδέχεται να επηρεάσει ελαφρώς την απόδοση σε υπολογιστές χαμηλών επιδόσεων.</sys:String>
    <sys:String x:Key="L_EnableDynamicAutoPrecache_Tooltip">Σαρώνει τη βιβλιοθήκη σας και προετοιμάζει αυτόματα τα δεδομένα χρωμάτων στο παρασκήνιο.</sys:String>
    <sys:String x:Key="L_CacheManagement_Title">Διαχείριση προσωρινής μνήμης</sys:String>
    <sys:String x:Key="L_EnableDynamicAutoPrecache_Desc">Όταν είναι ενεργό, τα χρώματα δημιουργούνται αυτόματα για τη βιβλιοθήκη σας αντί να δημιουργούνται κατά την πλοήγηση.</sys:String>

    <sys:String x:Key="ConfirmClearCache">Επαναφορά προσωρινής μνήμης χρωμάτων; Τα χρώματα θα δημιουργηθούν ξανά αυτόματα.</sys:String>
    <sys:String x:Key="CacheClearedMsg">Η προσωρινή μνήμη χρωμάτων καθαρίστηκε.</sys:String>

    <!-- ========= STEAM FEATURES ========= -->
    <sys:String x:Key="GroupSteamFeatures">Δυνατότητες του Steam</sys:String>

    <!-- Steam updates -->
    <sys:String x:Key="SteamUpdates_GroupTitle">Ενημερώσεις Steam</sys:String>
    <sys:String x:Key="SteamUpdates_GroupDesc">Όταν είναι ενεργό, το πρόσθετο ελέγχει τις ενημερώσεις παιχνιδιών απευθείας από το Steam. Έτσι το θέμα μπορεί να εμφανίζει τόσο νέες όσο και παλαιότερες καταχωρίσεις ενημερώσεων.</sys:String>

    <sys:String x:Key="SteamUpdates_Title">Ενημερώσεις παιχνιδιών</sys:String>
    <sys:String x:Key="SteamUpdates_Desc">Ελέγχει αν τα παιχνίδια σας στο Steam έχουν πρόσφατες ενημερώσεις.</sys:String>
    <sys:String x:Key="SteamUpdates_Enable">Ενεργοποίηση ελέγχου για ενημερώσεις</sys:String>
    <sys:String x:Key="SteamUpdates_Enable_Help">Ενεργοποιεί ή απενεργοποιεί πλήρως τον έλεγχο για ενημερώσεις.</sys:String>

    <!-- Update data -->
    <sys:String x:Key="SteamInitCache_ProgressTitle">Δεδομένα ενημερώσεων</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressDesc">Το πρόσθετο ελέγχει τις ενημερώσεις παιχνιδιών Steam καθώς περιηγείστε στη βιβλιοθήκη σας. Μπορείτε να εκτελέσετε πλήρη σάρωση της βιβλιοθήκης για να συμπληρώσετε εκ των προτέρων τα δεδομένα ενημερώσεων για όλα τα παιχνίδια, αντί να περιμένετε να τα ανοίξετε ένα-ένα. Αυτό βοηθά στην αποφυγή λανθασμένων ειδοποιήσεων ενημέρωσης και βελτιώνει την απόδοση κατά την πλοήγηση.</sys:String>
    <sys:String x:Key="SteamInitCache">Σάρωση βιβλιοθήκης</sys:String>
    <sys:String x:Key="SteamInitCache_Tooltip">Σαρώνει τα παιχνίδια σας στο Steam και προετοιμάζει τα δεδομένα ενημερώσεων.</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressNote">Συνιστάται η σάρωση της βιβλιοθήκης για την αποφυγή λανθασμένων ειδοποιήσεων και τη βελτίωση της απόδοσης.</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressText">Σάρωση… {0}/{1}</sys:String>
    <sys:String x:Key="LOCSteamLastScan">Τελευταία σάρωση:</sys:String>
    <sys:String x:Key="ConfirmInitSteamCache">Να σαρωθεί η βιβλιοθήκη τώρα;</sys:String>
    <sys:String x:Key="InitSteamCacheDoneMsg">Η σάρωση ολοκληρώθηκε.</sys:String>

    <!-- Current players -->
    <sys:String x:Key="SteamPlayers_GroupTitle">Παίκτες τώρα</sys:String>
    <sys:String x:Key="SteamPlayers_GroupDesc">Εμφανίζει ζωντανά τον αριθμό παικτών για υποστηριζόμενα παιχνίδια Steam.</sys:String>

    <sys:String x:Key="SteamPlayers_Title">Τρέχοντες παίκτες</sys:String>
    <sys:String x:Key="SteamPlayers_Desc">Δείχνει πόσα άτομα παίζουν ένα παιχνίδι αυτή τη στιγμή.</sys:String>
    <sys:String x:Key="SteamPlayers_Enable">Ενεργοποίηση ένδειξης αριθμού παικτών</sys:String>
    <sys:String x:Key="SteamPlayers_Help">Εμφανίζει τον τρέχοντα αριθμό παικτών για υποστηριζόμενα παιχνίδια του Steam.</sys:String>

    <!-- Steam Store -->
    <sys:String x:Key="SteamStore_GroupTitle">Κατάστημα Steam</sys:String>
    <sys:String x:Key="SteamStore_GroupDesc">Ρυθμίστε τον τρόπο εμφάνισης του περιεχομένου Steam Store στο θέμα.</sys:String>

    <sys:String x:Key="SteamStore_Language_Title">Γλώσσα καταστήματος</sys:String>
    <sys:String x:Key="SteamStore_Language_Desc">Επιλέξτε τη γλώσσα που χρησιμοποιείται για το περιεχόμενο του Καταστήματος Steam.</sys:String>
