    <!-- DESCRIPTION -->
    <sys:String x:Key="AnikiNews_CustomFeed_Desc">Ενεργοποιήστε ή απενεργοποιήστε τη λειτουργία ειδήσεων.</sys:String>
    <sys:String x:Key="AnikiNews_CustomFeed_Desc2">Χρησιμοποιήστε τις προεπιλεγμένες πηγές ή ορίστε δικές σας. Μη έγκυρες ή κενές ροές θα επιστρέφουν αυτόματα στις προεπιλεγμένες πηγές.</sys:String>
    <sys:String x:Key="AnikiNews_CustomFeed_Help">Προαιρετικά: εισαγάγετε URL προσαρμοσμένης ροής RSS.</sys:String>
    <sys:String x:Key="AnikiNews_CustomFeed_Tooltip">Αντικαθιστά την προεπιλεγμένη ροή.</sys:String>

    <!-- GLOBAL CACHE -->
    <sys:String x:Key="AnikiNews_ClearCache">Επαναφορά cache ειδήσεων</sys:String>
    <sys:String x:Key="AnikiNews_ClearCache_Tooltip">Αναγκάζει τις ειδήσεις να φορτωθούν ξανά.</sys:String>
    <sys:String x:Key="AnikiNews_ClearCache_Note">Δεν χρειάζεται να το χρησιμοποιήσετε μετά από αλλαγή του URL. Η ανανέωση γίνεται αυτόματα.</sys:String>
