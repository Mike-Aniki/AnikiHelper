    <sys:String x:Key="PackCreator_ColorTitle">Color Pack</sys:String>
    <sys:String x:Key="PackCreator_ColorDesc">Δημιουργήστε μια πλήρη παλέτα χρωμάτων για το θέμα από ένα μικρό σύνολο επεξεργάσιμων χρωμάτων.</sys:String>
    <sys:String x:Key="PackCreator_LoginTitle">Login Pack</sys:String>
