    <!-- EXPLANATIONS -->
    <sys:String x:Key="AnikiNews_CustomFeed_Help2">Πρόσθετες πληροφορίες</sys:String>

    <sys:String x:Key="NewsScan_Enable_Help2_Line1">Αν το πεδίο URL μείνει κενό, χρησιμοποιείται αυτόματα η προεπιλεγμένη ροή.</sys:String>
    <sys:String x:Key="NewsScan_Enable_Help2_Line2">Αν αλλάξετε το URL, η cache ανανεώνεται αυτόματα.</sys:String>
    <sys:String x:Key="NewsScan_Enable_Help2_Line3">Δεν χρειάζεται να καθαρίσετε την cache μετά από αλλαγή του URL.</sys:String>
    <sys:String x:Key="NewsScan_Enable_Help2_Line4">Το κουμπί της cache είναι χρήσιμο μόνο αν η φόρτωση σταματήσει να λειτουργεί σωστά.</sys:String>
    <sys:String x:Key="NewsScan_Enable_Help2_Line5">Ορισμένες ροές RSS μπορεί να μην είναι συμβατές.</sys:String>

