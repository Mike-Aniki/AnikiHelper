    <!-- ========= MEDIA GALLERY ========= -->

    <sys:String x:Key="MediaGallery_Title">Συλλογή πολυμέσων</sys:String>
    <sys:String x:Key="MediaGallery_Desc">Το Aniki Helper διαβάζει αρχεία πολυμέσων από τα πρόσθετα Screenshots Visualizer και Screenshot Utilities. Διαμορφώστε τους φακέλους των στιγμιότυπων οθόνης σε αυτά τα πρόσθετα· το Aniki Helper διαβάζει μόνο τα δεδομένα τους και δημιουργεί μικρογραφίες για ταχύτερη πλοήγηση στο θέμα.</sys:String>

    <sys:String x:Key="MediaGallery_Provider_Title">Screenshot provider</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Visualizer">Screenshots Visualizer</sys:String>
    <sys:String x:Key="MediaGallery_Provider_UtilitiesLocal">Screenshot Utilities - Local</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Help">Το θέμα θα χρησιμοποιεί τη λίστα πολυμέσων του Aniki Helper αντί να συνδέεται απευθείας με το επιλεγμένο πρόσθετο στιγμιότυπων οθόνης.</sys:String>

    <sys:String x:Key="MediaGallery_GenerateThumbnails">Μικρογραφίες πολυμέσων</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Button">Δημιουργία μικρογραφιών</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Help">Δημιουργεί εκ των προτέρων μικρογραφίες για όλες τις εικόνες που εντοπίζονται μέσω των υποστηριζόμενων πρόσθετων λήψης στιγμιότυπων οθόνης. Η αρχική διαδικασία δημιουργίας ενδέχεται να διαρκέσει αρκετή ώρα, αλλά τα επόμενα ανοίγματα θα πρέπει να είναι ταχύτερα.</sys:String>

    <sys:String x:Key="MediaGallery_Status_WindowTitle">Δημιουργία μικρογραφιών</sys:String>
    <sys:String x:Key="MediaGallery_Status_Scanning">Σάρωση αρχείων πολυμέσων...</sys:String>
    <sys:String x:Key="MediaGallery_Status_Progress_Detailed">Δημιουργία μικρογραφιών... σαρώθηκαν {0}/{1}, προστέθηκαν {2}.</sys:String>
    <sys:String x:Key="MediaGallery_Status_Done_Detailed">Οι μικρογραφίες δημιουργήθηκαν: {0} προστέθηκαν / {1} σαρώθηκαν ({2} ήδη στην προσωρινή μνήμη, {3} απέτυχαν).</sys:String>
    <sys:String x:Key="MediaGallery_Status_Cancelled_Detailed">Η δημιουργία ακυρώθηκε: {0} μικρογραφίες προστέθηκαν / {1} αρχεία σαρώθηκαν.</sys:String>
    <sys:String x:Key="MediaGallery_Status_Failed">Η δημιουργία μικρογραφιών απέτυχε.</sys:String>

