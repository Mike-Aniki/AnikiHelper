    <sys:String x:Key="SteamStore_Country_Desc">Επιλέξτε τη χώρα που χρησιμοποιείται για τις τιμές και το νόμισμα.</sys:String>
    <sys:String x:Key="SteamStore_Country_Label">Χώρα</sys:String>
    <sys:String x:Key="SteamStore_Country_Help">Επηρεάζει τις τοπικές τιμές και το νόμισμα που εμφανίζεται.</sys:String>

    <sys:String x:Key="SteamStore_Enable_Title">Ενσωμάτωση Store</sys:String>
    <sys:String x:Key="SteamStore_Enable">Ενεργοποίηση του Καταστήματος Steam</sys:String>
    <sys:String x:Key="SteamStore_Enable_Desc">Ενεργοποιεί τις ενότητες Steam Store μέσα στο θέμα.</sys:String>
    <sys:String x:Key="SteamStore_Enable_Help">Όταν απενεργοποιηθούν, οι ενότητες του καταστήματος δεν θα εμφανίζονται πλέον στο θέμα.</sys:String>


    <!-- Steam account / connection -->
    <sys:String x:Key="SteamAccount_GroupTitle">Σύνδεση λογαριασμού Steam</sys:String>
    <sys:String x:Key="SteamAccount_GroupDesc">Συνδεθείτε μία φορά για να χρησιμοποιείτε τους Φίλους Steam, τη Λίστα επιθυμιών μου, το Για εσάς και εξατομικευμένες προτάσεις Steam.</sys:String>
    <sys:String x:Key="SteamAccount_ConnectButton">Σύνδεση στο Steam</sys:String>
    <sys:String x:Key="SteamAccount_ReconnectButton">Επανασύνδεση στο Steam</sys:String>
    <sys:String x:Key="SteamAccount_CheckButton">Έλεγχος σύνδεσης</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectButton">Αποσύνδεση</sys:String>
    <sys:String x:Key="SteamAccount_StatusLabel">Κατάσταση σύνδεσης</sys:String>
    <sys:String x:Key="SteamAccount_SteamIdLabel">Λογαριασμός Steam:</sys:String>
    <sys:String x:Key="SteamAccount_ConfiguredBadge">ΡΥΘΜΙΣΜΕΝΟ</sys:String>
    <sys:String x:Key="SteamAccount_MissingBadge">ΛΕΙΠΕΙ</sys:String>
    <sys:String x:Key="SteamAccount_OptionalBadge">ΠΡΟΑΙΡΕΤΙΚΟ</sys:String>
    <sys:String x:Key="SteamAccount_ConnectedTitle">Συνδεδεμένο στο Steam</sys:String>
    <sys:String x:Key="SteamAccount_ConnectedDesc">Η συνεδρία Steam είναι ενεργή. Οι Φίλοι Steam, η Λίστα επιθυμιών μου και το Για εσάς είναι έτοιμα για χρήση.</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectedTitle">Δεν υπάρχει σύνδεση στο Steam</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectedDesc">Συνδέστε τον λογαριασμό Steam. Η επίσημη σελίδα σύνδεσης του Steam θα ανοίξει και θα κλείσει αυτόματα μετά τη σύνδεση.</sys:String>
    <sys:String x:Key="SteamAccount_ProfileLabel">Εντοπισμένο προφίλ Steam / SteamID</sys:String>
    <sys:String x:Key="SteamAccount_ApiKeyTitle">Κλειδί Steam Web API</sys:String>
    <sys:String x:Key="SteamAccount_ApiKeyDesc">Απαιτείται για τους Φίλους Steam και χρησιμοποιείται για καλύτερες προτάσεις Store με βάση τα παιχνίδια που έχετε και παίξατε πρόσφατα. Το Store μπορεί να λειτουργήσει και χωρίς αυτό, αλλά τα δεδομένα φίλων και ορισμένες λειτουργίες εξατομίκευσης δεν θα είναι διαθέσιμα.</sys:String>
    <sys:String x:Key="SteamAccount_ManualSteamIdTitle">Προηγμένο εφεδρικό SteamID</sys:String>
    <sys:String x:Key="SteamAccount_ManualSteamIdDesc">Προαιρετικό. Χρησιμοποιήστε το μόνο αν αποτύχει η αυτόματη ανίχνευση SteamID.</sys:String>
    <sys:String x:Key="SteamAccount_PrivacyNotice">Δεν απαιτείται κλειδί Steam Web API και η λίστα φίλων σας στο Steam δεν χρειάζεται να είναι δημόσια.</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoTitle">Μία σύνδεση Steam για όλα</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoDesc">Η ίδια σύνδεση χρησιμοποιείται για Φίλους Steam, Λίστα επιθυμιών μου, Για εσάς και εξατομικευμένες προτάσεις. Αν λήξει η συνεδρία, απλώς συνδεθείτε ξανά.</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoPrivacy">Δεν απαιτείται κλειδί API. Η λίστα φίλων σας στο Steam μπορεί να παραμείνει ιδιωτική.</sys:String>
    <sys:String x:Key="SteamAccount_TokenMissingTitle">Οι υπηρεσίες Steam δεν είναι έτοιμες</sys:String>
    <sys:String x:Key="SteamAccount_TokenMissingDesc">Ο λογαριασμός Steam είναι συνδεδεμένος, αλλά η συνεδρία χρειάζεται ανανέωση. Χρησιμοποιήστε Έλεγχος σύνδεσης ή αποσυνδεθείτε και συνδεθείτε ξανά.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheTitle">Η σύνδεση στο Steam ανανεώνεται συνεχώς;</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheDesc">Μια κατεστραμμένη web cache του Playnite μπορεί να εμποδίσει τη σωστή φόρτωση της σελίδας σύνδεσης Steam.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheNote">Αυτό καθαρίζει την κοινόχρηστη cache του browser του Playnite και επανεκκινεί το Playnite. Οι ενσωματώσεις που βασίζονται σε browser μπορεί να απαιτήσουν νέα σύνδεση. Χειροκίνητη διαδρομή: Playnite Settings → Advanced → Clear web cache.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheButton">Εκκαθάριση web cache και επανεκκίνηση</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheConfirm">Το Playnite πρέπει να επανεκκινηθεί για να καθαρίσει την κοινόχρηστη web cache. Οι ενσωματώσεις μέσω browser μπορεί να ζητήσουν νέα σύνδεση. Συνέχεια;</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheError">Δεν ήταν δυνατή η επανεκκίνηση του Playnite και η εκκαθάριση της web cache. Χρησιμοποιήστε Playnite Settings → Advanced → Clear web cache.</sys:String>
    <sys:String x:Key="SteamFullscreen_DisconnectedSummary">Η σύνδεση στο Steam είναι διαθέσιμη από τις ρυθμίσεις του Aniki Helper στη λειτουργία Desktop του Playnite.</sys:String>
    <sys:String x:Key="SteamFullscreen_PrivacyHelp">Συνδεθείτε εκεί, επιστρέψτε στο Fullscreen και επιλέξτε Έλεγχος σύνδεσης.</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesLabel">Υπηρεσίες Steam</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesReady">Έτοιμο</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesMissing">Απαιτείται ανανέωση</sys:String>
    <sys:String x:Key="SteamFullscreen_ConnectedSummary">Χρησιμοποιήστε Έλεγχος σύνδεσης αν η εμφανιζόμενη κατάσταση είναι παρωχημένη ή αν κάποια λειτουργία Steam σταματήσει να λειτουργεί.</sys:String>

    <sys:String x:Key="SteamFullscreen_AccountLabel">Συνδεδεμένος λογαριασμός Steam</sys:String>
    <sys:String x:Key="SteamFullscreen_SteamIdLabel">Το SteamID εντοπίστηκε ή ρυθμίστηκε</sys:String>
    <sys:String x:Key="SteamFullscreen_ApiKeyLabel">Κλειδί Steam Web API</sys:String>

    <sys:String x:Key="SteamFullscreen_StatusReady">Ρυθμισμένο</sys:String>
    <sys:String x:Key="SteamFullscreen_StatusMissing">Λείπει</sys:String>

    <sys:String x:Key="SteamFullscreen_ConfigurationReady">Η ρύθμιση Steam ολοκληρώθηκε.</sys:String>
    <sys:String x:Key="SteamFullscreen_ConfigurationMissing">Η ρύθμιση Steam δεν είναι πλήρης. Μεταβείτε σε Desktop Mode και ανοίξτε τις ρυθμίσεις του Aniki Helper για να συνδέσετε τον λογαριασμό Steam ή να συμπληρώσετε τις πληροφορίες που λείπουν.</sys:String>

    <!-- Steam Friends -->
    <sys:String x:Key="LOCSteamFriends_Title">Φίλοι Steam</sys:String>
    <sys:String x:Key="LOCSteamFriends_Subtitle">Εμφανίζει την κατάσταση των φίλων σας στο Steam μέσα στο θέμα Aniki: φίλους online, τρέχοντα παιχνίδια, κάρτες προφίλ και ειδοποιήσεις μέσα στο θέμα.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Enable">Ενεργοποίηση ενσωμάτωσης Φίλων Steam</sys:String>
    <sys:String x:Key="LOCSteamFriends_EnableHelp">Ενεργοποιεί ή απενεργοποιεί τα δεδομένα Φίλων Steam που χρησιμοποιεί το θέμα.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Display">Εμφάνιση</sys:String>
    <sys:String x:Key="LOCSteamFriends_OnlineInfo">Το θέμα μπορεί να εμφανίζει έως 15 online φίλους ταυτόχρονα. Η προτεραιότητα δίνεται ανά κατάσταση: πρώτα όσοι παίζουν, μετά online, απουσιάζουν και απασχολημένοι.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ShowOffline">Εμφάνιση φίλων εκτός σύνδεσης</sys:String>
    <sys:String x:Key="LOCSteamFriends_OfflineInfo">Οι φίλοι εκτός σύνδεσης είναι προαιρετικοί και περιορίζονται σε 40 ταυτόχρονα για ομαλή πλοήγηση.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Notifications">Ειδοποιήσεις</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStart">Ειδοποίηση όταν φίλος ξεκινά παιχνίδι</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStartHelp">Εμφανίζει ειδοποίηση μέσα στο θέμα όταν ένας φίλος Steam ξεκινά να παίζει.</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnect">Ειδοποίηση όταν φίλος συνδέεται</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnectHelp">Εμφανίζει ειδοποίηση μέσα στο θέμα όταν ένας φίλος Steam συνδέεται.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedDetails_Title">Λεπτομέρειες παιχνιδιού</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Section">Παιχνίδια φίλων</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Refresh">Ανανέωση παιχνιδιών φίλων</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Help">Δημιουργεί τοπική cache Steam που χρησιμοποιεί η προβολή λεπτομερειών για να δείχνει φίλους που έχουν ήδη παίξει το επιλεγμένο παιχνίδι. Η σάρωση μπορεί να διαρκέσει ανάλογα με τον αριθμό φίλων.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Preparing">Προετοιμασία ανανέωσης παιχνιδιών φίλων...</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Refreshing">Ανανέωση παιχνιδιών φίλων... {0}/{1}</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Done">Τα παιχνίδια φίλων ανανεώθηκαν: σαρώθηκαν {0} φίλοι.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_DoneMarker">ανανεώθηκε</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Error">Η ανανέωση των παιχνιδιών φίλων απέτυχε.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_MissingConfig">Συνδέστε τον λογαριασμό Steam στις ρυθμίσεις του Aniki Helper.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_NoFriends">Η συνδεδεμένη συνεδρία Steam δεν επέστρεψε φίλους.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Empty">Η cache παιχνιδιών φίλων δεν έχει δημιουργηθεί ακόμη.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Stale">Η cache παιχνιδιών φίλων είναι παλιά. Τελευταία ανανέωση: {0}.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Loaded">Η cache παιχνιδιών φίλων φορτώθηκε. Τελευταία ανανέωση: {0}.</sys:String>
