    <!-- ========= ACHIEVEMENTS CACHE ========= -->
    <sys:String x:Key="AchievementCache_Title">Προσωρινή μνήμη αναμνήσεων επιτευγμάτων</sys:String>
    <sys:String x:Key="AchievementCache_Desc">Αναδημιουργεί τις αναμνήσεις επιτευγμάτων από το PlayniteAchievements. Χρησιμοποιήστε το αν λείπουν ή είναι παρωχημένα εικονίδια, πρόσφατα επιτεύγματα ή δεδομένα σπανιότητας.</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild">Αναμνήσεις Επιτευγμάτων</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Button">Αναδημιουργία προσωρινής μνήμης</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Help">Σαρώνει το PlayniteAchievements και αναδημιουργεί τις αναμνήσεις επιτευγμάτων που εμφανίζονται στο θέμα. Σε μεγάλες βιβλιοθήκες μπορεί να χρειαστεί λίγος χρόνος.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Scanning">Σάρωση επιτευγμάτων...</sys:String>
    <sys:String x:Key="AchievementCache_Status_Done">Η προσωρινή μνήμη αναμνήσεων επιτευγμάτων αναδημιουργήθηκε: {0} στοιχεία.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Failed">Η αναδημιουργία της προσωρινής μνήμης αναμνήσεων επιτευγμάτων απέτυχε.</sys:String>
    <sys:String x:Key="LOCAnikiHelperRefreshAchievementCacheForGame">Ανανέωση αναμνήσεων για αυτό το παιχνίδι</sys:String>
    <!-- ========= CUSTOM ICONS ========= -->
    <sys:String x:Key="CustomIcons_Title">Προσαρμοσμένα γραφικά στοιχεία</sys:String>
    <sys:String x:Key="CustomIcons_Desc">Επιλέξτε εξωτερικούς φακέλους για προσαρμοσμένα εικονίδια φίλτρων, φόντα φίλτρων, εικονίδια πηγών και εικόνες banner. Αυτά τα αρχεία αντικαθιστούν τα προεπιλεγμένα γραφικά του θέματος χωρίς να τροποποιούν τα αρχεία του.</sys:String>
    <sys:String x:Key="CustomIcons_FilterFolder">Φάκελος εικονιδίων φίλτρων</sys:String>
    <sys:String x:Key="CustomIcons_FilterBackgroundFolder">Φάκελος φόντων φίλτρων</sys:String>
    <sys:String x:Key="CustomIcons_SourceFolder">Φάκελος εικονιδίων πηγών</sys:String>
    <sys:String x:Key="CustomIcons_BannerAboveCoverFolder">Φάκελος banner πάνω από το εξώφυλλο</sys:String>
    <sys:String x:Key="CustomIcons_BannerOnCoverFolder">Φάκελος banner πάνω στο εξώφυλλο</sys:String>
    <sys:String x:Key="CustomIcons_Help">Τα εικονίδια φίλτρων και πηγών πρέπει να είναι αρχεία PNG με ακριβώς τα ίδια ονόματα που εμφανίζονται στο Playnite. Τα φόντα φίλτρων μπορούν να είναι JPG, JPEG, PNG, WEBP ή BMP και πρέπει να χρησιμοποιούν ακριβώς το όνομα της προεπιλογής φίλτρου, για παράδειγμα Installed.jpg ή Favorites.png. Αν δεν υπάρχει ακριβής αντιστοίχιση, χρησιμοποιείται η εικόνα Default. Χρησιμοποιήστε ξεχωριστούς φακέλους για banner πάνω από το εξώφυλλο και banner επάνω στο εξώφυλλο.</sys:String>
    <sys:String x:Key="BrowseFolder">Αναζήτηση...</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterFolderDialog">Επιλέξτε τον φάκελο που περιέχει τα PNG εικονίδια φίλτρων.</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterBackgroundFolderDialog">Επιλέξτε τον φάκελο που περιέχει τις εικόνες φόντου φίλτρων.</sys:String>
    <sys:String x:Key="CustomIcons_SelectSourceFolderDialog">Επιλέξτε τον φάκελο που περιέχει τα PNG εικονίδια πηγών.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerAboveCoverFolderDialog">Επιλέξτε τον φάκελο με τα PNG banner που εμφανίζονται πάνω από το εξώφυλλο.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerOnCoverFolderDialog">Επιλέξτε τον φάκελο με τα PNG banner που εμφανίζονται πάνω στο εξώφυλλο.</sys:String>

    <!-- ========= TRACK PLAYTIME FEATURES ========= -->
    <sys:String x:Key="GroupMonthly">Μηνιαίο ιστορικό</sys:String>
    <sys:String x:Key="ResetSectionTitle">Επαναφορά παρακολούθησης τρέχοντος μήνα</sys:String>
    <sys:String x:Key="BackupSectionTitle">Αποθήκευση και επαναφορά ιστορικού</sys:String>

    <sys:String x:Key="MonthlyHelp">Παρακολουθεί τον χρόνο παιχνιδιού κάθε μήνα, ώστε το θέμα να μπορεί να εμφανίζει στατιστικά όπως χρόνος παιχνιδιού αυτόν τον μήνα, παιχνίδια που παίξατε και το παιχνίδι που παίξατε περισσότερο.</sys:String>
    <sys:String x:Key="CurrentMonthData">Τρέχων μήνας:</sys:String>
    <sys:String x:Key="SnapshotTooltip">Δείχνει πότε ξεκίνησε η παρακολούθηση για τον τρέχοντα μήνα.</sys:String>

    <sys:String x:Key="ResetWarningText">Προειδοποίηση: διαγράφονται τα δεδομένα παρακολούθησης του τρέχοντος μήνα.</sys:String>
    <sys:String x:Key="ResetBtn">Επαναφορά τρέχοντος μήνα</sys:String>
    <sys:String x:Key="ResetBtnTooltip">Διαγράφει τα δεδομένα του τρέχοντος μήνα και ξεκινά ξανά την παρακολούθηση από τώρα.</sys:String>
    <sys:String x:Key="ResetBtntip">Χρησιμοποιήστε το μόνο αν θέλετε πραγματικά να διαγράψετε την παρακολούθηση αυτού του μήνα. Μετά την επαναφορά, τα στατιστικά του τρέχοντος μήνα θα ξεκινήσουν ξανά από το μηδέν.</sys:String>

    <sys:String x:Key="ExportMonthlyBackupBtn">Εξαγωγή μηνιαίων στατιστικών</sys:String>
    <sys:String x:Key="ImportMonthlyBackupBtn">Εισαγωγή μηνιαίων στατιστικών</sys:String>
    <sys:String x:Key="ExportMonthlyBackupTooltip">Εξάγει όλα τα δεδομένα μηνιαίων στατιστικών σε αρχείο αντιγράφου ασφαλείας JSON.</sys:String>
    <sys:String x:Key="ImportMonthlyBackupTooltip">Επαναφέρει τα δεδομένα μηνιαίων στατιστικών από αντίγραφο ασφαλείας JSON που εξήχθη προηγουμένως.</sys:String>
    <sys:String x:Key="MonthlyBackupHelp">Εξαγάγετε ή επαναφέρετε τα μηνιαία στατιστικά παιχνιδιού που αποθηκεύει το Aniki Helper. Χρήσιμο πριν από επανεγκατάσταση του Playnite ή επαναφορά της βιβλιοθήκης.</sys:String>
    <sys:String x:Key="MonthlyBackup_SectionTitle">Μηνιαία στατιστικά</sys:String>
    <sys:String x:Key="MonthlyBackup_ScopeNote">Αυτό το αντίγραφο ασφαλείας περιέχει μόνο δεδομένα μηνιαίων στατιστικών. Δεν επηρεάζει τη διαμόρφωση του θέματος, τον λογαριασμό Steam, τα πρόσθετα, τα παιχνίδια ή τα πολυμέσα.</sys:String>
    <sys:String x:Key="DangerZone_Title">Επικίνδυνη ζώνη</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Help">Διαγράφει οριστικά όλα τα δεδομένα μηνιαίων στατιστικών που έχει αποθηκεύσει το Aniki Helper. Η παρακολούθηση του τρέχοντος μήνα θα ξεκινήσει ξανά από τη στιγμή της διαγραφής.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Warning">Αυτή η ενέργεια δεν μπορεί να αναιρεθεί, εκτός αν έχετε εξαγάγει προηγουμένως αντίγραφο ασφαλείας.</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsBtn">Διαγραφή όλων των μηνιαίων στατιστικών</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsTooltip">Διαγράφει οριστικά όλα τα μηνιαία στατιστικά και ξεκινά ξανά την παρακολούθηση του τρέχοντος μήνα από τώρα.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Confirm">Είστε βέβαιοι ότι θέλετε να διαγράψετε οριστικά όλα τα δεδομένα μηνιαίων στατιστικών; Η παρακολούθηση του τρέχοντος μήνα θα ξεκινήσει ξανά από τώρα. Η ενέργεια δεν μπορεί να αναιρεθεί, εκτός αν έχετε εξαγάγει αντίγραφο ασφαλείας.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Success">Όλα τα δεδομένα μηνιαίων στατιστικών διαγράφηκαν. Η παρακολούθηση ξεκινά ξανά από τώρα.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Error">Σφάλμα κατά τη διαγραφή των μηνιαίων στατιστικών:</sys:String>

    <!-- ========= VIDEO FEATURES ========= -->
    <sys:String x:Key="Video">Βίντεο</sys:String>

    <sys:String x:Key="StartupIntro_Title">Ακολουθία εκκίνησης</sys:String>
    <sys:String x:Key="StartupIntro_Desc">Αναπαράγει την ακολουθία εκκίνησης όταν ανοίγει το Playnite.</sys:String>
    <sys:String x:Key="StartupIntro_Enable">Ενεργοποίηση εισαγωγικού βίντεο εκκίνησης</sys:String>
    <sys:String x:Key="IntroVideo_Help">Απενεργοποιήστε αυτό για να ξεκινήσετε το Playnite χωρίς το εισαγωγικό βίντεο</sys:String>

    <sys:String x:Key="ShutdownVideo_Title">Ακολουθία τερματισμού</sys:String>
    <sys:String x:Key="ShutdownVideo_Desc">Αναπαράγει την ακολουθία τερματισμού όταν κλείνει το Playnite.</sys:String>
    <sys:String x:Key="ShutdownVideo_Enable">Ενεργοποίηση βίντεο τερματισμού </sys:String>
    <sys:String x:Key="ShutdownVideo_Help">Απενεργοποιήστε αυτήν τη λειτουργία για να κλείσετε το Playnite χωρίς το βίντεο τερματισμού λειτουργίας.</sys:String>

    <!-- ========= SOUND FEATURES ========= -->
    <sys:String x:Key="EventSounds_Title">Ήχοι συμβάντων</sys:String>
    <sys:String x:Key="EventSounds_Desc">Αναπαράγει ηχητικά εφέ για συμβάντα όπως εκκίνηση παιχνιδιού, άνοιγμα/κλείσιμο του Playnite και ενημερώσεις βιβλιοθήκης. Χρησιμοποιεί τους ήχους που περιλαμβάνονται στο θέμα.</sys:String>
    <sys:String x:Key="EventSounds_Enable">Ενεργοποίηση ήχων συμβάντων</sys:String>
    <sys:String x:Key="EventSounds_Help">Εάν είναι ενεργοποιημένοι, απενεργοποιήστε τους ήχους διεπαφής/συμβάντων από το πρόσθετο PlayniteSounds για να αποφύγετε την επικάλυψη ήχου.</sys:String>

    <!-- ========= GameOverlay FEATURES ========= -->
    <sys:String x:Key="KeyboardMouse_Tab">Πληκτρολόγιο &amp; Ποντίκι</sys:String>
    <sys:String x:Key="KeyboardMouse_Intro">Χρησιμοποιήστε το εικονικό πληκτρολόγιο και ελέγξτε το ποντίκι των Windows απευθείας με το χειριστήριό σας. Αυτές οι λειτουργίες δουλεύουν ανεξάρτητα από το overlay μέσα στο παιχνίδι και παραμένουν διαθέσιμες όσο εκτελείται το Playnite Fullscreen.</sys:String>
    <sys:String x:Key="InGameOverlay_Tab">Επικάλυψη εντός παιχνιδιού</sys:String>
    <sys:String x:Key="InGameOverlay_Title">Επικάλυψη εντός παιχνιδιού</sys:String>
    <sys:String x:Key="InGameOverlay_Desc">Εμφανίζει ένα πάνελ γρήγορων ενεργειών Aniki πάνω από το τρέχον παιχνίδι.</sys:String>

    <sys:String x:Key="InGameOverlay_Settings_Title">Ρυθμίσεις overlay</sys:String>
    <sys:String x:Key="InGameOverlay_Settings_Desc">Ρυθμίστε το Aniki overlay μέσα στο παιχνίδι και τη συντόμευση πληκτρολογίου του.</sys:String>

    <sys:String x:Key="InGameOverlay_Enable">Ενεργοποίηση της επικάλυψης εντός παιχνιδιού</sys:String>
    <sys:String x:Key="InGameOverlay_Enable_Help">Εμφανίζει μια επικάλυψη γρήγορων ενεργειών πάνω από το τρέχον παιχνίδι.</sys:String>

    <sys:String x:Key="InGameOverlay_Hotkey_Title">Συντόμευση επικάλυψης</sys:String>
    <sys:String x:Key="InGameOverlay_Hotkey_Help">Επιλέξτε τη συντόμευση πληκτρολογίου που χρησιμοποιείται για το άνοιγμα της επικάλυψης εντός του παιχνιδιού. Κάντε επανεκκίνηση του Playnite αφού αλλάξετε αυτή τη ρύθμιση.</sys:String>

    <sys:String x:Key="InGameOverlay_ControllerShortcut_Title">Συντόμευση χειριστηρίου</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Help">Επιλέξτε τη συντόμευση χειριστηρίου για το άνοιγμα της επικάλυψης εντός του παιχνιδιού. Η υποστήριξη του κουμπιού Guide είναι πειραματική και ενδέχεται να δεσμεύεται από το Steam, τα Windows ή εργαλεία διαχείρισης χειριστηρίων.</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_StartBack">Start + Back</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_BackY">Back + Y</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Guide">Κουμπί Guide </sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Disabled">Απενεργοποιημένη</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Title">Εικονικό πληκτρολόγιο</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Desc">Επιλέξτε το εικονικό πληκτρολόγιο που χρησιμοποιεί το Aniki Helper. Μπορεί να ανοίξει από το κουμπί του overlay ή με την άμεση συντόμευση του χειριστηρίου όσο εκτελείται το Playnite Fullscreen.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Title">Πάροχος πληκτρολογίου</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Aniki">Πληκτρολόγιο Aniki</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Windows">Πληκτρολόγιο Windows</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Help">Το πληκτρολόγιο των Windows χρησιμοποιεί την τελευταία διάταξη που επιλέχθηκε στα Windows. Επιλέξτε μία φορά τη διάταξη Gamepad στις ρυθμίσεις του. Η διαθεσιμότητα εξαρτάται από την έκδοση των Windows.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Title">Άμεση συντόμευση</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_L3R3Hold">Κράτημα LS + RS (προεπιλογή)</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_BackX">Back / Select / View + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_GuideX">Guide + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Disabled">Απενεργοποιημένη</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Help">Κρατήστε LS + RS για 600 ms. Το Guide + X μπορεί να δεσμεύεται από το Steam, το Xbox Game Bar, τα Windows ή εργαλεία χειριστηρίων.</sys:String>

    <sys:String x:Key="InGameOverlay_GamepadMouse_Title">Ποντίκι με gamepad</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouse_Desc">Χρησιμοποιήστε το χειριστήριο ως ποντίκι των Windows όσο εκτελείται το Playnite Fullscreen. Ο δεξιός μοχλός κινεί τον δείκτη, ο αριστερός κάνει γρήγορη κύλιση, το A είναι αριστερό κλικ, το X δεξί κλικ και τα LT / RT προσφέρουν ακριβή κύλιση.</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Title">Συντόμευση ενεργοποίησης</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_BackR3">Κράτημα Back + RS (προεπιλογή)</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_StartL3">Κράτημα Start + LS</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_GuideY">Κράτημα Guide + Y</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Disabled">Απενεργοποιημένη</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Help">Κρατήστε την επιλεγμένη συντόμευση για 600 ms για ενεργοποίηση ή απενεργοποίηση του ποντικιού με gamepad. Μπορείτε να κρατάτε το A ενώ κινείτε τον δεξιό μοχλό για μεταφορά και απόθεση. Το Guide + Y μπορεί να δεσμεύεται από το Steam, το Xbox Game Bar, τα Windows ή εργαλεία χειριστηρίων.</sys:String>
    <sys:String x:Key="LOCGamepadMouseEnabledToast">Το ποντίκι με gamepad ενεργοποιήθηκε</sys:String>
    <sys:String x:Key="LOCGamepadMouseDisabledToast">Το ποντίκι με gamepad απενεργοποιήθηκε</sys:String>

    <sys:String x:Key="InGameOverlay_GameBehavior_Title">Συμπεριφορά παιχνιδιού όταν το overlay είναι ανοιχτό</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_DoNothing">Προεπιλογή: Καμία ενέργεια</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_SuspendGame">Αναστολή παιχνιδιού όσο το overlay είναι ανοιχτό</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_Help">Επιλέξτε αν το Aniki Helper θα αφήνει το παιχνίδι να τρέχει κανονικά ή θα παγώνει προσωρινά τη διεργασία του όσο το overlay είναι ανοιχτό, ώστε να αποφεύγονται διπλές εντολές.</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_Warning">Προειδοποίηση: δεν συνιστάται για online ή multiplayer παιχνίδια, παιχνίδια με προστασία anti-cheat ή παιχνίδια που εκτελούνται ως διαχειριστής.</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Title">Παιχνίδια που δεν αναστέλλονται ποτέ</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Help">Τα παιχνίδια που προστίθενται από δεξί κλικ → Aniki Helper → Ρυθμίσεις Overlay → Να μην αναστέλλεται ποτέ αυτό το παιχνίδι εμφανίζονται εδώ. Αποεπιλέξτε ένα παιχνίδι για να το αφαιρέσετε από τη λίστα.</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Clear">Εκκαθάριση λίστας μη αναστολής</sys:String>
    <sys:String x:Key="LOCAnikiHelperOverlayNeverSuspendThisGame">Να μην αναστέλλεται ποτέ αυτό το παιχνίδι</sys:String>
    <sys:String x:Key="LOCAnikiHelperOverlayAllowSuspendThisGame">Να επιτρέπεται αναστολή για αυτό το παιχνίδι</sys:String>

    <sys:String x:Key="InGameOverlay_Limitations_Title">Περιορισμοί</sys:String>
    <sys:String x:Key="InGameOverlay_Limitations_Desc">Αυτό το overlay είναι ένα διαφανές παράθυρο που εμφανίζεται πάνω από το παιχνίδι. Δεν ενσωματώνεται απευθείας στο παιχνίδι όπως τα overlays του Steam ή του Discord.</sys:String>
    <sys:String x:Key="InGameOverlay_Limitations_Help">Λειτουργεί καλύτερα με παιχνίδια σε borderless ή fullscreen σε παράθυρο. Ορισμένα παιχνίδια σε αποκλειστικό fullscreen, συστήματα anti-cheat ή παιχνίδια με αυξημένα δικαιώματα μπορεί να εμποδίσουν τη σωστή εμφάνιση του overlay.</sys:String>
    <sys:String x:Key="LOCInGameOverlayFooterTitle">Επικάλυψη παιχνιδού Aniki</sys:String>
    <sys:String x:Key="LOCInGameOverlayNoGameRunning">Δεν εκτελείται παιχνίδι</sys:String>
    <sys:String x:Key="LOCInGameOverlayNoActiveGame">Δεν εντοπίστηκε ενεργό παιχνίδι</sys:String>
    <sys:String x:Key="LOCInGameOverlayLessThanOneMinute">λιγότερο από 1 λεπτό</sys:String>
    <sys:String x:Key="LOCInGameOverlayQuitDialogTitle">Έξοδος από το {0};</sys:String>
    <sys:String x:Key="LOCInGameOverlayQuitDialogMessage">Αυτό θα προσπαθήσει να κλείσει το ενεργό παράθυρο του παιχνιδιού.</sys:String>

    <sys:String x:Key="LOCInGameOverlayCancel">Άκυρο</sys:String>
    <sys:String x:Key="LOCInGameOverlayConfirmQuit">Έξοδος από το παιχνίδι</sys:String>

    <sys:String x:Key="LOCInGameOverlayControlCenter">ΚΕΝΤΡΟ ΕΛΕΓΧΟΥ</sys:String>
    <sys:String x:Key="LOCInGameOverlayBackHint">B / Back για κλείσιμο</sys:String>
    <sys:String x:Key="LOCInGameOverlayReturnToPlaynite">Επιστροφή στο Playnite</sys:String>
    <sys:String x:Key="LOCInGameOverlayReturnToGame">Επιστροφή στο παιχνίδι</sys:String>
    <sys:String x:Key="LOCInGameOverlayResumeGame">Συνέχιση παιχνιδιού</sys:String>
    <sys:String x:Key="LOCInGameOverlayQuitGame">Έξοδος από το παιχνίδι</sys:String>
    <sys:String x:Key="LOCInGameOverlayGame">Παιχνίδι</sys:String>
    <sys:String x:Key="LOCInGameOverlayLastCaptures">Τελευταίες λήψεις</sys:String>
    <sys:String x:Key="LOCInGameOverlayMedia">Πολυμέσα</sys:String>
    <sys:String x:Key="LOCInGameOverlayAchievements">Επιτεύγματα</sys:String>
    <sys:String x:Key="LOCInGameOverlayGameInfo">ΠΛΗΡΟΦΟΡΙΕΣ ΠΑΙΧΝΙΔΙΟΥ</sys:String>
    <sys:String x:Key="LOCInGameOverlaySource">Πηγή</sys:String>
    <sys:String x:Key="LOCInGameOverlayPlatform">Πλατφόρμα</sys:String>
    <sys:String x:Key="LOCInGameOverlayPlaytime">Χρόνος Παιξίματος</sys:String>
    <sys:String x:Key="LOCInGameOverlaySession">Συνεδρία</sys:String>
    <sys:String x:Key="LOCInGameOverlayMediaAvailable">Καταγραφές</sys:String>
    <sys:String x:Key="LOCInGameOverlayMediaLatest">Τελευταία λήψη</sys:String>
    <sys:String x:Key="LOCInGameOverlayAchievementsUnlocked">Ξεκλειδωμένα</sys:String>
    <sys:String x:Key="LOCInGameOverlayAchievementsProgress">Πρόοδος</sys:String>
    <sys:String x:Key="LOCInGameOverlayAchievementsLatest">Τελευταίο επίτευγμα</sys:String>
    <sys:String x:Key="LOCInGameOverlayComingSoon">Σύντομα</sys:String>
    <sys:String x:Key="LOCInGameOverlayMediaCenterHint">Γρήγορη προβολή λήψεων που συνδέονται με το τρέχον παιχνίδι.</sys:String>
    <sys:String x:Key="LOCInGameOverlayMediaFutureHint">Αυτό το πάνελ μπορεί αργότερα να φιλοξενήσει χειριστήρια UPS / Spotify χωρίς αλλαγές στη λογική του παραθύρου overlay.</sys:String>

    <!-- ========= SPLASH FEATURES ========= -->
    <sys:String x:Key="SplashScreen">Οθόνη εκκίνησης</sys:String>
    <sys:String x:Key="GameLaunchSplash_Title">Οθόνη έναρξης παιχνιδιού</sys:String>
    <sys:String x:Key="GameLaunchSplash_Desc">Εμφανίζει εικόνα ή βίντεο κατά την εκκίνηση ενός παιχνιδιού. Μπορείτε να διαχειριστείτε προσαρμοσμένες οθόνες εκκίνησης από το μενού δεξιού κλικ ενός παιχνιδιού.</sys:String>
    <sys:String x:Key="GameLaunchSplash_Enable">Ενεργοποίηση οθόνης έναρξης παιχνιδιού</sys:String>
    <sys:String x:Key="GameLaunchSplash_Help">Απενεργοποιήστε το αν θέλετε τα παιχνίδια να ξεκινούν χωρίς την οθόνης έναρξης παιχνιδιού.</sys:String>

    <sys:String x:Key="LOCAnikiHelperSetCustomSplashImage">Ορισμός εικόνας οθόνης εκκίνησης</sys:String>
    <sys:String x:Key="LOCAnikiHelperReplaceCustomSplashImage">Αλλαγή εικόνας οθόνης εκκίνησης</sys:String>
    <sys:String x:Key="LOCAnikiHelperPreviewCustomSplashImage">Προεπισκόπηση εικόνας οθόνης εκκίνησης</sys:String>
    <sys:String x:Key="LOCAnikiHelperRemoveCustomSplashImage">Αφαίρεση εικόνας οθόνης εκκίνησης</sys:String>
    <sys:String x:Key="LOCAnikiHelperOpenCustomSplashFolder">Άνοιγμα φακέλου εικόνων οθόνης εκκίνησης</sys:String>

