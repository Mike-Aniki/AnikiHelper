<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="AppTitle">Aniki Helper</sys:String>
    <sys:String x:Key="AppSubtitle">Ρυθμίσεις</sys:String>
    <sys:String x:Key="AppInfo">Το Aniki Helper παρέχει υπηρεσίες Steam, ενσωματώσεις εξωτερικών πρόσθετων και αποκλειστικές λειτουργίες Aniki για συμβατά θέματα.</sys:String>
    
    <sys:String x:Key="MoreOptionsDesktop">Περισσότερες επιλογές είναι διαθέσιμες στις ρυθμίσεις του πρόσθετου, από τη λειτουργία επιφάνειας εργασίας του Playnite.</sys:String>
    <sys:String x:Key="GroupAdditionalFeatures">Πρόσθετα χαρακτηριστικά</sys:String>

    <sys:String x:Key="GroupGeneral">Γενικά</sys:String>
    <sys:String x:Key="GroupNews">Ειδήσεις</sys:String>
    <sys:String x:Key="GroupDynamicColors">Δυναμικά χρώματα</sys:String>
    <sys:String x:Key="GameLaunchSplash_VideoVolume_Title">Ένταση ήχου βίντεο</sys:String>
    <sys:String x:Key="GameLaunchSplash_BackgroundDimming_Title">Σκοτείνιασμα φόντου</sys:String>
    <sys:String x:Key="GameLaunchSplash_BackgroundDimming_Help">Ρυθμίζει το μόνιμο σκοτεινό επίπεδο πάνω στις εικόνες της οθόνης εκκίνησης. Τα βίντεο δεν σκοτεινιάζουν. Προεπιλογή: 37%.</sys:String>
<sys:String x:Key="LOCDebugLogsTitle">Αποσφαλμάτωση</sys:String>
    <sys:String x:Key="LOCDebugLogsDescription">Ενεργοποιήστε το μόνο κατά την αντιμετώπιση προβλήματος και όταν χρειάζεται να στείλετε αναφορά αποσφαλμάτωσης. Καταγράφει λεπτομερείς πληροφορίες του Aniki Helper στο extensions.log και μπορεί να δημιουργήσει πολλές καταχωρίσεις.</sys:String>
    <sys:String x:Key="LOCEnableDebugLogs">Ενεργοποίηση αρχείων καταγραφής αποσφαλμάτωσης</sys:String>
    <sys:String x:Key="LOCDebugLogsInfo">Για καθαρή αναφορά αποσφαλμάτωσης: καθαρίστε το αρχείο καταγραφής, ενεργοποιήστε τη Λειτουργία Αποσφαλμάτωσης, αναπαράγετε το πρόβλημα και μετά στείλτε το extensions.log. Η Λειτουργία Αποσφαλμάτωσης απενεργοποιείται αυτόματα μετά από 24 ώρες, στην επόμενη εκκίνηση του Playnite.</sys:String>
    <sys:String x:Key="LOCClearLogFile">Εκκαθάριση αρχείου καταγραφής</sys:String>
    <sys:String x:Key="LOCOpenLogsFolder">Άνοιγμα φακέλου καταγραφών</sys:String>

    <!-- ========= HUB FEATURES ========= -->
    <sys:String x:Key="WelcomeHubStartup_Title">Αρχική Οθόνη</sys:String>
    <sys:String x:Key="WelcomeHubStartup_Desc">Επιλέξτε ποια οθόνη θα εμφανίζεται κατά την εκκίνηση του Playnite: η βιβλιοθήκη σας ή το Κέντρο Ελέγχου.</sys:String>
    <sys:String x:Key="WelcomeHubStartup_Enable">Άνοιγμα του Κέντρου Ελέγχου κατά την εκκίνηση</sys:String>

    <sys:String x:Key="HubApps_Title">Λειτουργίες &amp; Εφαρμογές Κέντρου</sys:String>
    <sys:String x:Key="HubApps_Desc">Εμφανίστε έως 4 ενσωματωμένες λειτουργίες Aniki ή Εργαλεία Λογισμικού του Playnite απευθείας στο Κέντρο Ελέγχου.</sys:String>
    <sys:String x:Key="HubApps_Enable">Εμφάνιση της σελίδας Λειτουργίες &amp; Εφαρμογές στο Κέντρο Ελέγχου</sys:String>
    <sys:String x:Key="HubApps_Slot1">Θέση 1</sys:String>
    <sys:String x:Key="HubApps_Slot2">Θέση 2</sys:String>
    <sys:String x:Key="HubApps_Slot3">Θέση 3</sys:String>
    <sys:String x:Key="HubApps_Slot4">Θέση 4</sys:String>
    <sys:String x:Key="HubApps_Help">Επιλέξτε έως 4 ενσωματωμένες λειτουργίες Aniki ή Εργαλεία Λογισμικού του Playnite. Οι ενσωματωμένες λειτουργίες περιλαμβάνουν το πρόγραμμα περιήγησης, τη Συλλογή Στιγμιότυπων, τους Φίλους Steam, το Steam Store, το Πρόγραμμα Αναπαραγωγής Μουσικής και το Aniki Media Center. Προαιρετικά, μπορείτε να ορίσετε προσαρμοσμένο φόντο για κάθε θέση· διαφορετικά, το θέμα χρησιμοποιεί το προεπιλεγμένο φόντο για τις λειτουργίες Aniki και ένα γενικό εφεδρικό φόντο για τα Εργαλεία Λογισμικού.</sys:String>
    <sys:String x:Key="HubApps_SelectBackgroundDialog">Επιλέξτε εικόνα φόντου για αυτή την κάρτα εφαρμογής στο Κέντρο Ελέγχου.</sys:String>
    <sys:String x:Key="BrowseImage">Εικόνα...</sys:String>
    <sys:String x:Key="HubApps_None">Καμία</sys:String>
    <sys:String x:Key="HubApps_GroupAnikiFeatures">ΛΕΙΤΟΥΡΓΙΕΣ ANIKI</sys:String>
    <sys:String x:Key="HubApps_GroupSoftwareTools">ΕΡΓΑΛΕΙΑ ΛΟΓΙΣΜΙΚΟΥ</sys:String>
    <sys:String x:Key="HubFeature_WebBrowser">Πρόγραμμα περιήγησης Aniki</sys:String>
    <sys:String x:Key="HubFeature_MediaGallery">Συλλογή Στιγμιότυπων</sys:String>
    <sys:String x:Key="HubFeature_SteamFriends">Φίλοι στο Steam</sys:String>
    <sys:String x:Key="HubFeature_SteamStore">Κατάστημα Steam</sys:String>
    <sys:String x:Key="HubFeature_MusicPlayer">Αναπαραγωγή Μουσικής</sys:String>
    <sys:String x:Key="HubFeature_VideoPlayer">Αναπαραγωγή Βίντεο</sys:String>
    <sys:String x:Key="HubFeature_MusicPlayerRequiresUPS">Για να ανοίξει το Πρόγραμμα Αναπαραγωγής Μουσικής, πρέπει να είναι εγκατεστημένο το UniPlaySong.</sys:String>
    <sys:String x:Key="HubApps_Loading">Φόρτωση επιλεγμένων συντομεύσεων...</sys:String>
    <sys:String x:Key="HubApps_Empty">Επιλέξτε λειτουργίες ή εφαρμογές στις ρυθμίσεις του Aniki Helper.</sys:String>
    <sys:String x:Key="LOCHubAppsTitle">Χαρακτηριστικά &amp; Εφαρμογές</sys:String>
    <sys:String x:Key="LOCHubAppsSubtitle">Ενσωματωμένες λειτουργίες του Aniki και επιλεγμένα εργαλεία λογισμικού</sys:String>

    <sys:String x:Key="WelcomeHubStartup_Help">Αν απενεργοποιηθεί, το Playnite θα ανοίγει απευθείας στη συλλογή σας.</sys:String>
    <sys:String x:Key="HubVideoCenterPage_Enable">Εμφάνιση της σελίδας Aniki Media Center στο Κέντρο Ελέγχου</sys:String>
    <sys:String x:Key="HubVideoCenterPage_Help">Εμφανίζει έως τέσσερις αποθηκευμένες κάρτες πολυμέσων από τα Πρόσφατα προβεβλημένα και Πρόσφατα προστέθηκαν. Η σελίδα κρύβεται αυτόματα όταν το Media Center δεν έχει περιεχόμενο.</sys:String>

