    <!-- ========= ANIKI SCREENSAVER ========= -->
    <sys:String x:Key="SettingsNav_ScreenSaver">Aniki ScreenSaver</sys:String>
    <sys:String x:Key="SettingsPage_ScreenSaverDesc">Παρουσιάζει αυτόματα παιχνίδια από τη βιβλιοθήκη σας μετά από περίοδο αδράνειας.</sys:String>
    <sys:String x:Key="ScreenSaver_Enable">Ενεργοποίηση Aniki ScreenSaver</sys:String>
    <sys:String x:Key="ScreenSaver_Enable_Help">Το ScreenSaver ξεκινά μόνο σε λειτουργία Fullscreen όταν το Playnite βρίσκεται στο προσκήνιο, δεν εκτελείται παιχνίδι και δεν είναι ανοιχτό δευτερεύον παράθυρο Aniki. Οποιαδήποτε είσοδος το κλείνει αμέσως.</sys:String>
    <sys:String x:Key="ScreenSaver_IdleDelay_Title">Έναρξη μετά από αδράνεια</sys:String>
    <sys:String x:Key="ScreenSaver_ChangeInterval_Title">Αλλαγή παιχνιδιού κάθε</sys:String>
    <sys:String x:Key="ScreenSaver_Source_Title">Πηγή παιχνιδιών</sys:String>
    <sys:String x:Key="ScreenSaver_Source_Help">Επιλέξτε ποιο τμήμα της βιβλιοθήκης Playnite θα χρησιμοποιείται. Τα κρυφά παιχνίδια εξαιρούνται πάντα.</sys:String>
    <sys:String x:Key="ScreenSaver_Source_AllGames">Όλα τα παιχνίδια</sys:String>
    <sys:String x:Key="ScreenSaver_Source_InstalledGames">Εγκατεστημένα παιχνίδια</sys:String>
    <sys:String x:Key="ScreenSaver_Source_Favorites">Αγαπημένα</sys:String>
    <sys:String x:Key="ScreenSaver_Source_NeverPlayed">Δεν παίχτηκε ποτέ</sys:String>
    <sys:String x:Key="ScreenSaver_Source_RecentlyAdded">Προστέθηκαν πρόσφατα</sys:String>
    <sys:String x:Key="ScreenSaver_Source_CurrentFilter">Τρέχον φίλτρο Playnite</sys:String>
    <sys:String x:Key="ScreenSaver_Source_WeightedRandom">Σταθμισμένη τυχαία επιλογή</sys:String>
    <sys:String x:Key="ScreenSaver_UseSplashImages">Χρήση εικόνων Splash Screen όταν είναι διαθέσιμες</sys:String>
    <sys:String x:Key="ScreenSaver_UseSplashImages_Help">Χρησιμοποιεί την ίδια προτεραιότητα εικόνων που έχει ρυθμιστεί για τα Splash Screen κατά την εκκίνηση παιχνιδιού. Τα βίντεο αγνοούνται και χρησιμοποιείται το φόντο του παιχνιδιού.</sys:String>
    <sys:String x:Key="ScreenSaver_AmbientMusic">Αναπαραγωγή μουσικής περιβάλλοντος στο ScreenSaver</sys:String>
    <sys:String x:Key="ScreenSaver_AmbientMusic_Help">Θέτει σε παύση τη μουσική του θέματος και το UniPlaySong και στη συνέχεια αναπαράγει σε βρόχο τη μουσική περιβάλλοντος του ScreenSaver μέχρι να κλείσει. Το UPS Radio Mode παραμένει ενεργό.</sys:String>
    <sys:String x:Key="ScreenSaver_ShowLogo">Εμφάνιση λογότυπου παιχνιδιού</sys:String>
    <sys:String x:Key="ScreenSaver_ShowInfoCard">Εμφάνιση κάρτας πληροφοριών παιχνιδιού</sys:String>
    <sys:String x:Key="ScreenSaver_AnimateBackground">Κίνηση φόντων με αργό ζουμ</sys:String>
    <sys:String x:Key="ScreenSaver_UseFadeTransitions">Χρήση ομαλών μεταβάσεων μεταξύ παιχνιδιών</sys:String>
    <sys:String x:Key="ScreenSaver_Preview">Προεπισκόπηση ScreenSaver</sys:String>
    <sys:String x:Key="ScreenSaver_Preview_Help">Η προεπισκόπηση ανοίγει αμέσως. Πατήστε οποιοδήποτε πλήκτρο ή χρησιμοποιήστε ποντίκι/χειριστήριο για να την κλείσετε.</sys:String>
