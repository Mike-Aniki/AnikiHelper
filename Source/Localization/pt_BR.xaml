    <sys:String x:Key="StartupIntro_Title">Sequência de inicialização</sys:String>
    <sys:String x:Key="StartupIntro_Desc">Reproduz a sequência de inicialização quando o Playnite inicia.</sys:String>
    <sys:String x:Key="StartupIntro_Enable">Ativar sequência de inicialização</sys:String>
    <sys:String x:Key="IntroVideo_Help">Desative isto para iniciar o Playnite sem a sequência de inicialização.</sys:String>

    <sys:String x:Key="ShutdownVideo_Title">Sequência de encerramento</sys:String>
    <sys:String x:Key="ShutdownVideo_Desc">Reproduz a sequência de encerramento quando o Playnite é fechado.</sys:String>
    <sys:String x:Key="ShutdownVideo_Enable">Ativar sequência de encerramento</sys:String>
    <sys:String x:Key="ShutdownVideo_Help">Desative isto para fechar o Playnite sem a sequência de encerramento.</sys:String>

    <!-- ========= SOUND FEATURES ========= -->
    <sys:String x:Key="EventSounds_Title">Sons de eventos</sys:String>
    <sys:String x:Key="EventSounds_Desc">Reproduz efeitos sonoros para eventos como iniciar um jogo, iniciar/fechar o Playnite e atualizar a biblioteca. Funciona com os sons incluídos no tema.</sys:String>
    <sys:String x:Key="EventSounds_Enable">Ativar sons de eventos</sys:String>
    <sys:String x:Key="EventSounds_Help">Se ativado, desative os sons de interface/eventos do plugin PlayniteSounds para evitar áudio duplicado.</sys:String>

    <!-- ========= GameOverlay FEATURES ========= -->
    <sys:String x:Key="KeyboardMouse_Tab">Teclado e Mouse</sys:String>
    <sys:String x:Key="KeyboardMouse_Intro">Use o teclado virtual e controle o mouse do Windows diretamente com seu controle. Esses recursos funcionam independentemente do overlay em jogo e continuam disponíveis enquanto o Playnite Fullscreen estiver em execução.</sys:String>
    <sys:String x:Key="InGameOverlay_Tab">Overlay em Jogo</sys:String>
    <sys:String x:Key="InGameOverlay_Title">Overlay em Jogo</sys:String>
    <sys:String x:Key="InGameOverlay_Desc">Exibe um painel de ações rápidas do Aniki sobre o jogo atual.</sys:String>

    <sys:String x:Key="InGameOverlay_Settings_Title">Configurações do overlay</sys:String>
    <sys:String x:Key="InGameOverlay_Settings_Desc">Configure o overlay em jogo do Aniki e seu atalho de teclado.</sys:String>

    <sys:String x:Key="InGameOverlay_Enable">Ativar sobreposição no jogo</sys:String>
    <sys:String x:Key="InGameOverlay_Enable_Help">Ativa o overlay em jogo próprio do Aniki Helper. Desative isto se preferir usar o overlay do Playnite ou outra solução de overlay.</sys:String>

    <sys:String x:Key="InGameOverlay_Hotkey_Title">Atalho da sobreposição</sys:String>
    <sys:String x:Key="InGameOverlay_Hotkey_Help">Escolha o atalho de teclado usado para abrir a sobreposição no jogo. Reinicie o Playnite após alterar esta configuração.</sys:String>

    <sys:String x:Key="InGameOverlay_ControllerShortcut_Title">Atalho do controle</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Help">Escolha o atalho do controle usado para abrir a sobreposição no jogo. O suporte ao botão Guide é experimental e pode ser capturado pelo Steam, Windows ou ferramentas de controle.</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_StartBack">Start + Back</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_BackY">Back + Y</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Guide">Botão Guide</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Disabled">Desativado</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Title">Teclado virtual</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Desc">Escolha o teclado virtual usado pelo Aniki Helper. Ele pode ser aberto pelo botão do overlay ou pelo atalho direto do controle enquanto o Playnite Fullscreen estiver em execução.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Title">Provedor de teclado</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Aniki">Teclado Aniki</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Windows">Teclado do Windows</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Help">O teclado do Windows usa o último layout selecionado no Windows. Selecione o layout Gamepad uma vez nas configurações dele. A disponibilidade depende da versão do Windows.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Title">Atalho direto</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_L3R3Hold">Segurar LS + RS (padrão)</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_BackX">Back / Select / View + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_GuideX">Guide + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Disabled">Desativado</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Help">Segure LS + RS por 600 ms. Guide + X pode ser interceptado pela Steam, Xbox Game Bar, Windows ou ferramentas de controle.</sys:String>

    <sys:String x:Key="InGameOverlay_GamepadMouse_Title">Mouse pelo Gamepad</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouse_Desc">Use o controle como mouse do Windows enquanto o Playnite Fullscreen estiver em execução. O analógico direito move o ponteiro, o analógico esquerdo rola rapidamente, A é o clique esquerdo, X é o clique direito e LT / RT oferecem rolagem precisa.</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Title">Atalho de ativação</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_BackR3">Segurar Back + RS (padrão)</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_StartL3">Segurar Start + LS</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_GuideY">Segurar Guide + Y</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Disabled">Desativado</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Help">Segure o atalho selecionado por 600 ms para ativar ou desativar o Mouse pelo Gamepad. A pode ser mantido pressionado enquanto move o analógico direito para arrastar e soltar. Guide + Y pode ser interceptado pela Steam, Xbox Game Bar, Windows ou ferramentas de controle.</sys:String>
    <sys:String x:Key="LOCGamepadMouseEnabledToast">Mouse pelo Gamepad ativado</sys:String>
    <sys:String x:Key="LOCGamepadMouseDisabledToast">Mouse pelo Gamepad desativado</sys:String>

