    <!-- ========= ACHIEVEMENTS CACHE ========= -->
    <sys:String x:Key="AchievementCache_Title">Cache de Memórias de Conquistas</sys:String>
    <sys:String x:Key="AchievementCache_Desc">Reconstrói as memórias de conquistas a partir do PlayniteAchievements. Use isto se ícones, conquistas recentes ou dados de raridade estiverem ausentes ou desatualizados.</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild">Memórias de Conquistas</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Button">Reconstruir cache</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Help">Verifica o PlayniteAchievements e reconstrói as memórias de conquistas exibidas no tema. Isso pode levar algum tempo em bibliotecas grandes.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Scanning">Verificando conquistas...</sys:String>
    <sys:String x:Key="AchievementCache_Status_Done">Cache de memórias de conquistas reconstruído: {0} itens.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Failed">Falha ao reconstruir o cache de memórias de conquistas.</sys:String>
    <sys:String x:Key="LOCAnikiHelperRefreshAchievementCacheForGame">Atualizar as memórias deste jogo</sys:String>
    <!-- ========= CUSTOM ICONS ========= -->
    <sys:String x:Key="CustomIcons_Title">Recursos personalizados</sys:String>
    <sys:String x:Key="CustomIcons_Desc">Escolha pastas externas para ícones de filtros, fundos de filtros, ícones de fontes e imagens de banners personalizados. Esses arquivos substituem os visuais padrão do tema sem modificar os arquivos do tema.</sys:String>
    <sys:String x:Key="CustomIcons_FilterFolder">Pasta de ícones de filtros</sys:String>
    <sys:String x:Key="CustomIcons_FilterBackgroundFolder">Pasta de fundos de filtros</sys:String>
    <sys:String x:Key="CustomIcons_SourceFolder">Pasta de ícones de fontes</sys:String>
    <sys:String x:Key="CustomIcons_BannerAboveCoverFolder">Pasta de banners acima da capa</sys:String>
    <sys:String x:Key="CustomIcons_BannerOnCoverFolder">Pasta de banners sobre a capa</sys:String>
    <sys:String x:Key="CustomIcons_Help">Os ícones de filtros e fontes devem ser arquivos PNG com exatamente os nomes exibidos no Playnite. Os fundos de filtros podem usar JPG, JPEG, PNG, WEBP ou BMP com o nome exato da predefinição do filtro, por exemplo Installed.jpg ou Favorites.png. Uma imagem Default é usada quando não há correspondência exata. Use pastas separadas para banners acima da capa e sobre a capa.</sys:String>
    <sys:String x:Key="BrowseFolder">Procurar...</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterFolderDialog">Selecione a pasta que contém seus ícones PNG de filtros.</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterBackgroundFolderDialog">Selecione a pasta que contém suas imagens de fundo dos filtros.</sys:String>
    <sys:String x:Key="CustomIcons_SelectSourceFolderDialog">Selecione a pasta que contém seus ícones PNG de fontes.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerAboveCoverFolderDialog">Selecione a pasta que contém suas imagens PNG de banners acima da capa.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerOnCoverFolderDialog">Selecione a pasta que contém suas imagens PNG de banners sobre a capa.</sys:String>

    <!-- ========= TRACK PLAYTIME FEATURES ========= -->
    <sys:String x:Key="GroupMonthly">Histórico mensal</sys:String>
    <sys:String x:Key="ResetSectionTitle">Redefinir acompanhamento do mês atual</sys:String>
    <sys:String x:Key="BackupSectionTitle">Salvar e restaurar seu histórico</sys:String>

    <sys:String x:Key="MonthlyHelp">Acompanha seu tempo de jogo a cada mês para que o tema possa mostrar estatísticas como tempo jogado neste mês, jogos jogados e seu jogo mais jogado.</sys:String>
    <sys:String x:Key="CurrentMonthData">Mês atual:</sys:String>
    <sys:String x:Key="SnapshotTooltip">Mostra quando o acompanhamento do mês atual começou.</sys:String>

    <sys:String x:Key="ResetWarningText">Aviso: isso exclui os dados de acompanhamento do mês atual.</sys:String>
    <sys:String x:Key="ResetBtn">Redefinir acompanhamento do mês atual</sys:String>
    <sys:String x:Key="ResetBtnTooltip">Exclui os dados de acompanhamento do mês atual e recomeça a partir de agora.</sys:String>
    <sys:String x:Key="ResetBtntip">Não use isto a menos que realmente queira apagar o acompanhamento deste mês. As estatísticas mensais do mês atual voltarão a zero após a redefinição.</sys:String>

    <sys:String x:Key="ExportMonthlyBackupBtn">Exportar Estatísticas Mensais</sys:String>
    <sys:String x:Key="ImportMonthlyBackupBtn">Importar Estatísticas Mensais</sys:String>
    <sys:String x:Key="ExportMonthlyBackupTooltip">Exporta todos os dados de Estatísticas Mensais para um arquivo de backup JSON.</sys:String>
    <sys:String x:Key="ImportMonthlyBackupTooltip">Restaura os dados de Estatísticas Mensais a partir de um backup JSON exportado anteriormente.</sys:String>
    <sys:String x:Key="MonthlyBackupHelp">Exporte ou restaure as estatísticas mensais de jogo salvas pelo Aniki Helper. Isso é útil antes de reinstalar o Playnite ou redefinir sua biblioteca.</sys:String>
    <sys:String x:Key="MonthlyBackup_SectionTitle">Estatísticas mensais</sys:String>
    <sys:String x:Key="MonthlyBackup_ScopeNote">Este backup contém apenas dados de Estatísticas Mensais. Ele não afeta a configuração do tema, sua conta Steam, plugins, jogos ou mídias.</sys:String>
    <sys:String x:Key="DangerZone_Title">Zona de perigo</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Help">Exclui permanentemente todos os dados de Estatísticas Mensais salvos pelo Aniki Helper. O acompanhamento do mês atual será reiniciado a partir do momento em que os dados forem excluídos.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Warning">Esta ação não pode ser desfeita, a menos que você tenha exportado um backup anteriormente.</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsBtn">Excluir todas as Estatísticas Mensais</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsTooltip">Exclui permanentemente todas as estatísticas mensais e reinicia o acompanhamento do mês atual a partir de agora.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Confirm">Tem certeza de que deseja excluir permanentemente todos os dados de Estatísticas Mensais? O acompanhamento do mês atual será reiniciado a partir de agora. Esta ação não pode ser desfeita, a menos que você tenha exportado um backup.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Success">Todos os dados de Estatísticas Mensais foram excluídos. O acompanhamento recomeça a partir de agora.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Error">Erro ao excluir dados de Estatísticas Mensais:</sys:String>

    <!-- ========= VIDEO FEATURES ========= -->
