    <sys:String x:Key="L_EnableDynamicAutoPrecache_Tooltip">Verifique sua biblioteca e prepare os dados de cor automaticamente em segundo plano.</sys:String>
    <sys:String x:Key="L_CacheManagement_Title">Gerenciamento de cache</sys:String>
