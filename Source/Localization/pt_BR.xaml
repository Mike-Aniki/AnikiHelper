    <sys:String x:Key="HubApps_Title">Recursos e apps do Hub</sys:String>
    <sys:String x:Key="HubApps_Desc">Exiba até 4 recursos integrados do Aniki ou Ferramentas de Software do Playnite diretamente no Hub.</sys:String>
    <sys:String x:Key="HubApps_Enable">Mostrar a página Recursos e Apps no Hub</sys:String>
