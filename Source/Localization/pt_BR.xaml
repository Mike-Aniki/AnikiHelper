    <sys:String x:Key="GroupDynColors">Cores dinâmicas</sys:String>
    <sys:String x:Key="DynColors_Help">Use isto se as cores não combinarem com os fundos atuais dos seus jogos.</sys:String>

    <sys:String x:Key="L_ClearColorCache">Redefinir cache de cores</sys:String>
    <sys:String x:Key="L_ClearColorCache_Desc">As cores são armazenadas com base no fundo de cada jogo. Se você alterar os fundos, as cores salvas podem ficar desatualizadas.</sys:String>
    <sys:String x:Key="L_ClearColorCache_Tooltip">Limpar todos os dados de cor armazenados e recriá-los a partir dos fundos atuais.</sys:String>
