    <sys:String x:Key="PackCreator_VisualTitle">Visual Pack</sys:String>
    <sys:String x:Key="PackCreator_VisualDesc">Personalize os planos de fundo e os recursos visuais usados no Aniki ReMake.</sys:String>
    <sys:String x:Key="PackCreator_ColorTitle">Color Pack</sys:String>
