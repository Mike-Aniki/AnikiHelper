    <!-- ========= MEDIA GALLERY ========= -->

    <sys:String x:Key="MediaGallery_Title">Galeria de Capturas</sys:String>
    <sys:String x:Key="MediaGallery_Desc">O Aniki Helper lê mídias do Screenshots Visualizer e do Screenshot Utilities. Configure suas pastas de capturas nesses plugins; o Aniki Helper apenas lê os dados deles e gera miniaturas para acelerar a navegação no tema.</sys:String>

    <sys:String x:Key="MediaGallery_Provider_Title">Plugin de capturas de tela</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Visualizer">Screenshots Visualizer</sys:String>
    <sys:String x:Key="MediaGallery_Provider_UtilitiesLocal">Screenshot Utilities - Local</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Help">O tema usará a lista de mídia do Aniki Helper em vez de se vincular diretamente ao plugin de screenshots selecionado.</sys:String>

    <sys:String x:Key="MediaGallery_GenerateThumbnails">Miniaturas de mídia</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Button">Gerar miniaturas</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Help">Pré-gera miniaturas para todas as imagens dos plugins de capturas. A primeira geração pode levar algum tempo, mas as próximas execuções devem ser mais rápidas.</sys:String>

    <sys:String x:Key="MediaGallery_Status_WindowTitle">Gerar miniaturas</sys:String>
    <sys:String x:Key="MediaGallery_Status_Scanning">Verificando arquivos de mídia...</sys:String>
