    <!-- ========= STEAM FEATURES ========= -->
    <sys:String x:Key="GroupSteamFeatures">Funcionalidades Steam</sys:String>

    <!-- Steam updates -->
    <sys:String x:Key="SteamUpdates_GroupTitle">Atualizações da Steam</sys:String>
    <sys:String x:Key="SteamUpdates_GroupDesc">Quando ativado, o plugin verifica atualizações dos jogos diretamente na Steam. Isto permite que o tema exiba entradas de atualização novas e antigas.</sys:String>

    <sys:String x:Key="SteamUpdates_Title">Atualizações de jogos</sys:String>
    <sys:String x:Key="SteamUpdates_Desc">Verifica se teus jogos da Steam têm atualizações recentes.</sys:String>
    <sys:String x:Key="SteamUpdates_Enable">Ativar verificação de atualizações</sys:String>
    <sys:String x:Key="SteamUpdates_Enable_Help">Ativa ou desativa completamente a verificação de atualizações.</sys:String>

    <!-- Update data -->
    <sys:String x:Key="SteamInitCache_ProgressTitle">Dados de atualização</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressDesc">O plugin verifica atualizações dos jogos da Steam enquanto navegas pela biblioteca. Podes executar uma verificação completa da biblioteca para preencher previamente os dados de atualização de todos os teus jogos em vez de esperar abrir um por um. Isto ajuda a evitar notificações falsas de atualização e melhora o desempenho durante a navegação.</sys:String>
