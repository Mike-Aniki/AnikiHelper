    <!-- ========= MEDIA GALLERY ========= -->

    <sys:String x:Key="MediaGallery_Title">Galeria de Capturas</sys:String>
    <sys:String x:Key="MediaGallery_Desc">O Aniki Helper lê conteúdos multimédia do Screenshots Visualizer e do Screenshot Utilities. Configura tuas pastas de capturas nesses plugins; o Aniki Helper apenas lê os dados deles e gera miniaturas para acelerar a navegação no tema.</sys:String>

    <sys:String x:Key="MediaGallery_Provider_Title">Plugin de capturas de ecrã</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Visualizer">Screenshots Visualizer</sys:String>
    <sys:String x:Key="MediaGallery_Provider_UtilitiesLocal">Screenshot Utilities - Local</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Help">O tema utilizará a lista multimédia do Aniki Helper em vez de se ligar diretamente ao plugin de capturas de ecrã selecionado.</sys:String>

    <sys:String x:Key="MediaGallery_GenerateThumbnails">Miniaturas multimédia</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Button">Gerar miniaturas</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Help">Pré-gera miniaturas para todas as imagens dos plugins de capturas. A primeira geração pode levar algum tempo, mas as próximas execuções devem ser mais rápidas.</sys:String>

    <sys:String x:Key="MediaGallery_Status_WindowTitle">Gerar miniaturas</sys:String>
    <sys:String x:Key="MediaGallery_Status_Scanning">A verificar ficheiros multimédia...</sys:String>
