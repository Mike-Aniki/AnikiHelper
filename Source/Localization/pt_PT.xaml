    <sys:String x:Key="GroupDynColors">Cores dinâmicas</sys:String>
    <sys:String x:Key="DynColors_Help">Utiliza isto se as cores não combinarem com os fundos atuais dos teus jogos.</sys:String>

    <sys:String x:Key="L_ClearColorCache">Repor cache de cores</sys:String>
    <sys:String x:Key="L_ClearColorCache_Desc">As cores são armazenadas com base no fundo de cada jogo. Se alterares os fundos, as cores guardadas podem ficar desatualizadas.</sys:String>
    <sys:String x:Key="L_ClearColorCache_Tooltip">Limpar todos os dados de cor armazenados e recriá-los a partir dos fundos atuais.</sys:String>
