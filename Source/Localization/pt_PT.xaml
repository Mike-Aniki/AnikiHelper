    <!-- ========= ACHIEVEMENTS CACHE ========= -->
    <sys:String x:Key="AchievementCache_Title">Cache de Memórias de Conquistas</sys:String>
    <sys:String x:Key="AchievementCache_Desc">Reconstrói as memórias de conquistas a partir do PlayniteAchievements. Utiliza isto se ícones, conquistas recentes ou dados de raridade estiverem ausentes ou desatualizados.</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild">Memórias de Conquistas</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Button">Reconstruir cache</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Help">Verifica o PlayniteAchievements e reconstrói as memórias de conquistas apresentadas no tema. Isto pode levar algum tempo em bibliotecas grandes.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Scanning">A verificar conquistas...</sys:String>
    <sys:String x:Key="AchievementCache_Status_Done">Cache de memórias de conquistas reconstruído: {0} itens.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Failed">Falha ao reconstruir o cache de memórias de conquistas.</sys:String>
    <sys:String x:Key="LOCAnikiHelperRefreshAchievementCacheForGame">Atualizar as memórias deste jogo</sys:String>
    <!-- ========= CUSTOM ICONS ========= -->
    <sys:String x:Key="CustomIcons_Title">Funcionalidades personalizados</sys:String>
    <sys:String x:Key="CustomIcons_Desc">Escolhe pastas externas para ícones de filtros, fundos de filtros, ícones de fontes e imagens de banners personalizados. Esses ficheiros substituem os visuais padrão do tema sem modificar os ficheiros do tema.</sys:String>
    <sys:String x:Key="CustomIcons_FilterFolder">Pasta de ícones de filtros</sys:String>
    <sys:String x:Key="CustomIcons_FilterBackgroundFolder">Pasta de fundos de filtros</sys:String>
    <sys:String x:Key="CustomIcons_SourceFolder">Pasta de ícones de fontes</sys:String>
    <sys:String x:Key="CustomIcons_BannerAboveCoverFolder">Pasta de banners acima da capa</sys:String>
    <sys:String x:Key="CustomIcons_BannerOnCoverFolder">Pasta de banners sobre a capa</sys:String>
    <sys:String x:Key="CustomIcons_Help">Os ícones de filtros e fontes devem ser ficheiros PNG com exatamente os nomes apresentados no Playnite. Os fundos de filtros podem usar JPG, JPEG, PNG, WEBP ou BMP com o nome exato da predefinição do filtro, por exemplo Installed.jpg ou Favorites.png. Uma imagem Default é usada quando não há correspondência exata. Utiliza pastas separadas para banners acima da capa e sobre a capa.</sys:String>
    <sys:String x:Key="BrowseFolder">Procurar...</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterFolderDialog">Seleciona a pasta que contém teus ícones PNG de filtros.</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterBackgroundFolderDialog">Seleciona a pasta que contém tuas imagens de fundo dos filtros.</sys:String>
    <sys:String x:Key="CustomIcons_SelectSourceFolderDialog">Seleciona a pasta que contém teus ícones PNG de fontes.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerAboveCoverFolderDialog">Seleciona a pasta que contém tuas imagens PNG de banners acima da capa.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerOnCoverFolderDialog">Seleciona a pasta que contém tuas imagens PNG de banners sobre a capa.</sys:String>

    <!-- ========= TRACK PLAYTIME FEATURES ========= -->
    <sys:String x:Key="GroupMonthly">Histórico mensal</sys:String>
    <sys:String x:Key="ResetSectionTitle">Repor acompanhamento do mês atual</sys:String>
    <sys:String x:Key="BackupSectionTitle">Guardar e restaurar teu histórico</sys:String>

    <sys:String x:Key="MonthlyHelp">Acompanha teu tempo de jogo a cada mês para que o tema possa mostrar estatísticas como tempo jogado neste mês, jogos jogados e teu jogo mais jogado.</sys:String>
    <sys:String x:Key="CurrentMonthData">Mês atual:</sys:String>
    <sys:String x:Key="SnapshotTooltip">Mostra quando o acompanhamento do mês atual começou.</sys:String>

    <sys:String x:Key="ResetWarningText">Aviso: isto exclui os dados de acompanhamento do mês atual.</sys:String>
    <sys:String x:Key="ResetBtn">Repor acompanhamento do mês atual</sys:String>
    <sys:String x:Key="ResetBtnTooltip">Exclui os dados de acompanhamento do mês atual e recomeça a partir de agora.</sys:String>
    <sys:String x:Key="ResetBtntip">Não utiliza isto a menos que realmente queira apagar o acompanhamento deste mês. As estatísticas mensais do mês atual voltarão a zero após a reposição.</sys:String>

    <sys:String x:Key="ExportMonthlyBackupBtn">Exportar Estatísticas Mensais</sys:String>
    <sys:String x:Key="ImportMonthlyBackupBtn">Importar Estatísticas Mensais</sys:String>
    <sys:String x:Key="ExportMonthlyBackupTooltip">Exporta todos os dados de Estatísticas Mensais para um ficheiro de backup JSON.</sys:String>
    <sys:String x:Key="ImportMonthlyBackupTooltip">Restaura os dados de Estatísticas Mensais a partir de um backup JSON exportado anteriormente.</sys:String>
    <sys:String x:Key="MonthlyBackupHelp">Exporte ou restaure as estatísticas mensais de jogo guardadas pelo Aniki Helper. Isto é útil antes de reinstalar o Playnite ou repor tua biblioteca.</sys:String>
    <sys:String x:Key="MonthlyBackup_SectionTitle">Estatísticas mensais</sys:String>
    <sys:String x:Key="MonthlyBackup_ScopeNote">Este backup contém apenas dados de Estatísticas Mensais. Ele não afeta a definição do tema, tua conta Steam, plugins, jogos ou conteúdos multimédia.</sys:String>
    <sys:String x:Key="DangerZone_Title">Zona de perigo</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Help">Exclui permanentemente todos os dados de Estatísticas Mensais guardados pelo Aniki Helper. O acompanhamento do mês atual será reiniciado a partir do momento em que os dados forem excluídos.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Warning">Esta ação não pode ser desfeita, a menos que tenhas exportado um backup anteriormente.</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsBtn">Eliminar todas as Estatísticas Mensais</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsTooltip">Exclui permanentemente todas as estatísticas mensais e reinicia o acompanhamento do mês atual a partir de agora.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Confirm">Tens a certeza de que queres eliminar permanentemente todos os dados de Estatísticas Mensais? O acompanhamento do mês atual será reiniciado a partir de agora. Esta ação não pode ser desfeita, a menos que tenhas exportado um backup.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Success">Todos os dados de Estatísticas Mensais foram excluídos. O acompanhamento recomeça a partir de agora.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Error">Erro ao eliminar dados de Estatísticas Mensais:</sys:String>

    <!-- ========= VIDEO FEATURES ========= -->
    <sys:String x:Key="Video">Vídeo</sys:String>

    <sys:String x:Key="StartupIntro_Title">Sequência de inicialização</sys:String>
    <sys:String x:Key="StartupIntro_Desc">Reproduz a sequência de inicialização quando o Playnite inicia.</sys:String>
    <sys:String x:Key="StartupIntro_Enable">Ativar sequência de inicialização</sys:String>
    <sys:String x:Key="IntroVideo_Help">Desativa isto para iniciar o Playnite sem a sequência de inicialização.</sys:String>

    <sys:String x:Key="ShutdownVideo_Title">Sequência de encerramento</sys:String>
    <sys:String x:Key="ShutdownVideo_Desc">Reproduz a sequência de encerramento quando o Playnite é fechado.</sys:String>
    <sys:String x:Key="ShutdownVideo_Enable">Ativar sequência de encerramento</sys:String>
    <sys:String x:Key="ShutdownVideo_Help">Desativa isto para fechar o Playnite sem a sequência de encerramento.</sys:String>

    <!-- ========= SOUND FEATURES ========= -->
    <sys:String x:Key="EventSounds_Title">Sons de eventos</sys:String>
    <sys:String x:Key="EventSounds_Desc">Reproduz efeitos sonoros para eventos como iniciar um jogo, iniciar/fechar o Playnite e atualizar a biblioteca. Funciona com os sons incluídos no tema.</sys:String>
    <sys:String x:Key="EventSounds_Enable">Ativar sons de eventos</sys:String>
    <sys:String x:Key="EventSounds_Help">Se estiver ativado, desativa os sons de interface/eventos do plugin PlayniteSounds para evitar áudio duplicado.</sys:String>

    <!-- ========= GameOverlay FEATURES ========= -->
    <sys:String x:Key="KeyboardMouse_Tab">Teclado e rato</sys:String>
    <sys:String x:Key="KeyboardMouse_Intro">Utiliza o teclado virtual e controla o rato do Windows diretamente com o teu comando. Estas funcionalidades funcionam de forma independente do overlay no jogo e continuam disponíveis enquanto o Playnite Fullscreen estiver em execução.</sys:String>
    <sys:String x:Key="InGameOverlay_Tab">Overlay em Jogo</sys:String>
    <sys:String x:Key="InGameOverlay_Title">Overlay em Jogo</sys:String>
    <sys:String x:Key="InGameOverlay_Desc">Apresenta um painel de ações rápidas do Aniki sobre o jogo atual.</sys:String>

    <sys:String x:Key="InGameOverlay_Settings_Title">Definições do overlay</sys:String>
    <sys:String x:Key="InGameOverlay_Settings_Desc">Configura o overlay em jogo do Aniki e teu atalho de teclado.</sys:String>

    <sys:String x:Key="InGameOverlay_Enable">Ativar overlay no jogo</sys:String>
    <sys:String x:Key="InGameOverlay_Enable_Help">Ativa o overlay em jogo próprio do Aniki Helper. Desativa isto se preferir usar o overlay do Playnite ou outra solução de overlay.</sys:String>

    <sys:String x:Key="InGameOverlay_Hotkey_Title">Atalho da sobreposição</sys:String>
    <sys:String x:Key="InGameOverlay_Hotkey_Help">Escolhe o atalho de teclado utilizado para abrir o overlay no jogo. Reinicia o Playnite depois de alterares esta definição.</sys:String>

    <sys:String x:Key="InGameOverlay_ControllerShortcut_Title">Atalho do comando</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Help">Escolhe o atalho do comando utilizado para abrir o overlay no jogo. O suporte ao botão Guide é experimental e pode ser capturado pela Steam, pelo Windows ou por ferramentas de comando.</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_StartBack">Start + Back</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_BackY">Back + Y</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Guide">Botão Guide</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Disabled">Desativado</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Title">Teclado virtual</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Desc">Escolhe o teclado virtual utilizado pelo Aniki Helper. Pode ser aberto pelo botão do overlay ou pelo atalho direto do comando enquanto o Playnite Fullscreen estiver em execução.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Title">Provedor de teclado</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Aniki">Teclado Aniki</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Windows">Teclado do Windows</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Help">O teclado do Windows usa o último layout selecionado no Windows. Seleciona o layout Gamepad uma vez nas definições dele. A disponibilidade depende da versão do Windows.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Title">Atalho direto</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_L3R3Hold">Segurar LS + RS (padrão)</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_BackX">Back / Select / View + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_GuideX">Guide + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Disabled">Desativado</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Help">Mantém LS + RS premidos durante 600 ms. Guide + X pode ser intercetado pela Steam, Xbox Game Bar, Windows ou por ferramentas de comando.</sys:String>

    <sys:String x:Key="InGameOverlay_GamepadMouse_Title">Rato pelo comando</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouse_Desc">Utiliza o comando como rato do Windows enquanto o Playnite Fullscreen estiver em execução. O manípulo direito move o ponteiro, o manípulo esquerdo desloca rapidamente, A é o clique esquerdo, X é o clique direito e LT / RT permitem deslocamento preciso.</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Title">Atalho de ativação</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_BackR3">Segurar Back + RS (padrão)</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_StartL3">Segurar Start + LS</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_GuideY">Segurar Guide + Y</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Disabled">Desativado</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Help">Mantém o atalho selecionado premido durante 600 ms para ativar ou desativar o rato pelo comando. Podes manter A premido enquanto moves o manípulo direito para arrastar e largar. Guide + Y pode ser intercetado pela Steam, Xbox Game Bar, Windows ou por ferramentas de comando.</sys:String>
    <sys:String x:Key="LOCGamepadMouseEnabledToast">Rato pelo comando ativado</sys:String>
    <sys:String x:Key="LOCGamepadMouseDisabledToast">Rato pelo comando desativado</sys:String>

    <sys:String x:Key="InGameOverlay_GameBehavior_Title">Comportamento do jogo com o overlay aberto</sys:String>
