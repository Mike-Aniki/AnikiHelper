    <!-- ========= ANIKI SCREENSAVER ========= -->
    <sys:String x:Key="SettingsNav_ScreenSaver">Aniki ScreenSaver</sys:String>
    <sys:String x:Key="SettingsPage_ScreenSaverDesc">Apresenta automaticamente jogos da tua biblioteca após um período de inatividade.</sys:String>
    <sys:String x:Key="ScreenSaver_Enable">Ativar Aniki ScreenSaver</sys:String>
    <sys:String x:Key="ScreenSaver_Enable_Help">O ScreenSaver só inicia no modo Fullscreen enquanto o Playnite estiver em primeiro plano, nenhum jogo estiver em execução e nenhuma janela secundária do Aniki estiver aberta. Qualquer entrada o fecha imediatamente.</sys:String>
    <sys:String x:Key="ScreenSaver_IdleDelay_Title">Iniciar após inatividade</sys:String>
    <sys:String x:Key="ScreenSaver_ChangeInterval_Title">Trocar de jogo a cada</sys:String>
    <sys:String x:Key="ScreenSaver_Source_Title">Fonte dos jogos</sys:String>
    <sys:String x:Key="ScreenSaver_Source_Help">Escolhe qual parte da tua biblioteca do Playnite será usada. Jogos ocultos são sempre excluídos.</sys:String>
    <sys:String x:Key="ScreenSaver_Source_AllGames">Todos os jogos</sys:String>
    <sys:String x:Key="ScreenSaver_Source_InstalledGames">Jogos instalados</sys:String>
    <sys:String x:Key="ScreenSaver_Source_Favorites">Favoritos</sys:String>
    <sys:String x:Key="ScreenSaver_Source_NeverPlayed">Nunca jogados</sys:String>
    <sys:String x:Key="ScreenSaver_Source_RecentlyAdded">Adicionados recentemente</sys:String>
    <sys:String x:Key="ScreenSaver_Source_CurrentFilter">Filtro atual do Playnite</sys:String>
    <sys:String x:Key="ScreenSaver_Source_WeightedRandom">Seleção aleatória ponderada</sys:String>
    <sys:String x:Key="ScreenSaver_UseSplashImages">Usar imagens de Ecrã de Inicialização quando disponíveis</sys:String>
    <sys:String x:Key="ScreenSaver_UseSplashImages_Help">Usa a mesma prioridade de imagens configurada para as Ecrãs de Inicialização dos jogos. Vídeos são ignorados e o fundo do jogo é usado no lugar.</sys:String>
    <sys:String x:Key="ScreenSaver_AmbientMusic">Reproduzir música ambiente durante o ScreenSaver</sys:String>
    <sys:String x:Key="ScreenSaver_AmbientMusic_Help">Pausa a música do tema e o UniPlaySong e, em seguida, reproduz em ciclo a música ambiente do ScreenSaver até este ser fechado. O Radio Mode do UPS permanece ativo.</sys:String>
    <sys:String x:Key="ScreenSaver_ShowLogo">Mostrar logótipo do jogo</sys:String>
