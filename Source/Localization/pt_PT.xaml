    <sys:String x:Key="HubApps_Title">Funcionalidades e apps do Hub</sys:String>
    <sys:String x:Key="HubApps_Desc">Exiba até 4 funcionalidades integradas do Aniki ou Ferramentas de Software do Playnite diretamente no Hub.</sys:String>
