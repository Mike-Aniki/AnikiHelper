    <sys:String x:Key="LOCAnikiHelperOpenGameSplashFolder">Отвори папката със стартови екрани на играта</sys:String>

    <sys:String x:Key="GameLaunchSplash_LogoPosition_Title">Позиция на логото</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_Help">Изберете къде да се показва логото на играта върху splash екрана.</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_LeftTop">Ляво горе</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_LeftCenter">Ляво център</sys:String>
