    <sys:String x:Key="PackCreator_CompleteTitle">Пълен пакет</sys:String>
    <sys:String x:Key="PackCreator_CompleteDesc">Обединете няколко типа пакети и приложете съгласувана визия и звук с една стъпка.</sys:String>
    <sys:String x:Key="PackCreator_CommunityTitle">Споделяне с общността</sys:String>
