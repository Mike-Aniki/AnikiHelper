    <sys:String x:Key="LOCAnikiHelperDisableSplashThisGame">Изключи splash екрана за тази игра</sys:String>
    <sys:String x:Key="LOCAnikiHelperEnableSplashThisGame">Активирай splash екрана за тази игра</sys:String>
