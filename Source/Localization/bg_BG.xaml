    <!-- Steam Store -->
    <sys:String x:Key="SteamStore_GroupTitle">Steam Магазин</sys:String>
    <sys:String x:Key="SteamStore_GroupDesc">Настройте как съдържанието от Steam Store се показва в темата.</sys:String>

    <sys:String x:Key="SteamStore_Language_Title">Език на магазина</sys:String>
    <sys:String x:Key="SteamStore_Language_Desc">Изберете езика, използван за съдържанието от Steam Store.</sys:String>
    <sys:String x:Key="SteamStore_Language_Label">Език</sys:String>

    <sys:String x:Key="SteamStore_Country_Title">Държава на магазина</sys:String>
    <sys:String x:Key="SteamStore_Country_Desc">Изберете държавата, използвана за цени и валута.</sys:String>
    <sys:String x:Key="SteamStore_Country_Label">Държава</sys:String>
    <sys:String x:Key="SteamStore_Country_Help">Влияе върху регионалните цени и показваната валута.</sys:String>

    <sys:String x:Key="SteamStore_Enable_Title">Интеграция със Store</sys:String>
