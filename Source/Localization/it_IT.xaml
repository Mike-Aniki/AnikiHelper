    <!-- Steam updates -->
    <sys:String x:Key="SteamUpdates_GroupTitle">Aggiornamenti Steam</sys:String>
    <sys:String x:Key="SteamUpdates_GroupDesc">Quando è attivo, il plugin controlla gli aggiornamenti dei giochi direttamente da Steam. In questo modo il tema può mostrare sia gli aggiornamenti nuovi sia quelli precedenti.</sys:String>

