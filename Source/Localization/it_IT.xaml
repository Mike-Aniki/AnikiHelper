    <sys:String x:Key="HubFeature_MediaGallery">Galleria delle catture</sys:String>
    <sys:String x:Key="HubFeature_SteamFriends">Amici di Steam</sys:String>
    <sys:String x:Key="HubFeature_SteamStore">Negozio Steam</sys:String>
    <sys:String x:Key="HubFeature_MusicPlayer">Lettore musicale</sys:String>
    <sys:String x:Key="HubFeature_VideoPlayer">Aniki Media Center</sys:String>
    <sys:String x:Key="HubFeature_MusicPlayerRequiresUPS">Per aprire il Lettore musicale è necessario installare UniPlaySong.</sys:String>
    <sys:String x:Key="HubApps_Loading">Caricamento collegamenti selezionati...</sys:String>
    <sys:String x:Key="HubApps_Empty">Scegli funzionalità o app nelle impostazioni di Aniki Helper.</sys:String>
    <sys:String x:Key="LOCHubAppsTitle">Funzioni e app</sys:String>
    <sys:String x:Key="LOCHubAppsSubtitle">Funzioni Aniki integrate e strumenti software selezionati</sys:String>

    <sys:String x:Key="WelcomeHubStartup_Help">Se disattivato, Playnite si aprirà direttamente sulla tua libreria.</sys:String>
    <sys:String x:Key="HubVideoCenterPage_Enable">Mostra la pagina Aniki Media Center nell'Hub</sys:String>
    <sys:String x:Key="HubVideoCenterPage_Help">Mostra fino a quattro schede multimediali memorizzate nella cache da Visti di recente e Aggiunti di recente. La pagina si nasconde automaticamente quando il Media Center non contiene contenuti.</sys:String>

