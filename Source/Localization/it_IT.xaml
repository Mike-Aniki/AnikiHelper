    <!-- Update data -->
    <sys:String x:Key="SteamInitCache_ProgressTitle">Dati aggiornamenti</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressDesc">Il plugin controlla gli aggiornamenti dei giochi Steam mentre navighi nella libreria. Puoi eseguire una scansione completa per preparare in anticipo i dati di aggiornamento di tutti i giochi, invece di aspettare di visitarli uno alla volta. Questo aiuta a evitare false notifiche di aggiornamento e migliora le prestazioni durante la navigazione.</sys:String>
    <sys:String x:Key="SteamInitCache">Scansiona libreria</sys:String>
    <sys:String x:Key="SteamInitCache_Tooltip">Analizza i tuoi giochi Steam e prepara i dati degli aggiornamenti.</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressNote">Si consiglia di scansionare la libreria per evitare false notifiche e migliorare le prestazioni.</sys:String>
