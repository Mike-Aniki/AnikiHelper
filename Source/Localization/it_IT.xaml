    <sys:String x:Key="LOCAnikiHelperRefreshAchievementCacheForGame">Aggiorna i ricordi per questo gioco</sys:String>
    <!-- ========= CUSTOM ICONS ========= -->
    <sys:String x:Key="CustomIcons_Title">Risorse personalizzate</sys:String>
    <sys:String x:Key="CustomIcons_Desc">Scegli cartelle esterne per icone filtro, sfondi filtro, icone sorgente e banner personalizzati. Questi file sostituiscono gli elementi grafici predefiniti del tema senza modificarne i file.</sys:String>
    <sys:String x:Key="CustomIcons_FilterFolder">Cartella icone filtro</sys:String>
    <sys:String x:Key="CustomIcons_FilterBackgroundFolder">Cartella sfondi filtro</sys:String>
    <sys:String x:Key="CustomIcons_SourceFolder">Cartella icone sorgente</sys:String>
    <sys:String x:Key="CustomIcons_BannerAboveCoverFolder">Cartella banner sopra la copertina</sys:String>
    <sys:String x:Key="CustomIcons_BannerOnCoverFolder">Cartella banner sulla copertina</sys:String>
    <sys:String x:Key="CustomIcons_Help">Le icone di filtri e sorgenti devono essere file PNG con gli stessi identici nomi mostrati in Playnite. Gli sfondi dei filtri possono essere JPG, JPEG, PNG, WEBP o BMP e devono usare il nome esatto del preset filtro, ad esempio Installed.jpg o Favorites.png. Se non esiste una corrispondenza esatta viene usata l'immagine Default. Usa cartelle separate per i banner sopra la copertina e quelli sulla copertina.</sys:String>
    <sys:String x:Key="BrowseFolder">Sfoglia...</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterFolderDialog">Seleziona la cartella contenente le icone filtro PNG.</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterBackgroundFolderDialog">Seleziona la cartella contenente le immagini di sfondo dei filtri.</sys:String>
    <sys:String x:Key="CustomIcons_SelectSourceFolderDialog">Seleziona la cartella contenente le icone sorgente PNG.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerAboveCoverFolderDialog">Seleziona la cartella contenente i banner PNG mostrati sopra la copertina.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerOnCoverFolderDialog">Seleziona la cartella contenente i banner PNG mostrati sulla copertina.</sys:String>

    <!-- ========= TRACK PLAYTIME FEATURES ========= -->
    <sys:String x:Key="GroupMonthly">Cronologia mensile</sys:String>
    <sys:String x:Key="ResetSectionTitle">Reimposta monitoraggio mese corrente</sys:String>
    <sys:String x:Key="BackupSectionTitle">Salva e ripristina la cronologia</sys:String>

    <sys:String x:Key="MonthlyHelp">Tiene traccia del tempo di gioco ogni mese, così il tema può mostrare statistiche come il tempo giocato nel mese, i giochi avviati e il gioco più giocato.</sys:String>
    <sys:String x:Key="CurrentMonthData">Mese corrente:</sys:String>
    <sys:String x:Key="SnapshotTooltip">Mostra quando è iniziato il monitoraggio del mese corrente.</sys:String>

    <sys:String x:Key="ResetWarningText">Attenzione: elimina i dati di monitoraggio del mese corrente.</sys:String>
    <sys:String x:Key="ResetBtn">Reimposta mese corrente</sys:String>
    <sys:String x:Key="ResetBtnTooltip">Elimina i dati del mese corrente e ricomincia il monitoraggio da questo momento.</sys:String>
    <sys:String x:Key="ResetBtntip">Usalo solo se vuoi davvero cancellare il monitoraggio di questo mese. Dopo il ripristino, le statistiche del mese corrente ripartiranno da zero.</sys:String>

    <sys:String x:Key="ExportMonthlyBackupBtn">Esporta statistiche mensili</sys:String>
    <sys:String x:Key="ImportMonthlyBackupBtn">Importa statistiche mensili</sys:String>
    <sys:String x:Key="ExportMonthlyBackupTooltip">Esporta tutti i dati delle statistiche mensili in un file di backup JSON.</sys:String>
    <sys:String x:Key="ImportMonthlyBackupTooltip">Ripristina i dati delle statistiche mensili da un backup JSON esportato in precedenza.</sys:String>
    <sys:String x:Key="MonthlyBackupHelp">Esporta o ripristina le statistiche di gioco mensili salvate da Aniki Helper. Utile prima di reinstallare Playnite o reimpostare la libreria.</sys:String>
    <sys:String x:Key="MonthlyBackup_SectionTitle">Statistiche mensili</sys:String>
    <sys:String x:Key="MonthlyBackup_ScopeNote">Questo backup contiene solo i dati delle statistiche mensili. Non modifica la configurazione del tema, l'account Steam, i plugin, i giochi o i contenuti multimediali.</sys:String>
    <sys:String x:Key="DangerZone_Title">Zona pericolosa</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Help">Elimina definitivamente tutti i dati delle statistiche mensili salvati da Aniki Helper. Il monitoraggio del mese corrente ripartirà dal momento dell'eliminazione.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Warning">Questa operazione non può essere annullata, a meno che tu non abbia esportato un backup in precedenza.</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsBtn">Elimina tutte le statistiche mensili</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsTooltip">Elimina definitivamente tutte le statistiche mensili e riavvia da ora il monitoraggio del mese corrente.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Confirm">Vuoi davvero eliminare definitivamente tutti i dati delle statistiche mensili? Il monitoraggio del mese corrente ripartirà da ora. L'operazione non può essere annullata, a meno che tu non abbia esportato un backup.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Success">Tutti i dati delle statistiche mensili sono stati eliminati. Il monitoraggio riparte da ora.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Error">Errore durante l'eliminazione delle statistiche mensili:</sys:String>

    <!-- ========= VIDEO FEATURES ========= -->
    <sys:String x:Key="Video">Video</sys:String>

    <sys:String x:Key="StartupIntro_Title">Sequenza di avvio</sys:String>
    <sys:String x:Key="StartupIntro_Desc">Riproduce la sequenza di avvio quando parte Playnite.</sys:String>
    <sys:String x:Key="StartupIntro_Enable">Attiva video introduttivo all’avvio</sys:String>
    <sys:String x:Key="IntroVideo_Help">Disattiva questa opzione per avviare Playnite senza il video introduttivo.</sys:String>

    <sys:String x:Key="ShutdownVideo_Title">Sequenza di chiusura</sys:String>
    <sys:String x:Key="ShutdownVideo_Desc">Riproduce la sequenza di chiusura quando Playnite viene chiuso.</sys:String>
    <sys:String x:Key="ShutdownVideo_Enable">Attiva video di spegnimento</sys:String>
    <sys:String x:Key="ShutdownVideo_Help">Disattiva questa opzione per chiudere Playnite senza il video di spegnimento.</sys:String>

    <!-- ========= SOUND FEATURES ========= -->
    <sys:String x:Key="EventSounds_Title">Suoni degli eventi</sys:String>
    <sys:String x:Key="EventSounds_Desc">Riproduce effetti sonori per eventi come l'avvio di un gioco, l'apertura/chiusura di Playnite e gli aggiornamenti della libreria. Usa i suoni inclusi nel tema.</sys:String>
    <sys:String x:Key="EventSounds_Enable">Attiva suoni evento</sys:String>
    <sys:String x:Key="EventSounds_Help">Se attivato, disattiva i suoni UI/evento dal plugin PlayniteSounds per evitare audio duplicato.</sys:String>

    <!-- ========= GameOverlay FEATURES ========= -->
    <sys:String x:Key="KeyboardMouse_Tab">Tastiera e mouse</sys:String>
    <sys:String x:Key="KeyboardMouse_Intro">Usa la tastiera virtuale e controlla il mouse di Windows direttamente dal controller. Queste funzioni sono indipendenti dall'overlay in-game e restano disponibili mentre Playnite Fullscreen è in esecuzione.</sys:String>
    <sys:String x:Key="InGameOverlay_Tab">Overlay in gioco</sys:String>
    <sys:String x:Key="InGameOverlay_Title">Overlay in gioco</sys:String>
    <sys:String x:Key="InGameOverlay_Desc">Mostra un pannello di azioni rapide Aniki sopra il gioco corrente.</sys:String>

    <sys:String x:Key="InGameOverlay_Settings_Title">Impostazioni overlay</sys:String>
    <sys:String x:Key="InGameOverlay_Settings_Desc">Configura l'overlay in-game di Aniki e la relativa scorciatoia da tastiera.</sys:String>

    <sys:String x:Key="InGameOverlay_Enable">Attiva overlay in gioco</sys:String>
    <sys:String x:Key="InGameOverlay_Enable_Help">Mostra un overlay di azioni rapide sopra il gioco corrente.</sys:String>

    <sys:String x:Key="InGameOverlay_Hotkey_Title">Scorciatoia overlay</sys:String>
    <sys:String x:Key="InGameOverlay_Hotkey_Help">Scegli la scorciatoia da tastiera usata per aprire l’overlay in gioco. Riavvia Playnite dopo aver modificato questa impostazione.</sys:String>

    <sys:String x:Key="InGameOverlay_ControllerShortcut_Title">Scorciatoia controller</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Help">Scegli la scorciatoia del controller usata per aprire l’overlay in gioco. Il supporto del pulsante Guide è sperimentale e potrebbe essere intercettato da Steam, Windows o strumenti per controller.</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_StartBack">Start + Back</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_BackY">Back + Y</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Guide">Pulsante Guide</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Disabled">Disattivato</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Title">Tastiera virtuale</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Desc">Scegli la tastiera virtuale usata da Aniki Helper. Può essere aperta dal pulsante dell'overlay o con la scorciatoia diretta del controller mentre Playnite Fullscreen è in esecuzione.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Title">Provider tastiera</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Aniki">Tastiera Aniki</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Windows">Tastiera Windows</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Help">La tastiera di Windows usa l'ultimo layout selezionato in Windows. Seleziona una volta il layout Gamepad nelle sue impostazioni. La disponibilità dipende dalla versione di Windows.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Title">Scorciatoia diretta</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_L3R3Hold">Tieni premuti LS + RS (predefinito)</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_BackX">Back / Select / View + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_GuideX">Guide + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Disabled">Disattivata</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Help">Tieni premuti LS + RS per 600 ms. Guide + X può essere intercettato da Steam, Xbox Game Bar, Windows o software per controller.</sys:String>

    <sys:String x:Key="InGameOverlay_GamepadMouse_Title">Mouse con gamepad</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouse_Desc">Usa il controller come mouse di Windows mentre Playnite Fullscreen è in esecuzione. La levetta destra muove il puntatore, la sinistra scorre rapidamente, A è il clic sinistro, X il clic destro e LT / RT permettono uno scorrimento preciso.</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Title">Scorciatoia di attivazione</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_BackR3">Tieni premuti Back + RS (predefinito)</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_StartL3">Tieni premuti Start + LS</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_GuideY">Tieni premuti Guide + Y</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Disabled">Disattivata</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Help">Tieni premuta la scorciatoia selezionata per 600 ms per attivare o disattivare il mouse con gamepad. Puoi tenere premuto A mentre muovi la levetta destra per trascinare e rilasciare. Guide + Y può essere intercettato da Steam, Xbox Game Bar, Windows o software per controller.</sys:String>
