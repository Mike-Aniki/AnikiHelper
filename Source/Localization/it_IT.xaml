    <!-- ========= ACHIEVEMENTS CACHE ========= -->
    <sys:String x:Key="AchievementCache_Title">Cache ricordi degli obiettivi</sys:String>
    <sys:String x:Key="AchievementCache_Desc">Ricrea i ricordi degli obiettivi da PlayniteAchievements. Usalo se mancano o non sono aggiornati icone, obiettivi recenti o dati sulla rarità.</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild">Ricordi degli Obiettivi</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Button">Ricrea cache</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Help">Analizza PlayniteAchievements e ricrea i ricordi degli obiettivi mostrati nel tema. Con librerie grandi potrebbe richiedere un po' di tempo.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Scanning">Scansione obiettivi...</sys:String>
    <sys:String x:Key="AchievementCache_Status_Done">Cache ricordi degli obiettivi ricreata: {0} elementi.</sys:String>
