    <!-- ========= DYNAMIC COLORS FEATURES ========= -->
    <sys:String x:Key="GroupDynColors">Colores dinámicos</sys:String>
    <sys:String x:Key="DynColors_Help">Usa esto si los colores no coinciden con los fondos de tus juegos actuales.</sys:String>

    <sys:String x:Key="L_ClearColorCache">Restablecer caché de colores</sys:String>
    <sys:String x:Key="L_ClearColorCache_Desc">Los colores se guardan según el fondo de cada juego. Si cambias los fondos, los colores almacenados pueden quedar desactualizados.</sys:String>
    <sys:String x:Key="L_ClearColorCache_Tooltip">Borra todos los datos de color almacenados y vuelve a generarlos a partir de los fondos actuales.</sys:String>
    <sys:String x:Key="L_ClearColorCache_Done_Title">Aniki Helper</sys:String>
    <sys:String x:Key="L_ClearColorCache_Done_Body">Caché de colores borrada. Los colores se reconstruirán automáticamente.</sys:String>
    <sys:String x:Key="L_ClearColorCache_Error_Title">Aniki Helper</sys:String>
    <sys:String x:Key="L_ClearColorCache_Error_Body">Error al borrar la caché de colores:</sys:String>

    <sys:String x:Key="L_DynAutoPrecache_Title">Procesamiento de colores de fondo</sys:String>
    <sys:String x:Key="L_EnableDynamicAutoPrecache">Precargar colores en segundo plano</sys:String>
    <sys:String x:Key="L_EnableDynamicAutoPrecache_Note">Mejora la fluidez de navegación. Puede afectar ligeramente al rendimiento en equipos poco potentes.</sys:String>
    <sys:String x:Key="L_EnableDynamicAutoPrecache_Tooltip">Analiza tu biblioteca y prepara los datos de color automáticamente en segundo plano.</sys:String>
    <sys:String x:Key="L_CacheManagement_Title">Gestión de caché</sys:String>
    <sys:String x:Key="L_EnableDynamicAutoPrecache_Desc">Cuando está activado, los colores se generan automáticamente para tu biblioteca en lugar de crearse durante la navegación.</sys:String>

    <sys:String x:Key="ConfirmClearCache">¿Restablecer la caché de colores? Los colores se regenerarán automáticamente.</sys:String>
    <sys:String x:Key="CacheClearedMsg">Caché de colores borrada.</sys:String>

    <!-- ========= STEAM FEATURES ========= -->
    <sys:String x:Key="GroupSteamFeatures">Funciones de Steam</sys:String>

    <!-- Steam updates -->
    <sys:String x:Key="SteamUpdates_GroupTitle">Actualizaciones de Steam</sys:String>
    <sys:String x:Key="SteamUpdates_GroupDesc">Cuando está activado, el plugin comprueba las actualizaciones de los juegos directamente desde Steam. Esto permite que el tema muestre tanto entradas de actualización nuevas como antiguas.</sys:String>

    <sys:String x:Key="SteamUpdates_Title">Actualizaciones de juegos</sys:String>
    <sys:String x:Key="SteamUpdates_Desc">Comprueba si tus juegos de Steam tienen actualizaciones recientes.</sys:String>
    <sys:String x:Key="SteamUpdates_Enable">Activar comprobación de actualizaciones</sys:String>
    <sys:String x:Key="SteamUpdates_Enable_Help">Activa o desactiva por completo la comprobación de actualizaciones.</sys:String>

    <!-- Update data -->
    <sys:String x:Key="SteamInitCache_ProgressTitle">Datos de actualizaciones</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressDesc">El plugin comprueba las actualizaciones de los juegos de Steam mientras navegas por tu biblioteca. Puedes ejecutar un análisis completo de la biblioteca para rellenar previamente los datos de actualización de todos tus juegos en lugar de esperar a navegar por ellos uno por uno. Esto ayuda a evitar notificaciones falsas de actualización y mejora el rendimiento durante la navegación.</sys:String>
    <sys:String x:Key="SteamInitCache">Analizar biblioteca</sys:String>
    <sys:String x:Key="SteamInitCache_Tooltip">Analiza tus juegos de Steam y prepara los datos de actualización.</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressNote">Se recomienda analizar la biblioteca para evitar notificaciones falsas y mejorar el rendimiento.</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressText">Analizando… {0}/{1}</sys:String>
    <sys:String x:Key="LOCSteamLastScan">Último análisis:</sys:String>
    <sys:String x:Key="ConfirmInitSteamCache">¿Analizar tu biblioteca ahora?</sys:String>
    <sys:String x:Key="InitSteamCacheDoneMsg">Análisis completado.</sys:String>

    <!-- Current players -->
    <sys:String x:Key="SteamPlayers_GroupTitle">Jugadores actuales</sys:String>
    <sys:String x:Key="SteamPlayers_GroupDesc">Muestra el número de jugadores en tiempo real para los juegos de Steam compatibles.</sys:String>

    <sys:String x:Key="SteamPlayers_Title">Jugadores actuales</sys:String>
    <sys:String x:Key="SteamPlayers_Desc">Muestra cuántas personas están jugando actualmente a un juego.</sys:String>
    <sys:String x:Key="SteamPlayers_Enable">Activar contador de jugadores</sys:String>
    <sys:String x:Key="SteamPlayers_Help">Activa o desactiva la visualización del número de jugadores en el tema.</sys:String>

    <!-- Steam Store -->
    <sys:String x:Key="SteamStore_GroupTitle">Steam Store</sys:String>
    <sys:String x:Key="SteamStore_GroupDesc">Configura cómo se muestra el contenido de Steam Store en el tema.</sys:String>

    <sys:String x:Key="SteamStore_Language_Title">Idioma de la tienda</sys:String>
    <sys:String x:Key="SteamStore_Language_Desc">Elige el idioma usado para el contenido de Steam Store.</sys:String>
    <sys:String x:Key="SteamStore_Language_Label">Idioma</sys:String>

    <sys:String x:Key="SteamStore_Country_Title">País de la tienda</sys:String>
    <sys:String x:Key="SteamStore_Country_Desc">Elige el país usado para los precios y la moneda.</sys:String>
    <sys:String x:Key="SteamStore_Country_Label">País</sys:String>
    <sys:String x:Key="SteamStore_Country_Help">Esto afecta a los precios regionales y a la moneda mostrada.</sys:String>

    <sys:String x:Key="SteamStore_Enable_Title">Integración de Steam Store</sys:String>
    <sys:String x:Key="SteamStore_Enable">Activar Steam Store</sys:String>
    <sys:String x:Key="SteamStore_Enable_Desc">Activa las secciones de Steam Store dentro del tema.</sys:String>
    <sys:String x:Key="SteamStore_Enable_Help">Si está desactivado, el botón Store dejará de mostrarse en el tema.</sys:String>


    <!-- Conexión Steam -->
    <sys:String x:Key="SteamAccount_GroupTitle">Conexión de cuenta Steam</sys:String>
    <sys:String x:Key="SteamAccount_GroupDesc">Conecta Steam una sola vez para usar Steam Friends, Mi lista de deseados, For You y las recomendaciones personalizadas.</sys:String>
    <sys:String x:Key="SteamAccount_ConnectButton">Conectar a Steam</sys:String>
    <sys:String x:Key="SteamAccount_ReconnectButton">Volver a conectar a Steam</sys:String>
    <sys:String x:Key="SteamAccount_CheckButton">Comprobar conexión</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectButton">Desconectar</sys:String>
    <sys:String x:Key="SteamAccount_StatusLabel">Estado de conexión</sys:String>
    <sys:String x:Key="SteamAccount_SteamIdLabel">Cuenta de Steam:</sys:String>
    <sys:String x:Key="SteamAccount_ConfiguredBadge">CONFIGURADA</sys:String>
    <sys:String x:Key="SteamAccount_MissingBadge">FALTA</sys:String>
    <sys:String x:Key="SteamAccount_OptionalBadge">OPCIONAL</sys:String>
    <sys:String x:Key="SteamAccount_ConnectedTitle">Conectado a Steam</sys:String>
    <sys:String x:Key="SteamAccount_ConnectedDesc">Tu sesión de Steam está activa. Steam Friends, Mi lista de deseados y For You están listos para usar.</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectedTitle">No conectado a Steam</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectedDesc">Conecta tu cuenta de Steam. La página oficial de inicio de sesión se abre y se cierra automáticamente después de conectarte.</sys:String>
    <sys:String x:Key="SteamAccount_ProfileLabel">Perfil Steam / SteamID detectado</sys:String>
    <sys:String x:Key="SteamAccount_ApiKeyTitle">Clave Steam Web API</sys:String>
    <sys:String x:Key="SteamAccount_ApiKeyDesc">Es necesaria para Steam Friends y se utiliza para mejorar las recomendaciones de la tienda mediante tus juegos adquiridos y jugados recientemente. La tienda puede funcionar sin ella, pero los datos de amigos y algunas funciones de personalización no estarán disponibles.</sys:String>
    <sys:String x:Key="SteamAccount_ManualSteamIdTitle">SteamID de respaldo avanzado</sys:String>
    <sys:String x:Key="SteamAccount_ManualSteamIdDesc">Opcional. Úsalo solo si falla la detección automática del SteamID.</sys:String>
    <sys:String x:Key="SteamAccount_PrivacyNotice">No se necesita una clave Steam Web API y tu lista de amigos de Steam no tiene que ser pública.</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoTitle">Una sola conexión de Steam para todo</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoDesc">La misma conexión activa Steam Friends, Mi lista de deseados, For You y tus recomendaciones personalizadas. Si la sesión caduca, solo tienes que volver a conectarte.</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoPrivacy">No se necesita una clave API. Tu lista de amigos de Steam puede seguir siendo privada.</sys:String>
    <sys:String x:Key="SteamAccount_TokenMissingTitle">Los servicios de Steam no están listos</sys:String>
    <sys:String x:Key="SteamAccount_TokenMissingDesc">Tu cuenta de Steam está conectada, pero la sesión debe actualizarse. Usa Comprobar conexión o desconecta y vuelve a conectar.</sys:String>
    <sys:String x:Key="SteamFullscreen_DisconnectedSummary">El inicio de sesión de Steam está disponible en los ajustes de Aniki Helper del modo Escritorio de Playnite.</sys:String>
    <sys:String x:Key="SteamFullscreen_PrivacyHelp">Conéctate desde el modo Escritorio, vuelve a Pantalla completa y selecciona Comprobar conexión.</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesLabel">Servicios de Steam</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesReady">Listos</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesMissing">Hay que actualizar</sys:String>
    <sys:String x:Key="SteamFullscreen_ConnectedSummary">Usa Comprobar conexión si el estado mostrado no está actualizado o si una función de Steam deja de responder.</sys:String>


    <!-- Steam Friends -->
    <sys:String x:Key="LOCSteamFriends_Title">Steam Friends</sys:String>
    <sys:String x:Key="LOCSteamFriends_Subtitle">Muestra el estado de tus amigos de Steam dentro del tema Aniki: amigos en línea, juegos actuales, perfiles y notificaciones del tema.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Enable">Activar integración Steam Friends</sys:String>
    <sys:String x:Key="LOCSteamFriends_EnableHelp">Activa o desactiva los datos de Steam Friends usados por el tema.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Display">Visualización</sys:String>
    <sys:String x:Key="LOCSteamFriends_OnlineInfo">El tema puede mostrar hasta 15 amigos en línea a la vez. Los amigos se priorizan por estado: jugando primero, luego en línea, ausente y ocupado.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ShowOffline">Mostrar amigos sin conexión</sys:String>
    <sys:String x:Key="LOCSteamFriends_OfflineInfo">Los amigos sin conexión son opcionales y están limitados a 40 a la vez para mantener una navegación fluida.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Notifications">Notificaciones</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStart">Notificar cuando un amigo inicia un juego</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStartHelp">Muestra una notificación dentro del tema cuando un amigo de Steam empieza a jugar.</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnect">Notificar cuando un amigo se conecta</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnectHelp">Muestra una notificación dentro del tema cuando un amigo de Steam se conecta.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedDetails_Title">Detalles del juego</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Section">Juegos jugados por amigos</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Refresh">Actualizar juegos jugados por amigos</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Help">Crea una caché local de Steam para mostrar, en la vista de detalles, los amigos que ya han jugado al juego seleccionado. El análisis puede tardar según el número de amigos.</sys:String>
