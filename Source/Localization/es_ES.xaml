    <sys:String x:Key="GameLaunchSplash_VideoSound_Enable">Activar sonido en vídeos de carga</sys:String>
    <sys:String x:Key="GameLaunchSplash_VideoSound_Help">Controla el volumen de audio solo para pantallas de carga en vídeo. Las pantallas de carga con imagen no se ven afectadas.</sys:String>
