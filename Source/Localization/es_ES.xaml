    <!-- ========= ACHIEVEMENTS CACHE ========= -->
    <sys:String x:Key="AchievementCache_Title">Caché de recuerdos de logros</sys:String>
    <sys:String x:Key="AchievementCache_Desc">Reconstruye los recuerdos de logros a partir de PlayniteAchievements. Úsalo si faltan iconos, logros recientes o datos de rareza, o si están desactualizados.</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild">Recuerdos de logros</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Button">Reconstruir caché</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Help">Analiza PlayniteAchievements y reconstruye los recuerdos de logros mostrados en el tema. Esto puede tardar en bibliotecas grandes.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Scanning">Analizando logros...</sys:String>
    <sys:String x:Key="AchievementCache_Status_Done">Caché de recuerdos de logros reconstruida: {0} elementos.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Failed">Error al reconstruir la caché de recuerdos de logros.</sys:String>
    <sys:String x:Key="LOCAnikiHelperRefreshAchievementCacheForGame">Actualizar recuerdos de este juego</sys:String>

    
    <!-- ========= CUSTOM ICONS ========= -->
    <sys:String x:Key="CustomIcons_Title">Iconos personalizados</sys:String>
    <sys:String x:Key="CustomIcons_Desc">Elige carpetas externas para iconos de filtros, iconos de fuentes e imágenes de banners. Estos archivos sustituyen los visuales predeterminados del tema sin modificar sus archivos.</sys:String>
    <sys:String x:Key="CustomIcons_FilterFolder">Carpeta de iconos de filtros</sys:String>
    <sys:String x:Key="CustomIcons_SourceFolder">Carpeta de iconos de fuentes</sys:String>
    <sys:String x:Key="CustomIcons_BannerAboveCoverFolder">Carpeta de banners sobre las carátulas</sys:String>
    <sys:String x:Key="CustomIcons_BannerOnCoverFolder">Carpeta de banners en las carátulas</sys:String>
    <sys:String x:Key="CustomIcons_Help">Los archivos PNG deben usar exactamente los mismos nombres que los filtros, fuentes o plataformas mostrados en Playnite. Ejemplos: Installed.png, Favorites.png, Steam.png. Usa carpetas separadas para los banners sobre las carátulas y los banners en las carátulas.</sys:String>
    <sys:String x:Key="BrowseFolder">Examinar...</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterFolderDialog">Selecciona la carpeta que contiene tus iconos PNG de filtros.</sys:String>
    <sys:String x:Key="CustomIcons_SelectSourceFolderDialog">Selecciona la carpeta que contiene tus iconos PNG de fuentes.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerAboveCoverFolderDialog">Selecciona la carpeta que contiene tus banners PNG sobre las carátulas.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerOnCoverFolderDialog">Selecciona la carpeta que contiene tus banners PNG en las carátulas.</sys:String>

    <!-- ========= GameOverlay ========= -->
    <sys:String x:Key="KeyboardMouse_Tab">Teclado y ratón</sys:String>
    <sys:String x:Key="KeyboardMouse_Intro">Usa el teclado virtual y controla el ratón de Windows directamente con el mando. Estas funciones son independientes del overlay en juego y permanecen disponibles mientras Playnite Fullscreen está abierto.</sys:String>
    <sys:String x:Key="InGameOverlay_Tab">Overlay en juego</sys:String>
    <sys:String x:Key="InGameOverlay_Title">Overlay en juego</sys:String>
    <sys:String x:Key="InGameOverlay_Desc">Muestra un panel de acciones rápidas de Aniki encima del juego actual.</sys:String>
    
    <sys:String x:Key="InGameOverlay_Settings_Title">Ajustes del overlay</sys:String>
    <sys:String x:Key="InGameOverlay_Settings_Desc">Configura el overlay en juego de Aniki y su atajo de teclado.</sys:String>

    <sys:String x:Key="InGameOverlay_Enable">Activar overlay en juego</sys:String>
    <sys:String x:Key="InGameOverlay_Enable_Help">Activa el overlay en juego propio de Aniki Helper. Desactiva esta opción si prefieres usar el overlay de Playnite u otra solución de overlay.</sys:String>
    
    <sys:String x:Key="InGameOverlay_Hotkey_Title">Atajo del overlay</sys:String>
    <sys:String x:Key="InGameOverlay_Hotkey_Help">Elige el atajo de teclado utilizado para abrir el overlay en juego. Reinicia Playnite después de cambiar este ajuste.</sys:String>

    <sys:String x:Key="InGameOverlay_ControllerShortcut_Title">Atajo del mando</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Help">Elige el atajo del mando utilizado para abrir el overlay en juego. El botón Guide es experimental y puede ser capturado por Steam, Windows o herramientas de mando.</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_StartBack">Start + Back</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_BackY">Back + Y</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Guide">Botón Guide</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Disabled">Desactivado</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Title">Teclado virtual</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Desc">Elige el teclado virtual utilizado por Aniki Helper. Puede abrirse desde el botón del overlay o con su acceso directo del mando mientras Playnite Fullscreen está abierto.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Title">Teclado utilizado</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Aniki">Teclado Aniki</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Windows">Teclado de Windows</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Help">El teclado de Windows usa la última distribución seleccionada en Windows. Selecciona una vez la distribución Gamepad en sus ajustes. Su disponibilidad depende de la versión de Windows.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Title">Acceso directo</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_L3R3Hold">Mantener LS + RS (predeterminado)</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_BackX">Back / Select / View + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_GuideX">Guide + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Disabled">Desactivado</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Help">Mantén LS + RS durante 600 ms. Guide + X puede ser interceptado por Steam, Xbox Game Bar, Windows o herramientas del mando.</sys:String>

    <sys:String x:Key="InGameOverlay_GamepadMouse_Title">Ratón con mando</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouse_Desc">Usa el mando como ratón de Windows mientras Playnite Fullscreen está abierto. El stick derecho mueve el cursor, el stick izquierdo desplaza rápidamente, A hace clic izquierdo, X clic derecho y LT / RT permiten un desplazamiento preciso.</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Title">Atajo de activación</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_BackR3">Mantener Back + RS (predeterminado)</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_StartL3">Mantener Start + LS</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_GuideY">Mantener Guide + Y</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Disabled">Desactivado</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Help">Mantén el atajo elegido durante 600 ms para activar o desactivar el ratón. Puedes mantener A mientras mueves el stick derecho para arrastrar y soltar. Guide + Y puede ser interceptado por Steam, Xbox Game Bar, Windows o herramientas del mando.</sys:String>
    <sys:String x:Key="LOCGamepadMouseEnabledToast">Ratón con mando activado</sys:String>
    <sys:String x:Key="LOCGamepadMouseDisabledToast">Ratón con mando desactivado</sys:String>

    <sys:String x:Key="InGameOverlay_GameBehavior_Title">Comportamiento del juego mientras el overlay está abierto</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_DoNothing">Predeterminado: no hacer nada</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_SuspendGame">Suspender el juego mientras el overlay está abierto</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_Help">Elige si Aniki Helper debe dejar el juego funcionando normalmente o congelar temporalmente el proceso del juego mientras el overlay está abierto para evitar entradas duplicadas.</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_Warning">Advertencia: no recomendado para juegos online, multijugador, con anti-cheat o iniciados como administrador.</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Title">Juegos que nunca se suspenden</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Help">Los juegos añadidos desde clic derecho → Aniki Helper → Overlay Settings → Never suspend this game aparecen aquí. Desmarca un juego para quitarlo de la lista.</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Clear">Vaciar la lista</sys:String>
    <sys:String x:Key="LOCAnikiHelperOverlayNeverSuspendThisGame">Never suspend this game</sys:String>
    <sys:String x:Key="LOCAnikiHelperOverlayAllowSuspendThisGame">Allow suspend for this game</sys:String>
    
    <sys:String x:Key="InGameOverlay_Limitations_Title">Limitaciones</sys:String>
    <sys:String x:Key="InGameOverlay_Limitations_Desc">Este overlay es una ventana transparente mostrada encima del juego. No se inyecta directamente en el juego como los overlays de Steam o Discord.</sys:String>
    <sys:String x:Key="InGameOverlay_Limitations_Help">Funciona mejor con juegos en modo ventana sin bordes o pantalla completa en ventana. Algunos juegos en pantalla completa exclusiva, anti-cheats o juegos ejecutados como administrador pueden impedir que el overlay se muestre correctamente.</sys:String>

    <sys:String x:Key="LOCInGameOverlayCancel">Cancelar</sys:String>
    <sys:String x:Key="LOCInGameOverlayConfirmQuit">Salir del juego</sys:String>

    <sys:String x:Key="LOCInGameOverlayFooterTitle">Aniki Control Center</sys:String>
    <sys:String x:Key="LOCInGameOverlayControlCenter">CONTROL CENTER</sys:String>
    <sys:String x:Key="LOCInGameOverlayBackHint">B / Atrás para cerrar</sys:String>
    <sys:String x:Key="LOCInGameOverlayReturnToPlaynite">Volver a Playnite</sys:String>
    <sys:String x:Key="LOCInGameOverlayReturnToGame">Volver al juego</sys:String>
    <sys:String x:Key="LOCInGameOverlayQuitGame">Cerrar juego</sys:String>
    <sys:String x:Key="LOCInGameOverlayGame">Juego</sys:String>
    <sys:String x:Key="LOCInGameOverlayLastCaptures">Últimas capturas</sys:String>
    <sys:String x:Key="LOCInGameOverlayMedia">Media</sys:String>
    <sys:String x:Key="LOCInGameOverlayAchievements">Trofeos</sys:String>
    <sys:String x:Key="LOCInGameOverlayGameInfo">Info del juego</sys:String>
    <sys:String x:Key="LOCInGameOverlaySource">Fuente</sys:String>
    <sys:String x:Key="LOCInGameOverlayPlatform">Plataforma</sys:String>
    <sys:String x:Key="LOCInGameOverlayPlaytime">Tiempo de juego</sys:String>
    <sys:String x:Key="LOCInGameOverlaySession">Sesión</sys:String>
    <sys:String x:Key="LOCInGameOverlayMediaAvailable">Capturas</sys:String>
    <sys:String x:Key="LOCInGameOverlayMediaLatest">Última captura</sys:String>
    <sys:String x:Key="LOCInGameOverlayAchievementsUnlocked">Desbloqueados</sys:String>
    <sys:String x:Key="LOCInGameOverlayAchievementsProgress">Progreso</sys:String>
    <sys:String x:Key="LOCInGameOverlayAchievementsLatest">Último trofeo</sys:String>
    <sys:String x:Key="LOCInGameOverlayComingSoon">Próximamente</sys:String>
    <sys:String x:Key="LOCInGameOverlayMediaCenterHint">Vista rápida de las capturas vinculadas al juego actual.</sys:String>
    <sys:String x:Key="LOCInGameOverlayMediaFutureHint">Este panel podrá alojar controles UPS / Spotify más adelante sin tocar la lógica de la ventana overlay.</sys:String>
    
    <!-- ========= TRACK PLAYTIME FEATURES ========= -->
    <sys:String x:Key="GroupMonthly">Historial mensual</sys:String>
    <sys:String x:Key="ResetSectionTitle">Restablecer el seguimiento del mes actual</sys:String>
    <sys:String x:Key="BackupSectionTitle">Guardar y restaurar tu historial</sys:String>

    <sys:String x:Key="MonthlyHelp">Registra tu tiempo de juego cada mes para que el tema pueda mostrar estadísticas como el tiempo jugado este mes, los juegos jugados y tu juego más jugado.</sys:String>
    <sys:String x:Key="CurrentMonthData">Mes actual:</sys:String>
    <sys:String x:Key="SnapshotTooltip">Muestra cuándo comenzó el seguimiento del mes actual.</sys:String>

    <sys:String x:Key="ResetWarningText">Advertencia: esto elimina los datos de seguimiento del mes actual.</sys:String>
    <sys:String x:Key="ResetBtn">Restablecer seguimiento del mes actual</sys:String>
    <sys:String x:Key="ResetBtnTooltip">Elimina los datos de seguimiento del mes actual y vuelve a empezar desde ahora.</sys:String>
    <sys:String x:Key="ResetBtntip">No uses esto a menos que realmente quieras borrar el seguimiento de este mes. Las estadísticas mensuales del mes actual se reiniciarán desde cero después del restablecimiento.</sys:String>

    <sys:String x:Key="ExportMonthlyBackupBtn">Exportar estadísticas mensuales</sys:String>
    <sys:String x:Key="ImportMonthlyBackupBtn">Importar estadísticas mensuales</sys:String>
    <sys:String x:Key="ExportMonthlyBackupTooltip">Exporta todos los datos de estadísticas mensuales a un archivo JSON.</sys:String>
    <sys:String x:Key="ImportMonthlyBackupTooltip">Restaura las estadísticas mensuales desde una copia JSON exportada anteriormente.</sys:String>
    <sys:String x:Key="MonthlyBackupHelp">Exporta o restaura las estadísticas mensuales de tiempo de juego guardadas por Aniki Helper. Es útil antes de reinstalar Playnite o restablecer tu biblioteca.</sys:String>

    <sys:String x:Key="MonthlyBackup_SectionTitle">Estadísticas mensuales</sys:String>
    <sys:String x:Key="MonthlyBackup_ScopeNote">Esta copia solo contiene los datos de estadísticas mensuales. No afecta a la configuración del tema, la cuenta de Steam, los plugins, los juegos ni los archivos multimedia.</sys:String>
    <sys:String x:Key="DangerZone_Title">Zona de peligro</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Help">Elimina permanentemente todas las estadísticas mensuales guardadas por Aniki Helper. El seguimiento del mes actual volverá a comenzar en el momento de la eliminación.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Warning">Esta acción no se puede deshacer, salvo que hayas exportado previamente una copia de seguridad.</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsBtn">Eliminar todas las estadísticas mensuales</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsTooltip">Elimina permanentemente todas las estadísticas mensuales y reinicia desde ahora el seguimiento del mes actual.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Confirm">¿Seguro que quieres eliminar permanentemente todas las estadísticas mensuales? El seguimiento del mes actual volverá a comenzar desde ahora. Esta acción no se puede deshacer, salvo que hayas exportado una copia de seguridad.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Success">Se han eliminado todas las estadísticas mensuales. El seguimiento vuelve a comenzar desde ahora.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Error">Error al eliminar las estadísticas mensuales:</sys:String>
    <!-- ========= VIDEO FEATURES ========= -->
    <sys:String x:Key="Video">Vídeo</sys:String>

    <sys:String x:Key="StartupIntro_Title">Vídeo de introducción al iniciar</sys:String>
    <sys:String x:Key="StartupIntro_Desc">Reproduce un vídeo de introducción al iniciar Playnite.</sys:String>
    <sys:String x:Key="StartupIntro_Enable">Activar vídeo de introducción al iniciar</sys:String>
    <sys:String x:Key="IntroVideo_Help">Desactiva esto para iniciar Playnite sin el vídeo de introducción.</sys:String>

    <sys:String x:Key="ShutdownVideo_Title">Vídeo de cierre</sys:String>
    <sys:String x:Key="ShutdownVideo_Desc">Reproduce un vídeo de cierre al cerrar Playnite.</sys:String>
    <sys:String x:Key="ShutdownVideo_Enable">Activar vídeo de cierre</sys:String>
    <sys:String x:Key="ShutdownVideo_Help">Desactiva esto para cerrar Playnite sin el vídeo de cierre.</sys:String>

    <!-- ========= SOUND FEATURES ========= -->
    <sys:String x:Key="EventSounds_Title">Sonidos de eventos</sys:String>
    <sys:String x:Key="EventSounds_Desc">Reproduce efectos de sonido para eventos como el inicio de juegos, el arranque/salida de Playnite y las actualizaciones de la biblioteca. Funciona con los sonidos incluidos en el tema.</sys:String>
