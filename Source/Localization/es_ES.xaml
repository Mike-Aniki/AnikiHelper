    <sys:String x:Key="HubApps_Title">Funciones y aplicaciones del Hub</sys:String>
    <sys:String x:Key="HubApps_Desc">Muestra hasta 4 funciones integradas de Aniki o herramientas de software de Playnite directamente en el Hub.</sys:String>
    <sys:String x:Key="HubApps_Enable">Mostrar la página Funciones y aplicaciones en el Hub</sys:String>
