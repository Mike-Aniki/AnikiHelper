    <sys:String x:Key="GameLaunchSplash_LogoPosition_Title">Position du logo</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_Help">Choisissez où le logo du jeu apparaît sur l’écran de splash.</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_LeftTop">Gauche haut</sys:String>
