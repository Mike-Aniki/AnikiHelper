    <sys:String x:Key="WelcomeHubStartup_Desc">Choisissez l’écran affiché au lancement de Playnite entre la bibliothèque et le Hub.</sys:String>
    <sys:String x:Key="WelcomeHubStartup_Enable">Ouvrir le Hub au démarrage</sys:String>

    <sys:String x:Key="HubApps_Title">Fonctionnalités et applications du Hub</sys:String>
    <sys:String x:Key="HubApps_Desc">Affiche jusqu’à 4 fonctionnalités Aniki intégrées ou outils logiciels Playnite directement dans le Hub.</sys:String>
    <sys:String x:Key="HubApps_Enable">Afficher la page Fonctionnalités et applications dans le Hub</sys:String>
