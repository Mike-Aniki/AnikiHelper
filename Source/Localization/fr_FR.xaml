<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="AppTitle">Aniki Helper</sys:String>
    <sys:String x:Key="AppSubtitle">Paramètres</sys:String>
    <sys:String x:Key="AppInfo">Aniki Helper fournit des services Steam, des intégrations de plugins externes et des fonctionnalités exclusives Aniki aux thèmes compatibles.</sys:String>
    
    <sys:String x:Key="MoreOptionsDesktop">Plus d’options sont disponibles dans les paramètres du plugin en mode bureau.</sys:String>
    <sys:String x:Key="GroupAdditionalFeatures">Fonctionnalités supplémentaires</sys:String>

    <sys:String x:Key="GroupGeneral">Général</sys:String>
    <sys:String x:Key="GroupNews">Actualités</sys:String>
    <sys:String x:Key="GroupDynamicColors">Couleurs dynamiques</sys:String>
    <sys:String x:Key="GameLaunchSplash_VideoVolume_Title">Volume de la vidéo</sys:String>

    <sys:String x:Key="LOCDebugLogsTitle">Débogage</sys:String>
    <sys:String x:Key="LOCDebugLogsDescription">Activez cette option uniquement pour diagnostiquer un problème et si vous devez envoyer un rapport debug. Elle écrit des informations détaillées d’Aniki Helper dans extensions.log et peut générer beaucoup de lignes.</sys:String>
    <sys:String x:Key="LOCEnableDebugLogs">Activer les journaux de débogage</sys:String>
    <sys:String x:Key="LOCDebugLogsInfo">Pour un rapport debug propre : videz le fichier log, activez le mode debug, reproduisez le bug, puis envoyez le fichier extensions.log.</sys:String>
    <sys:String x:Key="LOCClearLogFile">Vider le fichier log</sys:String>
    <sys:String x:Key="LOCOpenLogsFolder">Ouvrir le dossier des logs</sys:String>

    <!-- ========= HUB FEATURES ========= -->
    <sys:String x:Key="WelcomeHubStartup_Title">Écran d’accueil</sys:String>
    <sys:String x:Key="WelcomeHubStartup_Desc">Choisissez l’écran affiché au lancement de Playnite entre la bibliothèque et le Hub.</sys:String>
    <sys:String x:Key="WelcomeHubStartup_Enable">Ouvrir le Hub au démarrage</sys:String>

    <sys:String x:Key="HubApps_Title">Applications du Hub</sys:String>
    <sys:String x:Key="HubApps_Desc">Affiche jusqu’à 4 outils logiciels Playnite sélectionnés directement dans le Hub.</sys:String>
    <sys:String x:Key="HubApps_Enable">Afficher la page Apps dans le Hub</sys:String>
    <sys:String x:Key="HubApps_Slot1">Slot 1</sys:String>
    <sys:String x:Key="HubApps_Slot2">Slot 2</sys:String>
    <sys:String x:Key="HubApps_Slot3">Slot 3</sys:String>
    <sys:String x:Key="HubApps_Slot4">Slot 4</sys:String>
    <sys:String x:Key="HubApps_Help">Choisissez jusqu’à 4 apps depuis les outils logiciels de Playnite à afficher dans le Hub. Les apps doivent d’abord être ajoutées dans Playnite / Outils logiciels. Vous pouvez définir une image de fond personnalisée pour chaque app ; sinon, une image par défaut sera utilisée.</sys:String>
    <sys:String x:Key="HubApps_SelectBackgroundDialog">Sélectionne une image de fond pour cette carte d’application du Hub.</sys:String>
    <sys:String x:Key="BrowseImage">Image...</sys:String>
    <sys:String x:Key="LOCHubAppsTitle">Apps</sys:String>
    <sys:String x:Key="LOCHubAppsSubtitle">Tes Software Tools sélectionnés</sys:String>

    <sys:String x:Key="WelcomeHubStartup_Help">Si désactivé, Playnite s’ouvrira directement sur la bibliothèque.</sys:String>

    <!-- ========= LIBRARY STAT FEATURES ========= -->
    <sys:String x:Key="GroupLibraryStats">Statistiques de la bibliothèque</sys:String>
    <sys:String x:Key="StatsHelp">Choisissez quels jeux sont inclus dans les statistiques affichées par le thème.</sys:String>
    <sys:String x:Key="IncludeHidden">Inclure les jeux masqués</sys:String>
    <sys:String x:Key="AutoUpdate">Les statistiques se mettent à jour automatiquement lorsque votre bibliothèque change.</sys:String>
    <sys:String x:Key="PreviewTotal">Aperçu — Total :</sys:String>
    <sys:String x:Key="Installed">Installés :</sys:String>
    <sys:String x:Key="NotInstalled">Non installés :</sys:String>

    <!-- ========= MEDIA GALLERY ========= -->

    <sys:String x:Key="MediaGallery_Title">Galerie média</sys:String>
    <sys:String x:Key="MediaGallery_Desc">Aniki Helper lit les médias depuis Screenshots Visualizer et Screenshot Utilities. Configurez vos dossiers de captures dans ces plugins ; Aniki Helper lit uniquement leurs données et génère des miniatures pour accélérer la navigation dans le thème.</sys:String>

    <sys:String x:Key="MediaGallery_Provider_Title">Plugin de captures</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Visualizer">Screenshots Visualizer</sys:String>
    <sys:String x:Key="MediaGallery_Provider_UtilitiesLocal">Screenshot Utilities - Local</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Help">Le thème utilisera la liste média d’Aniki Helper au lieu de se lier directement au plugin de captures sélectionné.</sys:String>

    <sys:String x:Key="MediaGallery_GenerateThumbnails">Miniatures média</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Button">Générer les miniatures</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Help">Pré-génère les miniatures de toutes les images des plugins de captures. La première génération peut prendre du temps, mais les suivantes devraient être plus rapides.</sys:String>

    <sys:String x:Key="MediaGallery_Status_WindowTitle">Générer les miniatures</sys:String>
    <sys:String x:Key="MediaGallery_Status_Scanning">Analyse des fichiers média...</sys:String>
    <sys:String x:Key="MediaGallery_Status_Progress_Detailed">Génération des miniatures... {0}/{1} analysées, {2} ajoutées.</sys:String>
    <sys:String x:Key="MediaGallery_Status_Done_Detailed">Miniatures générées : {0} ajoutées / {1} analysées ({2} déjà en cache, {3} en échec).</sys:String>
    <sys:String x:Key="MediaGallery_Status_Cancelled_Detailed">Génération annulée : {0} miniatures ajoutées / {1} fichiers analysés.</sys:String>
    <sys:String x:Key="MediaGallery_Status_Failed">Échec de la génération des miniatures.</sys:String>

    <!-- MEDIA GALLERY - THEME / FULLSCREEN OVERRIDES -->

    <sys:String x:Key="LOCAnikiHelperGenerateThumbnailsForGame">Générer les miniatures pour ce jeu</sys:String>
    <sys:String x:Key="LOCAnikiHelperScanningMediaForThisGame">Analyse des fichiers média pour ce jeu...</sys:String>
    <sys:String x:Key="LOCAnikiHelperThumbnailGenerationCancelled">Génération des miniatures annulée.</sys:String>
    <sys:String x:Key="LOCAnikiHelperGeneratingThumbnailsForGame">Génération des miniatures pour {0}... {1}/{2}</sys:String>
    <sys:String x:Key="LOCAnikiHelperUpdatingMediaCache">Mise à jour du cache média...</sys:String>
    <sys:String x:Key="LOCAnikiHelperThumbnailsGenerated">Miniatures générées.</sys:String>
    <sys:String x:Key="LOCAnikiHelperGeneratingGameThumbnails">Générer les miniatures</sys:String>

    <sys:String x:Key="LOCAnikiHelperScanningAllMedia">Analyse des fichiers média...</sys:String>
    <sys:String x:Key="LOCAnikiHelperGeneratingThumbnailsProgress">Génération des miniatures... {0}/{1} analysées, {2} ajoutées.</sys:String>
    <sys:String x:Key="LOCAnikiHelperThumbnailsGeneratedDetailed">Miniatures générées : {0} ajoutées / {1} analysées ({2} déjà en cache, {3} en échec).</sys:String>
    <sys:String x:Key="LOCAnikiHelperThumbnailGenerationCancelledDetailed">Génération annulée : {0} miniatures ajoutées / {1} fichiers analysés.</sys:String>
    <sys:String x:Key="LOCAnikiHelperThumbnailGenerationFailed">Échec de la génération des miniatures.</sys:String>
   
    
    <!-- ========= ACHIEVEMENTS CACHE ========= -->
    <sys:String x:Key="AchievementCache_Title">Cache des souvenirs de trophées</sys:String>
    <sys:String x:Key="AchievementCache_Desc">Reconstruit les souvenirs de trophées à partir de PlayniteAchievements. À utiliser si les icônes, les derniers trophées ou les données de rareté sont manquants ou obsolètes.</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild">Souvenirs de trophées</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Button">Reconstruire le cache</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Help">Analyse PlayniteAchievements et reconstruit les souvenirs de trophées affichés dans le Theme. Cela peut prendre du temps sur les grandes bibliothèques.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Scanning">Analyse des trophées...</sys:String>
    <sys:String x:Key="AchievementCache_Status_Done">Cache des souvenirs de trophées reconstruit : {0} éléments.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Failed">Échec de la reconstruction du cache des souvenirs de trophées.</sys:String>
    <sys:String x:Key="LOCAnikiHelperRefreshAchievementCacheForGame">Rafraîchir les souvenirs de ce jeu</sys:String>
    <!-- ========= CUSTOM ICONS ========= -->
    <sys:String x:Key="CustomIcons_Title">Icônes personnalisées</sys:String>
    <sys:String x:Key="CustomIcons_Desc">Choisissez des dossiers externes pour les icônes de filtres, les icônes de sources et les images de bannières. Ces fichiers remplacent ceux du thème sans modifier les fichiers du thème.</sys:String>
    <sys:String x:Key="CustomIcons_FilterFolder">Dossier des icônes de filtres</sys:String>
    <sys:String x:Key="CustomIcons_SourceFolder">Dossier des icônes de sources</sys:String>
    <sys:String x:Key="CustomIcons_BannerAboveCoverFolder">Dossier des bannières au-dessus des jaquettes</sys:String>
    <sys:String x:Key="CustomIcons_BannerOnCoverFolder">Dossier des bannières sur les jaquettes</sys:String>
    <sys:String x:Key="CustomIcons_Help">Les fichiers PNG doivent utiliser exactement les mêmes noms que les filtres, sources ou plateformes affichés dans Playnite. Exemples : Installed.png, Favorites.png, Steam.png. Utilisez deux dossiers séparés pour les bannières au-dessus des jaquettes et les bannières sur les jaquettes.</sys:String>
    <sys:String x:Key="BrowseFolder">Parcourir...</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterFolderDialog">Sélectionnez le dossier contenant vos icônes PNG de filtres.</sys:String>
    <sys:String x:Key="CustomIcons_SelectSourceFolderDialog">Sélectionnez le dossier contenant vos icônes PNG de sources.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerAboveCoverFolderDialog">Sélectionnez le dossier contenant vos bannières PNG au-dessus des jaquettes.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerOnCoverFolderDialog">Sélectionnez le dossier contenant vos bannières PNG sur les jaquettes.</sys:String>

    <!-- ========= TRACK PLAYTIME FEATURES ========= -->
    <sys:String x:Key="GroupMonthly">Historique mensuel</sys:String>
    <sys:String x:Key="ResetSectionTitle">Réinitialiser le suivi du mois en cours</sys:String>
    <sys:String x:Key="BackupSectionTitle">Sauvegarder et restaurer votre historique</sys:String>

    <sys:String x:Key="MonthlyHelp">Suit votre temps de jeu chaque mois afin que le thème puisse afficher des statistiques comme le temps de jeu du mois, le nombre de jeux joués et votre jeu le plus joué.</sys:String>
    <sys:String x:Key="CurrentMonthData">Mois en cours :</sys:String>
    <sys:String x:Key="SnapshotTooltip">Affiche le moment où le suivi du mois en cours a commencé.</sys:String>

    <sys:String x:Key="ResetWarningText">Attention : cela supprime les données de suivi du mois en cours.</sys:String>
    <sys:String x:Key="ResetBtn">Réinitialiser le suivi du mois en cours</sys:String>
    <sys:String x:Key="ResetBtnTooltip">Supprime les données de suivi du mois en cours et redémarre le suivi à partir de maintenant.</sys:String>
    <sys:String x:Key="ResetBtntip">N’utilisez pas ce bouton sauf si vous voulez vraiment effacer le suivi du mois actuel. Les statistiques mensuelles du mois en cours repartiront de zéro après la réinitialisation.</sys:String>

    <sys:String x:Key="ExportMonthlyBackupBtn">Exporter les statistiques mensuelles</sys:String>
    <sys:String x:Key="ImportMonthlyBackupBtn">Importer les statistiques mensuelles</sys:String>
    <sys:String x:Key="ExportMonthlyBackupTooltip">Exporte toutes les données des statistiques mensuelles dans un fichier JSON.</sys:String>
    <sys:String x:Key="ImportMonthlyBackupTooltip">Restaure les statistiques mensuelles depuis une sauvegarde JSON précédemment exportée.</sys:String>
    <sys:String x:Key="MonthlyBackupHelp">Exportez ou restaurez les statistiques de temps de jeu mensuelles enregistrées par Aniki Helper. C’est utile avant de réinstaller Playnite ou de réinitialiser votre bibliothèque.</sys:String>
    <sys:String x:Key="MonthlyBackup_SectionTitle">Statistiques mensuelles</sys:String>
    <sys:String x:Key="MonthlyBackup_ScopeNote">Cette sauvegarde contient uniquement les données des statistiques mensuelles. Elle ne modifie pas la configuration du thème, le compte Steam, les plugins, les jeux ni les médias.</sys:String>
    <sys:String x:Key="DangerZone_Title">Zone de danger</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Help">Supprime définitivement toutes les statistiques mensuelles enregistrées par Aniki Helper. Le suivi du mois en cours recommencera au moment de la suppression.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Warning">Cette action est irréversible, sauf si vous avez préalablement exporté une sauvegarde.</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsBtn">Supprimer toutes les statistiques mensuelles</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsTooltip">Supprime définitivement toutes les statistiques mensuelles et redémarre le suivi du mois en cours à partir de maintenant.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Confirm">Voulez-vous vraiment supprimer définitivement toutes les statistiques mensuelles ? Le suivi du mois en cours recommencera à partir de maintenant. Cette action est irréversible, sauf si vous avez exporté une sauvegarde.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Success">Toutes les statistiques mensuelles ont été supprimées. Le suivi recommence à partir de maintenant.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Error">Erreur lors de la suppression des statistiques mensuelles :</sys:String>

    <!-- ========= VIDEO FEATURES ========= -->
    <sys:String x:Key="Video">Vidéo</sys:String>

    <sys:String x:Key="StartupIntro_Title">Vidéo d’introduction</sys:String>
    <sys:String x:Key="StartupIntro_Desc">Joue une vidéo d’introduction au lancement de Playnite.</sys:String>
    <sys:String x:Key="StartupIntro_Enable">Activer la vidéo d’introduction</sys:String>
    <sys:String x:Key="IntroVideo_Help">Désactivez cette option pour lancer Playnite sans la vidéo d’introduction.</sys:String>

    <sys:String x:Key="ShutdownVideo_Title">Vidéo de fermeture</sys:String>
    <sys:String x:Key="ShutdownVideo_Desc">Joue une vidéo de fermeture lors de la fermeture de Playnite.</sys:String>
    <sys:String x:Key="ShutdownVideo_Enable">Activer la vidéo de fermeture</sys:String>
    <sys:String x:Key="ShutdownVideo_Help">Désactivez cette option pour fermer Playnite sans la vidéo de fermeture.</sys:String>

    <!-- ========= SOUND FEATURES ========= -->
    <sys:String x:Key="EventSounds_Title">Sons d’événements</sys:String>
    <sys:String x:Key="EventSounds_Desc">Joue des effets sonores lors d’événements comme le lancement de jeux, l’ouverture/fermeture de Playnite ou les mises à jour de la bibliothèque. Fonctionne avec les sons inclus dans le thème.</sys:String>
    <sys:String x:Key="EventSounds_Enable">Activer les sons d’événements</sys:String>
    <sys:String x:Key="EventSounds_Help">Si activé, désactivez les sons UI/événements du plugin PlayniteSounds pour éviter les doublons.</sys:String>

    <!-- ========= GameOverlay FEATURES ========= -->
    <sys:String x:Key="KeyboardMouse_Tab">Clavier et souris</sys:String>
    <sys:String x:Key="KeyboardMouse_Intro">Utilisez le clavier virtuel et contrôlez la souris Windows directement avec votre manette. Ces fonctions sont indépendantes de l’overlay en jeu et restent disponibles tant que Playnite Fullscreen est lancé.</sys:String>
    <sys:String x:Key="InGameOverlay_Tab">Overlay en jeu</sys:String>
    <sys:String x:Key="InGameOverlay_Title">Overlay en jeu</sys:String>
    <sys:String x:Key="InGameOverlay_Desc">Affiche un panneau d’actions rapides Aniki au-dessus du jeu en cours.</sys:String>

    <sys:String x:Key="InGameOverlay_Settings_Title">Réglages de l’overlay</sys:String>
    <sys:String x:Key="InGameOverlay_Settings_Desc">Configure l’overlay en jeu d’Aniki et son raccourci clavier.</sys:String>

    <sys:String x:Key="InGameOverlay_Enable">Activer l’overlay en jeu</sys:String>
    <sys:String x:Key="InGameOverlay_Enable_Help">Active l’overlay en jeu propre à Aniki Helper. Désactive cette option si tu préfères utiliser l’overlay de Playnite ou une autre solution d’overlay.</sys:String>

    <sys:String x:Key="InGameOverlay_Hotkey_Title">Raccourci de l’overlay</sys:String>
    <sys:String x:Key="InGameOverlay_Hotkey_Help">Choisis le raccourci clavier utilisé pour ouvrir l’overlay en jeu. Redémarre Playnite après avoir modifié ce réglage.</sys:String>

    <sys:String x:Key="InGameOverlay_ControllerShortcut_Title">Raccourci manette</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Help">Choisis le raccourci manette utilisé pour ouvrir l’overlay en jeu. Le bouton Guide est expérimental et peut être capturé par Steam, Windows ou certains outils manette.</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_StartBack">Start + Select</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_BackY">Select + Y</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Guide">Bouton Guide</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Disabled">Désactivé</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Title">Clavier virtuel</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Desc">Choisissez le clavier virtuel utilisé par Aniki Helper. Il peut être ouvert depuis le bouton de l’overlay ou avec son raccourci manette direct tant que Playnite Fullscreen est lancé.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Title">Clavier utilisé</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Aniki">Clavier Aniki</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Windows">Clavier Windows</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Help">Le clavier Windows utilise la dernière disposition sélectionnée dans Windows. Sélectionne une fois la disposition Manette dans ses paramètres. Sa disponibilité dépend de la version de Windows.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Title">Raccourci direct</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_L3R3Hold">Maintenir LS + RS (par défaut)</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_BackX">Back / Select / View + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_GuideX">Guide + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Disabled">Désactivé</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Help">Maintiens LS + RS pendant 600 ms. Guide + X peut être intercepté par Steam, Xbox Game Bar, Windows ou certains outils manette.</sys:String>

    <sys:String x:Key="InGameOverlay_GamepadMouse_Title">Souris à la manette</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouse_Desc">Utilisez la manette comme souris Windows tant que Playnite Fullscreen est lancé. Le stick droit déplace le curseur, le stick gauche fait défiler rapidement, A fait un clic gauche, X un clic droit et LT / RT permettent un défilement précis.</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Title">Raccourci d’activation</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_BackR3">Maintenir Back + RS (par défaut)</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_StartL3">Maintenir Start + LS</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_GuideY">Maintenir Guide + Y</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Disabled">Désactivé</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Help">Maintiens le raccourci choisi pendant 600 ms pour activer ou désactiver la souris. Tu peux maintenir A en déplaçant le stick droit pour faire un glisser-déposer. Guide + Y peut être intercepté par Steam, Xbox Game Bar, Windows ou certains outils manette.</sys:String>
    <sys:String x:Key="LOCGamepadMouseEnabledToast">Souris à la manette activée</sys:String>
    <sys:String x:Key="LOCGamepadMouseDisabledToast">Souris à la manette désactivée</sys:String>

    <sys:String x:Key="InGameOverlay_GameBehavior_Title">Comportement du jeu quand l’overlay est ouvert</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_DoNothing">Par défaut : ne rien faire</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_SuspendGame">Suspendre le jeu quand l’overlay est ouvert</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_Help">Choisis si Aniki Helper doit laisser le jeu tourner normalement ou figer temporairement le processus du jeu pendant que l’overlay est ouvert pour éviter les doubles inputs.</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_Warning">Attention : déconseillé pour les jeux en ligne, multijoueur, protégés par anti-cheat ou lancés en administrateur.</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Title">Jeux à ne jamais suspendre</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Help">Les jeux ajoutés depuis clic droit → Aniki Helper → Overlay Settings → Never suspend this game apparaissent ici. Décoche un jeu pour le retirer de la liste.</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Clear">Vider la liste</sys:String>
    <sys:String x:Key="LOCAnikiHelperOverlayNeverSuspendThisGame">Never suspend this game</sys:String>
    <sys:String x:Key="LOCAnikiHelperOverlayAllowSuspendThisGame">Allow suspend for this game</sys:String>

    <sys:String x:Key="InGameOverlay_Limitations_Title">Limitation</sys:String>
    <sys:String x:Key="InGameOverlay_Limitations_Desc">Cet overlay est une fenêtre transparente affichée au-dessus du jeu. Il n’est pas injecté directement dans le jeu comme les overlays Steam ou Discord.</sys:String>
    <sys:String x:Key="InGameOverlay_Limitations_Help">Il fonctionne mieux avec les jeux en mode fenêtré sans bordure ou plein écran fenêtré. Certains jeux en plein écran exclusif, certains anti-cheats ou certains jeux lancés en administrateur peuvent empêcher l’overlay de s’afficher correctement.</sys:String>
    <sys:String x:Key="LOCInGameOverlayFooterTitle">Aniki Control Center</sys:String>
    <sys:String x:Key="LOCInGameOverlayNoGameRunning">Aucun jeu lancé</sys:String>
    <sys:String x:Key="LOCInGameOverlayNoActiveGame">Aucun jeu actif détecté</sys:String>
    <sys:String x:Key="LOCInGameOverlayLessThanOneMinute">moins de 1 min</sys:String>
    <sys:String x:Key="LOCInGameOverlayQuitDialogTitle">Quitter {0} ?</sys:String>
    <sys:String x:Key="LOCInGameOverlayQuitDialogMessage">Cela tentera de fermer la fenêtre du jeu actif.</sys:String>

    <sys:String x:Key="LOCInGameOverlayCancel">Annuler</sys:String>
    <sys:String x:Key="LOCInGameOverlayConfirmQuit">Quitter le jeu</sys:String>

    <sys:String x:Key="LOCInGameOverlayControlCenter">CONTROL CENTER</sys:String>
    <sys:String x:Key="LOCInGameOverlayBackHint">B / Retour pour fermer</sys:String>
    <sys:String x:Key="LOCInGameOverlayReturnToPlaynite">Retour à Playnite</sys:String>
    <sys:String x:Key="LOCInGameOverlayReturnToGame">Retour au jeu</sys:String>
    <sys:String x:Key="LOCInGameOverlayQuitGame">Quitter le jeu</sys:String>
