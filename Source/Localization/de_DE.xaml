    <!-- Steam account / connection -->
    <sys:String x:Key="SteamAccount_GroupTitle">Steam-Kontoverbindung</sys:String>
    <sys:String x:Key="SteamAccount_GroupDesc">Verbinde dich einmal, um Steam-Freunde, Meine Wunschliste, Für dich und personalisierte Steam-Empfehlungen zu verwenden.</sys:String>
    <sys:String x:Key="SteamAccount_ConnectButton">Mit Steam verbinden</sys:String>
    <sys:String x:Key="SteamAccount_ReconnectButton">Erneut mit Steam verbinden</sys:String>
    <sys:String x:Key="SteamAccount_CheckButton">Verbindung prüfen</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectButton">Trennen</sys:String>
    <sys:String x:Key="SteamAccount_StatusLabel">Verbindungsstatus</sys:String>
    <sys:String x:Key="SteamAccount_SteamIdLabel">Steam-Konto:</sys:String>
    <sys:String x:Key="SteamAccount_ConfiguredBadge">KONFIGURIERT</sys:String>
    <sys:String x:Key="SteamAccount_MissingBadge">FEHLT</sys:String>
    <sys:String x:Key="SteamAccount_OptionalBadge">OPTIONAL</sys:String>
    <sys:String x:Key="SteamAccount_ConnectedTitle">Mit Steam verbunden</sys:String>
    <sys:String x:Key="SteamAccount_ConnectedDesc">Deine Steam-Sitzung ist aktiv. Steam-Freunde, Meine Wunschliste und Für dich können verwendet werden.</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectedTitle">Nicht mit Steam verbunden</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectedDesc">Verbinde dein Steam-Konto. Die offizielle Steam-Anmeldeseite öffnet sich und schließt nach der Anmeldung automatisch.</sys:String>
    <sys:String x:Key="SteamAccount_ProfileLabel">Erkanntes Steam-Profil / SteamID</sys:String>
    <sys:String x:Key="SteamAccount_ApiKeyTitle">Steam Web API-Schlüssel</sys:String>
    <sys:String x:Key="SteamAccount_ApiKeyDesc">Erforderlich für Steam-Freunde und zur Verbesserung der Store-Empfehlungen anhand deiner eigenen und kürzlich gespielten Spiele. Der Store funktioniert auch ohne ihn, aber Freundesdaten und einige Personalisierungsfunktionen sind dann nicht verfügbar.</sys:String>
    <sys:String x:Key="SteamAccount_ManualSteamIdTitle">Erweiterter SteamID-Ersatz</sys:String>
    <sys:String x:Key="SteamAccount_ManualSteamIdDesc">Optional. Verwende dies nur, wenn die automatische SteamID-Erkennung fehlschlägt.</sys:String>
    <sys:String x:Key="SteamAccount_PrivacyNotice">Es ist kein Steam Web API-Schlüssel erforderlich und deine Steam-Freundesliste muss nicht öffentlich sein.</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoTitle">Eine Steam-Verbindung für alles</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoDesc">Dieselbe Verbindung versorgt Steam-Freunde, Meine Wunschliste, Für dich und deine personalisierten Empfehlungen. Wenn die Sitzung abläuft, verbinde dich einfach erneut.</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoPrivacy">Kein API-Schlüssel erforderlich. Deine Steam-Freundesliste kann privat bleiben.</sys:String>
    <sys:String x:Key="SteamAccount_TokenMissingTitle">Steam-Dienste sind nicht bereit</sys:String>
    <sys:String x:Key="SteamAccount_TokenMissingDesc">Dein Steam-Konto ist verbunden, aber die Sitzung muss aktualisiert werden. Verwende „Verbindung prüfen“ oder trenne die Verbindung und verbinde dich erneut.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheTitle">Steam-Anmeldung lädt ständig neu?</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheDesc">Ein beschädigter Playnite-Webcache kann verhindern, dass die Steam-Anmeldeseite korrekt geladen wird.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheNote">Dadurch wird der gemeinsame Browser-Cache von Playnite gelöscht und Playnite neu gestartet. Browserbasierte Integrationen können eine erneute Anmeldung verlangen. Manueller Pfad: Playnite-Einstellungen → Erweitert → Webcache leeren.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheButton">Webcache leeren und neu starten</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheConfirm">Playnite muss neu gestartet werden, um den gemeinsamen Webcache zu leeren. Browserbasierte Integrationen können dich auffordern, dich erneut anzumelden. Fortfahren?</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheError">Playnite konnte nicht neu gestartet und der Webcache nicht geleert werden. Verwende Playnite-Einstellungen → Erweitert → Webcache leeren.</sys:String>
    <sys:String x:Key="SteamFullscreen_DisconnectedSummary">Die Steam-Anmeldung ist in den Aniki-Helper-Einstellungen im Desktop-Modus von Playnite verfügbar.</sys:String>
    <sys:String x:Key="SteamFullscreen_PrivacyHelp">Verbinde dich dort, kehre zu Fullscreen zurück und wähle anschließend „Verbindung prüfen“.</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesLabel">Steam-Dienste</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesReady">Bereit</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesMissing">Aktualisierung erforderlich</sys:String>
    <sys:String x:Key="SteamFullscreen_ConnectedSummary">Verwende „Verbindung prüfen“, wenn der angezeigte Status veraltet ist oder eine Steam-Funktion nicht mehr funktioniert.</sys:String>

    <sys:String x:Key="SteamFullscreen_AccountLabel">Steam-Konto verknüpft</sys:String>
    <sys:String x:Key="SteamFullscreen_SteamIdLabel">SteamID erkannt oder konfiguriert</sys:String>
    <sys:String x:Key="SteamFullscreen_ApiKeyLabel">Steam Web API-Schlüssel</sys:String>

    <sys:String x:Key="SteamFullscreen_StatusReady">Konfiguriert</sys:String>
    <sys:String x:Key="SteamFullscreen_StatusMissing">Fehlt</sys:String>

    <sys:String x:Key="SteamFullscreen_ConfigurationReady">Die Steam-Konfiguration ist vollständig.</sys:String>
