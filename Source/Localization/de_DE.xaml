    <!-- Update data -->
    <sys:String x:Key="SteamInitCache_ProgressTitle">Update-Daten</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressDesc">Das Plugin prüft Steam-Spielupdates, während du deine Bibliothek durchsuchst. Du kannst einen vollständigen Bibliotheksscan ausführen, um die Update-Daten für alle Spiele vorab zu füllen, anstatt jedes Spiel einzeln aufrufen zu müssen. Das hilft, falsche Update-Benachrichtigungen zu vermeiden und verbessert die Leistung bei der Navigation.</sys:String>
    <sys:String x:Key="SteamInitCache">Bibliothek scannen</sys:String>
    <sys:String x:Key="SteamInitCache_Tooltip">Durchsucht deine Steam-Spiele und bereitet Update-Daten vor.</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressNote">Ein Bibliotheksscan wird empfohlen, um falsche Benachrichtigungen zu vermeiden und die Leistung zu verbessern.</sys:String>
