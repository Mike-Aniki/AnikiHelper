    <sys:String x:Key="GroupLibraryStats">Bibliotheksstatistiken</sys:String>
    <sys:String x:Key="StatsHelp">Wähle aus, welche Spiele in die vom Theme angezeigten Statistiken einbezogen werden.</sys:String>
    <sys:String x:Key="IncludeHidden">Versteckte Spiele einbeziehen</sys:String>
    <sys:String x:Key="AutoUpdate">Die Statistiken werden automatisch aktualisiert, wenn sich deine Bibliothek ändert.</sys:String>
