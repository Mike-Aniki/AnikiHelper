    <sys:String x:Key="AppTitle">Aniki Helper</sys:String>
    <sys:String x:Key="AppSubtitle">Einstellungen</sys:String>
    <sys:String x:Key="AppInfo">Aniki Helper bietet Steam-Dienste, Integrationen externer Plugins und exklusive Aniki-Funktionen für kompatible Themes.</sys:String>
    
    <sys:String x:Key="MoreOptionsDesktop">Weitere Optionen sind in den Plugin-Einstellungen im Desktop-Modus von Playnite verfügbar.</sys:String>
    <sys:String x:Key="GroupAdditionalFeatures">Zusätzliche Funktionen</sys:String>

    <sys:String x:Key="GroupGeneral">Allgemein</sys:String>
    <sys:String x:Key="GroupNews">News</sys:String>
    <sys:String x:Key="GroupDynamicColors">Dynamische Farben</sys:String>
    <sys:String x:Key="GameLaunchSplash_VideoVolume_Title">Videolautstärke</sys:String>
    <sys:String x:Key="GameLaunchSplash_BackgroundDimming_Title">Hintergrund abdunkeln</sys:String>
    <sys:String x:Key="GameLaunchSplash_BackgroundDimming_Help">Passt die dauerhafte Abdunklung von Splashscreen-Bildern an. Splashscreen-Videos werden nicht abgedunkelt. Standard: 37 %.</sys:String>
<sys:String x:Key="LOCDebugLogsTitle">Debug</sys:String>
    <sys:String x:Key="LOCDebugLogsDescription">Aktiviere dies nur zur Fehlerbehebung und wenn du einen Debug-Bericht senden musst. Es schreibt detaillierte Informationen von Aniki Helper in extensions.log und kann sehr viele Log-Einträge erzeugen.</sys:String>
    <sys:String x:Key="LOCEnableDebugLogs">Debug-Logs aktivieren</sys:String>
    <sys:String x:Key="LOCDebugLogsInfo">Für einen sauberen Debug-Bericht: Leere die Log-Datei, aktiviere den Debug-Modus, reproduziere den Fehler und sende anschließend die Datei extensions.log. Der Debug-Modus wird nach 24 Stunden beim nächsten Start von Playnite automatisch deaktiviert.</sys:String>
    <sys:String x:Key="LOCClearLogFile">Log-Datei leeren</sys:String>
    <sys:String x:Key="LOCOpenLogsFolder">Log-Ordner öffnen</sys:String>

    <!-- ========= HUB FEATURES ========= -->
    <sys:String x:Key="WelcomeHubStartup_Title">Startbildschirm</sys:String>
    <sys:String x:Key="WelcomeHubStartup_Desc">Wähle, welcher Bildschirm beim Start von Playnite angezeigt wird: deine Bibliothek oder der Hub.</sys:String>
    <sys:String x:Key="WelcomeHubStartup_Enable">Hub beim Start öffnen</sys:String>

    <sys:String x:Key="HubApps_Title">Hub-Funktionen &amp; Apps</sys:String>
    <sys:String x:Key="HubApps_Desc">Zeige bis zu 4 integrierte Aniki-Funktionen oder Playnite-Software-Tools direkt im Hub an.</sys:String>
    <sys:String x:Key="HubApps_Enable">Seite „Funktionen &amp; Apps“ im Hub anzeigen</sys:String>
    <sys:String x:Key="HubApps_Slot1">Slot 1</sys:String>
    <sys:String x:Key="HubApps_Slot2">Slot 2</sys:String>
    <sys:String x:Key="HubApps_Slot3">Slot 3</sys:String>
    <sys:String x:Key="HubApps_Slot4">Slot 4</sys:String>
    <sys:String x:Key="HubApps_Help">Wähle bis zu 4 integrierte Aniki-Funktionen oder Playnite-Software-Tools. Zu den integrierten Funktionen gehören Webbrowser, Aufnahmegalerie, Steam-Freunde, Steam Store, Musikplayer und Aniki Media Center. Für jeden Slot kann optional ein eigenes Hintergrundbild verwendet werden; andernfalls nutzt das Theme einen Standardhintergrund für Aniki-Funktionen und einen allgemeinen Ersatz für Software-Tools.</sys:String>
    <sys:String x:Key="HubApps_SelectBackgroundDialog">Wähle ein Hintergrundbild für diese Hub-App-Karte.</sys:String>
    <sys:String x:Key="BrowseImage">Bild...</sys:String>
    <sys:String x:Key="HubApps_None">Keine</sys:String>
    <sys:String x:Key="HubApps_GroupAnikiFeatures">ANIKI-FUNKTIONEN</sys:String>
    <sys:String x:Key="HubApps_GroupSoftwareTools">SOFTWARE-TOOLS</sys:String>
    <sys:String x:Key="HubFeature_WebBrowser">Aniki-Webbrowser</sys:String>
    <sys:String x:Key="HubFeature_MediaGallery">Aufnahmengalerie</sys:String>
    <sys:String x:Key="HubFeature_SteamFriends">Steam-Freunde</sys:String>
    <sys:String x:Key="HubFeature_SteamStore">Steam Store</sys:String>
    <sys:String x:Key="HubFeature_MusicPlayer">Musikplayer</sys:String>
    <sys:String x:Key="HubFeature_VideoPlayer">Aniki Media Center</sys:String>
    <sys:String x:Key="HubFeature_MusicPlayerRequiresUPS">UniPlaySong muss installiert sein, um den Musikplayer zu öffnen.</sys:String>
    <sys:String x:Key="HubApps_Loading">Ausgewählte Verknüpfungen werden geladen...</sys:String>
    <sys:String x:Key="HubApps_Empty">Wähle Funktionen oder Apps in den Einstellungen von Aniki Helper aus.</sys:String>
    <sys:String x:Key="LOCHubAppsTitle">Funktionen &amp; Apps</sys:String>
    <sys:String x:Key="LOCHubAppsSubtitle">Integrierte Aniki-Funktionen und ausgewählte Software-Tools</sys:String>

    <sys:String x:Key="WelcomeHubStartup_Help">Wenn deaktiviert, öffnet Playnite direkt deine Bibliothek.</sys:String>
    <sys:String x:Key="HubVideoCenterPage_Enable">Aniki-Video-Center-Seite im Hub anzeigen</sys:String>
    <sys:String x:Key="HubVideoCenterPage_Help">Zeigt bis zu vier zwischengespeicherte Medienkarten aus „Kürzlich angesehen“ und „Kürzlich hinzugefügt“. Die Seite wird automatisch ausgeblendet, wenn das Media Center keine Inhalte enthält.</sys:String>

