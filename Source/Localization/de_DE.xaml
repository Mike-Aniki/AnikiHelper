    <!-- ========= MEDIA GALLERY ========= -->

    <sys:String x:Key="MediaGallery_Title">Aufnahmegalerie</sys:String>
    <sys:String x:Key="MediaGallery_Desc">Aniki Helper liest Medien aus Screenshots Visualizer und Screenshot Utilities. Konfiguriere deine Screenshot-Ordner in diesen Plugins; Aniki Helper liest nur deren Daten und erzeugt Vorschaubilder, um die Navigation im Theme zu beschleunigen.</sys:String>

    <sys:String x:Key="MediaGallery_Provider_Title">Screenshot-Plugin</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Visualizer">Screenshots Visualizer</sys:String>
    <sys:String x:Key="MediaGallery_Provider_UtilitiesLocal">Screenshot Utilities - Local</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Help">Das Theme verwendet die Medienliste von Aniki Helper, statt direkt an das ausgewählte Screenshot-Plugin gebunden zu sein.</sys:String>

    <sys:String x:Key="MediaGallery_GenerateThumbnails">Medien-Miniaturen</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Button">Miniaturen generieren</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Help">Erzeugt im Voraus Vorschaubilder für alle Bilder aus den Screenshot-Plugins. Die erste Erstellung kann etwas dauern, spätere Durchläufe sollten schneller sein.</sys:String>

    <sys:String x:Key="MediaGallery_Status_WindowTitle">Vorschaubilder erzeugen</sys:String>
    <sys:String x:Key="MediaGallery_Status_Scanning">Mediendateien werden durchsucht...</sys:String>
    <sys:String x:Key="MediaGallery_Status_Progress_Detailed">Vorschaubilder werden erzeugt... {0}/{1} geprüft, {2} hinzugefügt.</sys:String>
    <sys:String x:Key="MediaGallery_Status_Done_Detailed">Vorschaubilder erzeugt: {0} hinzugefügt / {1} geprüft ({2} bereits im Cache, {3} fehlgeschlagen).</sys:String>
    <sys:String x:Key="MediaGallery_Status_Cancelled_Detailed">Erstellung abgebrochen: {0} Vorschaubilder hinzugefügt / {1} Dateien geprüft.</sys:String>
    <sys:String x:Key="MediaGallery_Status_Failed">Erstellung der Vorschaubilder fehlgeschlagen.</sys:String>

