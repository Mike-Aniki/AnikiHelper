    <!-- Steam Friends -->
    <sys:String x:Key="LOCSteamFriends_Title">Steam-Freunde</sys:String>
    <sys:String x:Key="LOCSteamFriends_Subtitle">Zeigt den Status deiner Steam-Freunde im Aniki-Theme an: Online-Freunde, aktuelle Spiele, Profilkarten und Benachrichtigungen im Theme.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Enable">Steam-Freunde-Integration aktivieren</sys:String>
    <sys:String x:Key="LOCSteamFriends_EnableHelp">Schaltet die vom Theme verwendeten Steam-Freundesdaten ein oder aus.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Display">Anzeige</sys:String>
    <sys:String x:Key="LOCSteamFriends_OnlineInfo">Das Theme kann bis zu 15 Online-Freunde gleichzeitig anzeigen. Freunde werden nach Status priorisiert: zuerst im Spiel, dann online, abwesend und beschäftigt.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ShowOffline">Offline-Freunde anzeigen</sys:String>
    <sys:String x:Key="LOCSteamFriends_OfflineInfo">Offline-Freunde sind optional und auf 40 gleichzeitig begrenzt, damit die Navigation flüssig bleibt.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Notifications">Benachrichtigungen</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStart">Benachrichtigen, wenn ein Freund ein Spiel startet</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStartHelp">Zeigt eine Benachrichtigung im Theme an, wenn ein Steam-Freund zu spielen beginnt.</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnect">Benachrichtigen, wenn ein Freund online kommt</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnectHelp">Zeigt eine Benachrichtigung im Theme an, wenn ein Steam-Freund online kommt.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedDetails_Title">Spieldetails</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Section">Von Freunden gespielte Spiele</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Refresh">Von Freunden gespielte Spiele aktualisieren</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Help">Erstellt einen lokalen Steam-Cache, mit dem die Detailansicht Freunde anzeigen kann, die das ausgewählte Spiel bereits gespielt haben. Der Scan kann je nach Anzahl deiner Freunde etwas dauern.</sys:String>
