    <!-- Steam Friends -->
    <sys:String x:Key="LOCSteamFriends_Title">Steam přátelé</sys:String>
    <sys:String x:Key="LOCSteamFriends_Subtitle">Zobrazuje stav vašich přátel na Steamu v motivu Aniki: online přátele, aktuální hry, profilové karty a oznámení přímo v motivu.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Enable">Zapnout integraci Steam Friends</sys:String>
    <sys:String x:Key="LOCSteamFriends_EnableHelp">Zapne nebo vypne data Steam Friends používaná motivem.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Display">Zobrazení</sys:String>
    <sys:String x:Key="LOCSteamFriends_OnlineInfo">Motiv může zobrazit až 15 online přátel současně. Přátelé se řadí podle stavu: nejprve ve hře, potom online, pryč a zaneprázdněný.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ShowOffline">Zobrazit offline přátele</sys:String>
    <sys:String x:Key="LOCSteamFriends_OfflineInfo">Offline přátelé jsou volitelní a jejich počet je omezen na 40 současně, aby navigace zůstala plynulá.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Notifications">Oznámení</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStart">Upozornit, když přítel spustí hru</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStartHelp">Zobrazí oznámení v motivu, když přítel na Steamu začne hrát.</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnect">Upozornit, když se přítel připojí</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnectHelp">Zobrazí oznámení v motivu, když se přítel na Steamu připojí.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedDetails_Title">Detaily hry</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Section">Hry hrané přáteli</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Refresh">Obnovit hry hrané přáteli</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Help">Vytvoří místní mezipaměť Steamu, kterou zobrazení detailů používá k zobrazení přátel, kteří už vybranou hru hráli. Doba prohledávání závisí na počtu přátel.</sys:String>
