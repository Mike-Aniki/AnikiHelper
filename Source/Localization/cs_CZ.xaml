    <sys:String x:Key="SteamStore_Enable_Desc">Zapne sekce Steam Store v motivu.</sys:String>
    <sys:String x:Key="SteamStore_Enable_Help">Pokud je vypnuto, sekce obchodu se již v motivu nebudou zobrazovat.</sys:String>


    <!-- Steam account / connection -->
    <sys:String x:Key="SteamAccount_GroupTitle">Připojení účtu Steam</sys:String>
    <sys:String x:Key="SteamAccount_GroupDesc">Připojte se jednou a používejte Steam Friends, Můj seznam přání, Pro vás a personalizovaná doporučení Steamu.</sys:String>
    <sys:String x:Key="SteamAccount_ConnectButton">Připojit ke Steamu</sys:String>
    <sys:String x:Key="SteamAccount_ReconnectButton">Znovu připojit ke Steamu</sys:String>
    <sys:String x:Key="SteamAccount_CheckButton">Zkontrolovat připojení</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectButton">Odpojit</sys:String>
    <sys:String x:Key="SteamAccount_StatusLabel">Stav připojení</sys:String>
    <sys:String x:Key="SteamAccount_SteamIdLabel">Účet Steam:</sys:String>
    <sys:String x:Key="SteamAccount_ConfiguredBadge">NASTAVENO</sys:String>
    <sys:String x:Key="SteamAccount_MissingBadge">CHYBÍ</sys:String>
    <sys:String x:Key="SteamAccount_OptionalBadge">VOLITELNÉ</sys:String>
    <sys:String x:Key="SteamAccount_ConnectedTitle">Připojeno ke Steamu</sys:String>
    <sys:String x:Key="SteamAccount_ConnectedDesc">Vaše relace Steam je aktivní. Steam Friends, Můj seznam přání a Pro vás jsou připravené k použití.</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectedTitle">Nepřipojeno ke Steamu</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectedDesc">Připojte svůj účet Steam. Otevře se oficiální přihlašovací stránka Steamu a po přihlášení se automaticky zavře.</sys:String>
    <sys:String x:Key="SteamAccount_ProfileLabel">Rozpoznaný profil Steam / SteamID</sys:String>
    <sys:String x:Key="SteamAccount_ApiKeyTitle">Klíč Steam Web API</sys:String>
    <sys:String x:Key="SteamAccount_ApiKeyDesc">Je vyžadován pro Steam Friends a používá se ke zlepšení doporučení v obchodu podle her, které vlastníte a které jste nedávno hráli. Obchod může fungovat i bez něj, ale data přátel a některé možnosti personalizace nebudou dostupné.</sys:String>
    <sys:String x:Key="SteamAccount_ManualSteamIdTitle">Pokročilé náhradní SteamID</sys:String>
    <sys:String x:Key="SteamAccount_ManualSteamIdDesc">Volitelné. Použijte pouze tehdy, když automatické rozpoznání SteamID selže.</sys:String>
    <sys:String x:Key="SteamAccount_PrivacyNotice">Klíč Steam Web API není potřeba a váš seznam přátel na Steamu nemusí být veřejný.</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoTitle">Jedno připojení ke Steamu pro vše</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoDesc">Stejné připojení zajišťuje Steam Friends, Můj seznam přání, Pro vás i personalizovaná doporučení. Pokud relace vyprší, jednoduše se znovu připojte.</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoPrivacy">API klíč není potřeba. Seznam přátel na Steamu může zůstat soukromý.</sys:String>
    <sys:String x:Key="SteamAccount_TokenMissingTitle">Služby Steamu nejsou připravené</sys:String>
    <sys:String x:Key="SteamAccount_TokenMissingDesc">Účet Steam je připojený, ale relaci je potřeba obnovit. Použijte Zkontrolovat připojení nebo se odpojte a znovu připojte.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheTitle">Přihlašování ke Steamu se stále obnovuje?</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheDesc">Poškozená webová mezipaměť Playnite může zabránit správnému načtení přihlašovací stránky Steamu.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheNote">Tím se vymaže sdílená mezipaměť prohlížeče Playnite a Playnite se restartuje. Integrace využívající prohlížeč mohou vyžadovat nové přihlášení. Ručně: Playnite Settings → Advanced → Clear web cache.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheButton">Vymazat webovou mezipaměť a restartovat</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheConfirm">Playnite se musí restartovat, aby mohl vymazat sdílenou webovou mezipaměť. Integrace využívající prohlížeč mohou vyžadovat nové přihlášení. Pokračovat?</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheError">Playnite se nepodařilo restartovat a webovou mezipaměť vymazat. Použijte Playnite Settings → Advanced → Clear web cache.</sys:String>
    <sys:String x:Key="SteamFullscreen_DisconnectedSummary">Přihlášení ke Steamu je dostupné v nastavení Aniki Helperu v desktopovém režimu Playnite.</sys:String>
    <sys:String x:Key="SteamFullscreen_PrivacyHelp">Připojte se tam, vraťte se do Fullscreen režimu a zvolte Zkontrolovat připojení.</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesLabel">Služby Steamu</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesReady">Připraveno</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesMissing">Je potřeba obnovit</sys:String>
    <sys:String x:Key="SteamFullscreen_ConnectedSummary">Pokud je zobrazený stav zastaralý nebo některá funkce Steamu přestane fungovat, použijte Zkontrolovat připojení.</sys:String>

    <sys:String x:Key="SteamFullscreen_AccountLabel">Připojený účet Steam</sys:String>
    <sys:String x:Key="SteamFullscreen_SteamIdLabel">SteamID rozpoznáno nebo nastaveno</sys:String>
    <sys:String x:Key="SteamFullscreen_ApiKeyLabel">Klíč Steam Web API</sys:String>

    <sys:String x:Key="SteamFullscreen_StatusReady">Nastaveno</sys:String>
    <sys:String x:Key="SteamFullscreen_StatusMissing">Chybí</sys:String>

