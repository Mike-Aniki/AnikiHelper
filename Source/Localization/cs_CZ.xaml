    <!-- ========= ACHIEVEMENTS CACHE ========= -->
    <sys:String x:Key="AchievementCache_Title">Mezipaměť vzpomínek na úspěchy</sys:String>
    <sys:String x:Key="AchievementCache_Desc">Znovu vytvoří vzpomínky na úspěchy z PlayniteAchievements. Použijte, pokud chybí nebo jsou zastaralé ikony, nedávné úspěchy či údaje o vzácnosti.</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild">Vzpomínky na úspěchy</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Button">Znovu vytvořit mezipaměť</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Help">Prohledá PlayniteAchievements a znovu vytvoří vzpomínky na úspěchy zobrazované v motivu. U velkých knihoven to může chvíli trvat.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Scanning">Prohledávání úspěchů...</sys:String>
