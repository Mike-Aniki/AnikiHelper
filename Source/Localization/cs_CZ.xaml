    <!-- ========= ANIKI SCREENSAVER ========= -->
    <sys:String x:Key="SettingsNav_ScreenSaver">Aniki ScreenSaver</sys:String>
    <sys:String x:Key="SettingsPage_ScreenSaverDesc">Po určité době nečinnosti automaticky představuje hry z vaší knihovny.</sys:String>
    <sys:String x:Key="ScreenSaver_Enable">Zapnout Aniki ScreenSaver</sys:String>
    <sys:String x:Key="ScreenSaver_Enable_Help">ScreenSaver se spustí pouze ve Fullscreen režimu, když je Playnite v popředí, neběží žádná hra a není otevřené žádné sekundární okno Aniki. Jakýkoli vstup jej okamžitě zavře.</sys:String>
    <sys:String x:Key="ScreenSaver_IdleDelay_Title">Spustit po nečinnosti</sys:String>
    <sys:String x:Key="ScreenSaver_ChangeInterval_Title">Měnit hru každých</sys:String>
    <sys:String x:Key="ScreenSaver_Source_Title">Zdroj her</sys:String>
    <sys:String x:Key="ScreenSaver_Source_Help">Vyberte, která část knihovny Playnite se má používat. Skryté hry jsou vždy vyloučeny.</sys:String>
    <sys:String x:Key="ScreenSaver_Source_AllGames">Všechny hry</sys:String>
    <sys:String x:Key="ScreenSaver_Source_InstalledGames">Nainstalované hry</sys:String>
