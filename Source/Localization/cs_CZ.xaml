    <sys:String x:Key="EventSounds_Desc">Přehrává zvukové efekty při událostech, jako je spuštění hry, start/ukončení Playnite a aktualizace knihovny. Používá zvuky obsažené v motivu.</sys:String>
    <sys:String x:Key="EventSounds_Enable">Povolit zvuky událostí</sys:String>
    <sys:String x:Key="EventSounds_Help">Pokud je povoleno, vypněte zvuky UI/událostí v pluginu PlayniteSounds, abyste zabránili duplicitnímu zvuku.</sys:String>

    <!-- ========= GameOverlay FEATURES ========= -->
    <sys:String x:Key="KeyboardMouse_Tab">Klávesnice a myš</sys:String>
    <sys:String x:Key="KeyboardMouse_Intro">Používejte virtuální klávesnici a ovládejte myš ve Windows přímo ovladačem. Tyto funkce fungují nezávisle na herním překryvu a zůstávají dostupné po celou dobu běhu Playnite Fullscreen.</sys:String>
    <sys:String x:Key="InGameOverlay_Tab">Překryv ve hře</sys:String>
    <sys:String x:Key="InGameOverlay_Title">Překryv ve hře</sys:String>
    <sys:String x:Key="InGameOverlay_Desc">Zobrazí panel rychlých akcí Aniki nad aktuální hrou.</sys:String>

    <sys:String x:Key="InGameOverlay_Settings_Title">Nastavení překryvu</sys:String>
    <sys:String x:Key="InGameOverlay_Settings_Desc">Nastavte herní překryv Aniki a jeho klávesovou zkratku.</sys:String>

    <sys:String x:Key="InGameOverlay_Enable">Zapnout překryv ve hře</sys:String>
    <sys:String x:Key="InGameOverlay_Enable_Help">Zobrazí překryv rychlých akcí nad aktuální hrou.</sys:String>

    <sys:String x:Key="InGameOverlay_Hotkey_Title">Zkratka překryvu</sys:String>
    <sys:String x:Key="InGameOverlay_Hotkey_Help">Vyberte klávesovou zkratku pro otevření překryvu ve hře. Po změně tohoto nastavení restartujte Playnite.</sys:String>

    <sys:String x:Key="InGameOverlay_ControllerShortcut_Title">Zkratka ovladače</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Help">Vyberte zkratku ovladače pro otevření překryvu ve hře. Podpora tlačítka Guide je experimentální a může ji zachytit Steam, Windows nebo nástroje ovladače.</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_StartBack">Start + Back</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_BackY">Back + Y</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Guide">Tlačítko Guide</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Disabled">Vypnuto</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Title">Virtuální klávesnice</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Desc">Vyberte virtuální klávesnici používanou Aniki Helperem. Během běhu Playnite Fullscreen ji lze otevřít tlačítkem v překryvu nebo přímou zkratkou na ovladači.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Title">Poskytovatel klávesnice</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Aniki">Klávesnice Aniki</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Windows">Klávesnice Windows</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Help">Klávesnice Windows používá naposledy zvolené rozložení ve Windows. V jejím nastavení jednou vyberte rozložení Gamepad. Dostupnost závisí na verzi Windows.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Title">Přímá zkratka</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_L3R3Hold">Podržet LS + RS (výchozí)</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_BackX">Back / Select / View + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_GuideX">Guide + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Disabled">Vypnuto</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Help">Podržte LS + RS po dobu 600 ms. Kombinaci Guide + X může zachytit Steam, Xbox Game Bar, Windows nebo nástroje pro ovladače.</sys:String>

    <sys:String x:Key="InGameOverlay_GamepadMouse_Title">Myš ovládaná gamepadem</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouse_Desc">Používejte ovladač jako myš ve Windows, když běží Playnite Fullscreen. Pravá páčka pohybuje kurzorem, levá rychle posouvá, A je levé kliknutí, X pravé kliknutí a LT / RT slouží k přesnému posouvání.</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Title">Aktivační zkratka</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_BackR3">Podržet Back + RS (výchozí)</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_StartL3">Podržet Start + LS</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_GuideY">Podržet Guide + Y</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Disabled">Vypnuto</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Help">Podržte vybranou zkratku 600 ms pro zapnutí nebo vypnutí myši ovládané gamepadem. Při pohybu pravou páčkou můžete držet A pro přetažení. Kombinaci Guide + Y může zachytit Steam, Xbox Game Bar, Windows nebo nástroje pro ovladače.</sys:String>
    <sys:String x:Key="LOCGamepadMouseEnabledToast">Myš ovládaná gamepadem zapnuta</sys:String>
    <sys:String x:Key="LOCGamepadMouseDisabledToast">Myš ovládaná gamepadem vypnuta</sys:String>

    <sys:String x:Key="InGameOverlay_GameBehavior_Title">Chování hry při otevřeném překryvu</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_DoNothing">Výchozí: Nedělat nic</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_SuspendGame">Pozastavit hru při otevřeném překryvu</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_Help">Zvolte, zda má Aniki Helper nechat hru běžet normálně, nebo při otevřeném překryvu dočasně pozastavit její proces, aby se zabránilo dvojím vstupům.</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_Warning">Upozornění: nedoporučuje se pro online a multiplayer hry, hry chráněné anti-cheatem ani hry spuštěné jako správce.</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Title">Hry nikdy nepozastavovat</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Help">Hry přidané přes pravé tlačítko → Aniki Helper → Nastavení překryvu → Nikdy nepozastavovat tuto hru se zobrazí zde. Zrušením zaškrtnutí hru ze seznamu odeberete.</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Clear">Vymazat seznam nikdy nepozastavovat</sys:String>
    <sys:String x:Key="LOCAnikiHelperOverlayNeverSuspendThisGame">Nikdy nepozastavovat tuto hru</sys:String>
    <sys:String x:Key="LOCAnikiHelperOverlayAllowSuspendThisGame">Povolit pozastavení této hry</sys:String>

    <sys:String x:Key="InGameOverlay_Limitations_Title">Omezení</sys:String>
    <sys:String x:Key="InGameOverlay_Limitations_Desc">Tento překryv je průhledné okno zobrazené nad hrou. Není vložen přímo do hry jako překryvy Steamu nebo Discordu.</sys:String>
    <sys:String x:Key="InGameOverlay_Limitations_Help">Nejlépe funguje s hrami v bezokrajovém režimu nebo v režimu celé obrazovky v okně. Některé hry v exkluzivním fullscreen režimu, anti-cheat systémy nebo hry spuštěné s vyššími oprávněními mohou správnému zobrazení překryvu zabránit.</sys:String>
    <sys:String x:Key="LOCInGameOverlayFooterTitle">Aniki Overlay</sys:String>
    <sys:String x:Key="LOCInGameOverlayNoGameRunning">Není spuštěna žádná hra</sys:String>
