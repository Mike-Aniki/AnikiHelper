    <sys:String x:Key="SteamStore_GroupTitle">Steam obchod</sys:String>
    <sys:String x:Key="SteamStore_GroupDesc">Nastavte, jak se obsah Steam Store zobrazuje v motivu.</sys:String>

    <sys:String x:Key="SteamStore_Language_Title">Jazyk obchodu</sys:String>
    <sys:String x:Key="SteamStore_Language_Desc">Vyberte jazyk používaný pro obsah Steam Store.</sys:String>
    <sys:String x:Key="SteamStore_Language_Label">Jazyk</sys:String>

    <sys:String x:Key="SteamStore_Country_Title">Země obchodu</sys:String>
