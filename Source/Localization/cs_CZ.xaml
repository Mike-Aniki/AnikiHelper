    <sys:String x:Key="HubApps_Title">Funkce a aplikace v Hubu</sys:String>
    <sys:String x:Key="HubApps_Desc">Zobrazte přímo v Hubu až 4 vestavěné funkce Aniki nebo softwarové nástroje Playnite.</sys:String>
