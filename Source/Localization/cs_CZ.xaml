    <sys:String x:Key="LOCAnikiHelperRefreshAchievementCacheForGame">Obnovit vzpomínky pro tuto hru</sys:String>
    <!-- ========= CUSTOM ICONS ========= -->
    <sys:String x:Key="CustomIcons_Title">Vlastní grafické prvky</sys:String>
    <sys:String x:Key="CustomIcons_Desc">Vyberte externí složky pro vlastní ikony filtrů, pozadí filtrů, ikony zdrojů a bannery. Tyto soubory přepíšou výchozí grafiku motivu, aniž by měnily jeho soubory.</sys:String>
    <sys:String x:Key="CustomIcons_FilterFolder">Složka ikon filtrů</sys:String>
    <sys:String x:Key="CustomIcons_FilterBackgroundFolder">Složka pozadí filtrů</sys:String>
    <sys:String x:Key="CustomIcons_SourceFolder">Složka ikon zdrojů</sys:String>
    <sys:String x:Key="CustomIcons_BannerAboveCoverFolder">Složka bannerů nad obalem</sys:String>
    <sys:String x:Key="CustomIcons_BannerOnCoverFolder">Složka bannerů na obalu</sys:String>
    <sys:String x:Key="CustomIcons_Help">Ikony filtrů a zdrojů musí být soubory PNG s přesně stejnými názvy, jaké se zobrazují v Playnite. Pozadí filtrů mohou být JPG, JPEG, PNG, WEBP nebo BMP a musí používat přesný název předvolby filtru, například Installed.jpg nebo Favorites.png. Pokud neexistuje přesná shoda, použije se obrázek Default. Pro bannery nad obalem a na obalu používejte samostatné složky.</sys:String>
    <sys:String x:Key="BrowseFolder">Procházet...</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterFolderDialog">Vyberte složku s PNG ikonami filtrů.</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterBackgroundFolderDialog">Vyberte složku s obrázky pozadí filtrů.</sys:String>
    <sys:String x:Key="CustomIcons_SelectSourceFolderDialog">Vyberte složku s PNG ikonami zdrojů.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerAboveCoverFolderDialog">Vyberte složku s PNG bannery zobrazovanými nad obalem.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerOnCoverFolderDialog">Vyberte složku s PNG bannery zobrazovanými na obalu.</sys:String>

