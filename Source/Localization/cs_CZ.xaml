    <!-- ========= SPLASH FEATURES ========= -->
    <sys:String x:Key="SplashScreen">Úvodní obrazovka</sys:String>
    <sys:String x:Key="GameLaunchSplash_Title">Obrazovka spuštění hry</sys:String>
    <sys:String x:Key="GameLaunchSplash_Desc">Při spuštění hry zobrazí obrázek nebo video. Vlastní úvodní obrazovky můžete spravovat z nabídky po kliknutí pravým tlačítkem na hru.</sys:String>
    <sys:String x:Key="GameLaunchSplash_Enable">Povolit úvodní obrazovku při spuštění hry</sys:String>
    <sys:String x:Key="GameLaunchSplash_Help">Vypněte tuto možnost, pokud chcete spouštět hry bez úvodní obrazovky.</sys:String>

    <sys:String x:Key="LOCAnikiHelperSetCustomSplashImage">Nastavit obrázek úvodní obrazovky</sys:String>
    <sys:String x:Key="LOCAnikiHelperReplaceCustomSplashImage">Změnit obrázek úvodní obrazovky</sys:String>
