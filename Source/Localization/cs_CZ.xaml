    <!-- ========= STEAM FEATURES ========= -->
    <sys:String x:Key="GroupSteamFeatures">Funkce Steamu</sys:String>

    <!-- Steam updates -->
    <sys:String x:Key="SteamUpdates_GroupTitle">Aktualizace Steamu</sys:String>
    <sys:String x:Key="SteamUpdates_GroupDesc">Je-li zapnuto, plugin kontroluje aktualizace her přímo ze Steamu. Motiv tak může zobrazovat nové i starší záznamy o aktualizacích.</sys:String>

    <sys:String x:Key="SteamUpdates_Title">Aktualizace her</sys:String>
    <sys:String x:Key="SteamUpdates_Desc">Kontroluje, zda vaše hry na Steamu mají nedávné aktualizace.</sys:String>
    <sys:String x:Key="SteamUpdates_Enable">Povolit kontrolu aktualizací</sys:String>
    <sys:String x:Key="SteamUpdates_Enable_Help">Úplně zapne nebo vypne kontrolu aktualizací.</sys:String>

    <!-- Update data -->
    <sys:String x:Key="SteamInitCache_ProgressTitle">Data aktualizací</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressDesc">Plugin kontroluje aktualizace her na Steamu při procházení knihovny. Můžete spustit úplné prohledání knihovny a předem připravit data aktualizací pro všechny hry, místo abyste čekali, až je postupně otevřete. Pomáhá to omezit falešná upozornění na aktualizace a zlepšuje výkon při procházení.</sys:String>
    <sys:String x:Key="SteamInitCache">Prohledat knihovnu</sys:String>
    <sys:String x:Key="SteamInitCache_Tooltip">Prohledá vaše hry na Steamu a připraví data aktualizací.</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressNote">Prohledání knihovny se doporučuje kvůli omezení falešných upozornění a zlepšení výkonu.</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressText">Prohledávání… {0}/{1}</sys:String>
