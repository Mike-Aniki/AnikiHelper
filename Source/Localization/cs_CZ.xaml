    <sys:String x:Key="SettingsReset_SectionTitle">Obnovit výchozí nastavení</sys:String>
    <sys:String x:Key="SettingsReset_Description">Obnoví všechny možnosti Aniki Helperu na původní výchozí hodnoty.</sys:String>
    <sys:String x:Key="SettingsReset_ScopeNote">Připojené účty, oblíbené v prohlížeči, historie videí a údaje pro pokračování, záznamy, data jednotlivých her, mezipaměti a konfigurace motivu zůstanou zachovány.</sys:String>
    <sys:String x:Key="SettingsReset_Button">Obnovit výchozí nastavení</sys:String>
    <sys:String x:Key="SettingsReset_Tooltip">Obnoví možnosti Aniki Helperu na výchozí hodnoty.</sys:String>
    <sys:String x:Key="SettingsReset_Confirm">Obnovit všechny možnosti Aniki Helperu na výchozí hodnoty? Aktuální volby budou přepsány, ale připojené účty a osobní data zůstanou zachovány.</sys:String>
    <sys:String x:Key="SettingsReset_Success">Možnosti Aniki Helperu byly obnoveny na výchozí hodnoty.</sys:String>
    <sys:String x:Key="SettingsReset_Error">Výchozí nastavení se nepodařilo obnovit.</sys:String>

    <sys:String x:Key="VideoPlayer_NetworkLocations">Síťová umístění</sys:String>
    <sys:String x:Key="VideoPlayer_NetworkFolders">Síťové složky</sys:String>
    <sys:String x:Key="VideoPlayer_NetworkLocationsSubtitle">Nastavené síťové složky</sys:String>
    <sys:String x:Key="VideoPlayer_NetworkEmpty">Nejsou nastavena žádná síťová umístění. Přidejte je v Aniki Helper &gt; Exkluzivní funkce &gt; Aniki Media Center.</sys:String>
    <sys:String x:Key="VideoPlayer_NetworkUnavailable">Nedostupné</sys:String>
    <sys:String x:Key="VideoPlayer_NetworkMediaUnavailableRetry">Síťové umístění není dostupné nebo se probouzí. Zkuste to znovu za chvíli.</sys:String>
    <sys:String x:Key="VideoPlayer_MediaUnavailableRetry">Médium není dostupné. Zkuste to znovu za chvíli.</sys:String>
    <sys:String x:Key="VideoPlayer_NetworkError">Nastavená síťová umístění se nepodařilo ověřit.</sys:String>
    <sys:String x:Key="VideoPlayer_Network">SÍŤ</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_Title">Online grafika</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_TmdbConfigHelp">Je-li nastaven token, TMDB je upřednostněn pro filmy, seriály a anime. Níže přidejte svůj TMDB API Read Access Token a povolte lokalizovanou grafiku.</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_TmdbConfigTitle">TMDB GRAFIKA — FILMY A SERIÁLY</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_EnableHelp">Místní grafika má vždy přednost. S tokenem TMDB zkoušejí filmy a seriály nejprve TMDB; TVMaze a AniList zůstávají automatickými alternativami bez klíče.</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_Enable">Zapnout online grafiku</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_Desc">Automaticky načte grafiku, pokud není dostupný místní obrázek. Aniki vhodného poskytovatele vybere automaticky.</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_MoviesTitle">FILMY — TMDB</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_SeriesTitle">TV SERIÁLY — TMDB / TVMAZE</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_AnimeTitle">ANIME — TMDB / ANILIST</sys:String>
    <sys:String x:Key="VideoTvmaze_Enable">Zapnout TVmaze scraper pro seriály</sys:String>
    <sys:String x:Key="VideoTvmaze_Help">API klíč není potřeba. TVmaze se používá jako záložní zdroj pro seriály, když TMDB není dostupné nebo nenajde spolehlivou shodu.</sys:String>
    <sys:String x:Key="VideoAnilist_Enable">Zapnout AniList scraper pro anime</sys:String>
    <sys:String x:Key="VideoAnilist_Help">API klíč není potřeba. AniList je specializovaný záložní zdroj pro anime, když TMDB není dostupné nebo nenajde spolehlivou shodu, a zůstává dostupný ve výběru grafiky.</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_AutoRoutingHelp">Automatické směrování s tokenem TMDB: film → TMDB; seriál → TMDB a poté TVMaze; anime → TMDB a poté AniList/TVMaze. Bez tokenu zůstávají TVMaze a AniList automaticky dostupné.</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_Attribution">Token TMDB je pro seriály a anime volitelný: nastaví TMDB jako preferovaného poskytovatele. TVMaze a AniList zůstávají dostupné bez klíče.</sys:String>
    <sys:String x:Key="VideoTvmaze_StatusReady">TVmaze scraper: Připraven</sys:String>
    <sys:String x:Key="VideoTvmaze_StatusDisabled">TVmaze scraper: Vypnut</sys:String>
    <sys:String x:Key="VideoAnilist_StatusReady">AniList scraper: Připraven</sys:String>
    <sys:String x:Key="VideoAnilist_StatusDisabled">AniList scraper: Vypnut</sys:String>

    <sys:String x:Key="VideoTmdb_Title">TMDB scraper grafiky</sys:String>
    <sys:String x:Key="VideoTmdb_Desc">Automaticky načte z TMDB obal, širokoúhlý obrázek, tapetu a logo pro filmy, seriály a anime, pokud nejsou dostupné místní obrázky.</sys:String>
    <sys:String x:Key="VideoTmdb_Enable">Povolit načítání obrázků z TMDB</sys:String>
    <sys:String x:Key="VideoTmdb_EnableHelp">Místní obrázky uložené vedle média mají vždy přednost. TMDB se použije pouze tehdy, když místní obrázky nejsou dostupné.</sys:String>
    <sys:String x:Key="VideoTmdb_Language">Preferovaný jazyk obrázků</sys:String>
    <sys:String x:Key="VideoTmdb_LanguageAuto">Použít jazyk Playnite</sys:String>
    <sys:String x:Key="VideoTmdb_LanguageHelp">U obrázků s textem se upřednostní tento jazyk, potom obrázky bez textu, původní jazyk média a angličtina. U tapet se upřednostňují obrázky bez textu.</sys:String>
    <sys:String x:Key="VideoTmdb_Token">TMDB API Read Access Token</sys:String>
    <sys:String x:Key="VideoTmdb_TokenHelp">V nastavení účtu TMDB si vytvořte bezplatný vývojářský API Read Access Token. Token je uložen místně a zašifrován pomocí Windows DPAPI.</sys:String>
    <sys:String x:Key="VideoTmdb_MatchingHelp">V2 čistí názvy vydání (značky kvality, kodeku, jazyka, zdroje a release group), samostatně získá rok, zkouší chytré varianty názvu a před přijetím vyhodnotí shodu názvu a roku.</sys:String>
    <sys:String x:Key="VideoTmdb_PrivacyHelp">Když je potřeba vyhledávání v TMDB, Aniki odešle pouze vyčištěný název média a rozpoznaný rok. Místní ani síťové cesty se nikdy neposílají do TMDB ani neukládají jako prostý text do indexů obrázků.</sys:String>
    <sys:String x:Key="VideoTmdb_Attribution">Tento produkt používá API TMDB, ale společnost TMDB jej neschválila ani necertifikovala.</sys:String>
    <sys:String x:Key="VideoTmdb_StatusDisabled">Obrázky TMDB: Vypnuto</sys:String>
    <sys:String x:Key="VideoTmdb_StatusTokenMissing">Obrázky TMDB: Chybí API token</sys:String>
    <sys:String x:Key="VideoTmdb_StatusReady">Obrázky TMDB: Připraveno</sys:String>

    <sys:String x:Key="VideoNetwork_Title">Síťová umístění</sys:String>
    <sys:String x:Key="VideoNetwork_Desc">Nastavte až 4 síťové složky, které se zobrazí v části Síťová umístění v Aniki Media Center.</sys:String>
    <sys:String x:Key="VideoNetwork_Help">Použijte cestu UNC, například \\NAS\Movies, nebo zvolte Procházet. Windows už musí mít přístup k chráněným sdíleným složkám; Aniki Helper nikdy neukládá síťové přihlašovací údaje.</sys:String>
    <sys:String x:Key="VideoNetwork_Slot">Pozice</sys:String>
    <sys:String x:Key="VideoNetwork_Name">Název</sys:String>
    <sys:String x:Key="VideoNetwork_Path">Síťová cesta</sys:String>
    <sys:String x:Key="VideoNetwork_Browse">Procházet</sys:String>
    <sys:String x:Key="VideoNetwork_Clear">Vymazat</sys:String>
    <sys:String x:Key="VideoNetwork_BrowseTitle">Vyberte síťovou složku</sys:String>
    <sys:String x:Key="VideoThumbnail_Title">Nástroje médií</sys:String>
    <sys:String x:Key="VideoThumbnail_Desc">Nastavte externí nástroje médií, které Aniki Media Center používá pro miniatury a funkce Další se zohledněním kapitol.</sys:String>
    <sys:String x:Key="VideoThumbnail_Help">FFmpeg vytváří miniatury přibližně v 10 % délky každého videa. FFprobe čte názvy kapitol pro funkce Další a Přeskočit intro/rekapitulaci. Pokud některý nástroj není dostupný, obě funkce automaticky použijí náhradní režim.</sys:String>
    <sys:String x:Key="VideoThumbnail_Browse">Procházet</sys:String>
    <sys:String x:Key="VideoThumbnail_Clear">Vymazat</sys:String>
    <sys:String x:Key="VideoThumbnail_BrowseTitle">Vyberte ffmpeg.exe</sys:String>
    <sys:String x:Key="VideoThumbnail_FfmpegLabel">Cesta k FFmpeg — miniatury</sys:String>
    <sys:String x:Key="VideoFfprobe_Label">Cesta k FFprobe — rozpoznání kapitol</sys:String>
    <sys:String x:Key="VideoFfprobe_Help">Soubor ffprobe.exe je obvykle ve stejné složce jako ffmpeg.exe. Aniki ho tam podle možností automaticky rozpozná, ale můžete ručně vybrat jiný soubor.</sys:String>
    <sys:String x:Key="VideoFfprobe_BrowseTitle">Vyberte ffprobe.exe</sys:String>
    <sys:String x:Key="VideoFfprobe_StatusReady">FFprobe: Připraveno</sys:String>
    <sys:String x:Key="VideoFfprobe_StatusAuto">FFprobe: Připraveno (automaticky rozpoznáno)</sys:String>
    <sys:String x:Key="VideoFfprobe_StatusMissing">FFprobe: Soubor nenalezen</sys:String>
    <sys:String x:Key="VideoFfprobe_StatusNotConfigured">FFprobe: Nenastaveno</sys:String>
    <sys:String x:Key="VideoPlayback_Title">Přehrávání</sys:String>
    <sys:String x:Key="VideoPlayback_Desc">Nastavte chování Aniki Media Center během přehrávání.</sys:String>
    <sys:String x:Key="VideoPlayback_AutoNext">Automaticky přehrát další video</sys:String>
    <sys:String x:Key="VideoPlayback_AutoNextHelp">Funkce Další se zobrazí vždy, když existuje další video. S FFprobe se může objevit u rozpoznané kapitoly s titulky nebo koncem; jinak se zobrazí v posledních sekundách. Je-li automatické přehrávání zapnuté, rozpoznaná závěrečná kapitola spustí krátké odpočítávání před dalším videem.</sys:String>
    <sys:String x:Key="VideoPlayback_AudioLanguage">Preferovaný jazyk zvuku</sys:String>
    <sys:String x:Key="VideoPlayback_AudioLanguageHelp">Vyberte jazyk, kterému má Aniki dát přednost, pokud je dostupná odpovídající zvuková stopa.</sys:String>
    <sys:String x:Key="VideoPlayback_SubtitleMode">Titulky</sys:String>
    <sys:String x:Key="VideoPlayback_SubtitleDefault">Použít výchozí nastavení videa</sys:String>
    <sys:String x:Key="VideoPlayback_SubtitleOff">Vždy vypnuto</sys:String>
    <sys:String x:Key="VideoPlayback_SubtitlePreferred">Preferovaný jazyk, je-li dostupný</sys:String>
    <sys:String x:Key="VideoPlayback_SubtitleLanguage">Preferovaný jazyk titulků</sys:String>
    <sys:String x:Key="VideoPlayback_SubtitleLanguageHelp">Používá se pouze s volbou Preferovaný jazyk. Vyberte jazyk titulků, kterému má Aniki dát přednost, pokud je dostupná odpovídající stopa.</sys:String>
