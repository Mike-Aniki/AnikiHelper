    <sys:String x:Key="InitSteamCacheDoneMsg">Prohledávání dokončeno.</sys:String>

    <!-- Current players -->
    <sys:String x:Key="SteamPlayers_GroupTitle">Aktuální hráči</sys:String>
    <sys:String x:Key="SteamPlayers_GroupDesc">Zobrazuje živý počet hráčů u podporovaných her na Steamu.</sys:String>

