    <sys:String x:Key="CustomIcons_SelectSourceFolderDialog">PNG kaynak simgelerini içeren klasörü seçin.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerAboveCoverFolderDialog">Kapağın üstünde gösterilen PNG banner görsellerinin bulunduğu klasörü seçin.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerOnCoverFolderDialog">Kapağın üzerinde gösterilen PNG banner görsellerinin bulunduğu klasörü seçin.</sys:String>

