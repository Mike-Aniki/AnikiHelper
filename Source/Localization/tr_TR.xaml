    <sys:String x:Key="EventSounds_Desc">Oyun başlatma, Playnite'ı açma/kapatma ve kitaplık güncellemeleri gibi olaylarda ses efektleri çalar. Temaya dahil seslerle çalışır.</sys:String>
    <sys:String x:Key="EventSounds_Enable">Etkinlik seslerini etkinleştir</sys:String>
    <sys:String x:Key="EventSounds_Help">Etkinse, çift ses oluşmasını önlemek için PlayniteSounds eklentisindeki arayüz/etkinlik seslerini devre dışı bırakın.</sys:String>

    <!-- ========= GameOverlay FEATURES ========= -->
    <sys:String x:Key="KeyboardMouse_Tab">Klavye ve Fare</sys:String>
    <sys:String x:Key="KeyboardMouse_Intro">Sanal klavyeyi kullanın ve Windows faresini doğrudan kontrolcünüzle yönetin. Bu özellikler oyun içi kaplamadan bağımsız çalışır ve Playnite Tam Ekran açıkken kullanılabilir.</sys:String>
    <sys:String x:Key="InGameOverlay_Tab">Oyun İçi Kaplama</sys:String>
    <sys:String x:Key="InGameOverlay_Title">Oyun İçi Kaplama</sys:String>
    <sys:String x:Key="InGameOverlay_Desc">Geçerli oyunun üzerinde Aniki hızlı eylem panelini gösterir.</sys:String>

    <sys:String x:Key="InGameOverlay_Settings_Title">Kaplama ayarları</sys:String>
    <sys:String x:Key="InGameOverlay_Settings_Desc">Aniki oyun içi kaplamasını ve klavye kısayolunu yapılandırın.</sys:String>

    <sys:String x:Key="InGameOverlay_Enable">Oyun içi kaplamayı etkinleştir</sys:String>
    <sys:String x:Key="InGameOverlay_Enable_Help">Geçerli oyunun üzerinde hızlı eylem kaplaması gösterir.</sys:String>

    <sys:String x:Key="InGameOverlay_Hotkey_Title">Kaplama kısayolu</sys:String>
    <sys:String x:Key="InGameOverlay_Hotkey_Help">Oyun içi kaplamayı açmak için kullanılacak klavye kısayolunu seçin. Bu ayarı değiştirdikten sonra Playnite’ı yeniden başlatın.</sys:String>

    <sys:String x:Key="InGameOverlay_ControllerShortcut_Title">Kontrolcü kısayolu</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Help">Oyun içi kaplamayı açmak için kullanılacak kontrolcü kısayolunu seçin. Guide düğmesi desteği deneyseldir ve Steam, Windows veya kontrolcü araçları tarafından yakalanabilir.</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_StartBack">Start + Back</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_BackY">Back + Y</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Guide">Guide düğmesi</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Disabled">Devre dışı</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Title">Sanal klavye</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Desc">Aniki Helper'ın kullanacağı sanal klavyeyi seçin. Playnite Tam Ekran çalışırken kaplama düğmesinden veya doğrudan kontrolcü kısayoluyla açılabilir.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Title">Klavye sağlayıcısı</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Aniki">Aniki Klavyesi</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Windows">Windows Klavyesi</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Help">Windows klavyesi, Windows'ta en son seçilen düzeni kullanır. Ayarlarından Gamepad düzenini bir kez seçin. Kullanılabilirlik Windows sürümüne bağlıdır.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Title">Doğrudan kısayol</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_L3R3Hold">LS + RS basılı tut (varsayılan)</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_BackX">Back / Select / View + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_GuideX">Guide + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Disabled">Devre dışı</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Help">LS + RS'yi 600 ms basılı tutun. Guide + X; Steam, Xbox Game Bar, Windows veya kontrolcü araçları tarafından yakalanabilir.</sys:String>

    <sys:String x:Key="InGameOverlay_GamepadMouse_Title">Gamepad Faresi</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouse_Desc">Playnite Tam Ekran çalışırken kontrolcüyü Windows faresi olarak kullanın. Sağ çubuk imleci hareket ettirir, sol çubuk hızlı kaydırır, A sol tık, X sağ tık, LT / RT ise hassas kaydırma sağlar.</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Title">Etkinleştirme kısayolu</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_BackR3">Back + RS basılı tut (varsayılan)</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_StartL3">Start + LS basılı tut</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_GuideY">Guide + Y basılı tut</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Disabled">Devre dışı</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Help">Gamepad Faresini açmak veya kapatmak için seçilen kısayolu 600 ms basılı tutun. Sürükle-bırak için sağ çubuğu hareket ettirirken A'yı basılı tutabilirsiniz. Guide + Y; Steam, Xbox Game Bar, Windows veya kontrolcü araçları tarafından yakalanabilir.</sys:String>
    <sys:String x:Key="LOCGamepadMouseEnabledToast">Gamepad Faresi etkin</sys:String>
    <sys:String x:Key="LOCGamepadMouseDisabledToast">Gamepad Faresi devre dışı</sys:String>

    <sys:String x:Key="InGameOverlay_GameBehavior_Title">Kaplama açıkken oyun davranışı</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_DoNothing">Varsayılan: Hiçbir şey yapma</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_SuspendGame">Kaplama açıkken oyunu askıya al</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_Help">Kaplama açıkken çift girişleri önlemek için Aniki Helper'ın oyunu normal şekilde çalışır bırakmasını mı yoksa oyun işlemini geçici olarak dondurmasını mı istediğinizi seçin.</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_Warning">Uyarı: çevrimiçi oyunlar, çok oyunculu oyunlar, anti-cheat korumalı oyunlar veya yönetici olarak çalıştırılan oyunlar için önerilmez.</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Title">Asla askıya alınmayacak oyunlar</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Help">Sağ tık → Aniki Helper → Kaplama Ayarları → Bu oyunu asla askıya alma yoluyla eklenen oyunlar burada görünür. Listeden kaldırmak için oyunun işaretini kaldırın.</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Clear">Asla askıya alma listesini temizle</sys:String>
    <sys:String x:Key="LOCAnikiHelperOverlayNeverSuspendThisGame">Bu oyunu asla askıya alma</sys:String>
    <sys:String x:Key="LOCAnikiHelperOverlayAllowSuspendThisGame">Bu oyunun askıya alınmasına izin ver</sys:String>

    <sys:String x:Key="InGameOverlay_Limitations_Title">Sınırlamalar</sys:String>
    <sys:String x:Key="InGameOverlay_Limitations_Desc">Bu kaplama, oyunun üzerinde gösterilen şeffaf bir penceredir. Steam veya Discord kaplamaları gibi doğrudan oyuna enjekte edilmez.</sys:String>
    <sys:String x:Key="InGameOverlay_Limitations_Help">Kenarlıksız veya pencereli tam ekran oyunlarda en iyi sonucu verir. Bazı özel tam ekran oyunlar, anti-cheat sistemleri veya yükseltilmiş yetkilerle çalışan oyunlar kaplamanın doğru görünmesini engelleyebilir.</sys:String>
