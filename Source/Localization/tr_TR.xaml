    <!-- ========= CUSTOM ICONS ========= -->
    <sys:String x:Key="CustomIcons_Title">Özel görsel öğeler</sys:String>
    <sys:String x:Key="CustomIcons_Desc">Özel filtre simgeleri, filtre arka planları, kaynak simgeleri ve banner görselleri için harici klasörler seçin. Bu dosyalar tema dosyalarını değiştirmeden varsayılan görsellerin yerine kullanılır.</sys:String>
    <sys:String x:Key="CustomIcons_FilterFolder">Filtre simgeleri klasörü</sys:String>
    <sys:String x:Key="CustomIcons_FilterBackgroundFolder">Filtre arka planları klasörü</sys:String>
    <sys:String x:Key="CustomIcons_SourceFolder">Kaynak simgeleri klasörü</sys:String>
    <sys:String x:Key="CustomIcons_BannerAboveCoverFolder">Kapak üstü banner klasörü</sys:String>
    <sys:String x:Key="CustomIcons_BannerOnCoverFolder">Kapak üzeri banner klasörü</sys:String>
    <sys:String x:Key="CustomIcons_Help">Filtre ve kaynak simgeleri, Playnite'ta görünen adlarla birebir aynı ada sahip PNG dosyaları olmalıdır. Filtre arka planları JPG, JPEG, PNG, WEBP veya BMP olabilir ve filtre ön ayarının tam adını kullanmalıdır; örneğin Installed.jpg veya Favorites.png. Tam eşleşme yoksa Default adlı görsel kullanılır. Kapak üstü ve kapak üzeri banner'lar için ayrı klasörler kullanın.</sys:String>
    <sys:String x:Key="BrowseFolder">Göz at...</sys:String>
