    <sys:String x:Key="VideoThumbnail_BrowseTitle">ffmpeg.exe dosyasını seçin</sys:String>
    <sys:String x:Key="VideoThumbnail_FfmpegLabel">FFmpeg yolu — küçük resimler</sys:String>
    <sys:String x:Key="VideoFfprobe_Label">FFprobe yolu — bölüm algılama</sys:String>
    <sys:String x:Key="VideoFfprobe_Help">ffprobe.exe genellikle ffmpeg.exe ile aynı klasördedir. Aniki mümkün olduğunda onu otomatik olarak algılar; isterseniz farklı bir dosyayı elle seçebilirsiniz.</sys:String>
    <sys:String x:Key="VideoFfprobe_BrowseTitle">ffprobe.exe dosyasını seçin</sys:String>
