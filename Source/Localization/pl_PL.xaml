    <!-- ========= MEDIA GALLERY ========= -->

    <sys:String x:Key="MediaGallery_Title">Galeria zrzutów</sys:String>
    <sys:String x:Key="MediaGallery_Desc">Aniki Helper pobiera media ze Screenshots Visualizer i Screenshot Utilities. Skonfiguruj foldery zrzutów ekranu w tych wtyczkach; Aniki Helper odczytuje tylko ich dane i generuje miniatury, aby przyspieszyć nawigację w motywie.</sys:String>

    <sys:String x:Key="MediaGallery_Provider_Title">Wtyczka zrzutów ekranu</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Visualizer">Screenshots Visualizer</sys:String>
    <sys:String x:Key="MediaGallery_Provider_UtilitiesLocal">Screenshot Utilities - Local</sys:String>
    <sys:String x:Key="MediaGallery_Provider_Help">Motyw użyje listy mediów Aniki Helper zamiast wiązać się bezpośrednio z wybraną wtyczką zrzutów ekranu.</sys:String>

    <sys:String x:Key="MediaGallery_GenerateThumbnails">Miniatury mediów</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Button">Wygeneruj miniatury</sys:String>
    <sys:String x:Key="MediaGallery_GenerateThumbnails_Help">Wstępnie generuje miniatury dla wszystkich obrazów z wtyczek zrzutów ekranu. Pierwsze generowanie może chwilę potrwać, ale kolejne uruchomienia powinny być szybsze.</sys:String>

    <sys:String x:Key="MediaGallery_Status_WindowTitle">Wygeneruj miniatury</sys:String>
    <sys:String x:Key="MediaGallery_Status_Scanning">Skanowanie plików mediów...</sys:String>
    <sys:String x:Key="MediaGallery_Status_Progress_Detailed">Generowanie miniatur... przeskanowano {0}/{1}, dodano {2}.</sys:String>
    <sys:String x:Key="MediaGallery_Status_Done_Detailed">Wygenerowano miniatury: dodano {0} / przeskanowano {1} ({2} już w pamięci podręcznej, {3} nie powiodło się).</sys:String>
