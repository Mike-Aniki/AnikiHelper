    <sys:String x:Key="ScreenSaver_UseFadeTransitions">Używaj przejść z zanikaniem między grami</sys:String>
    <sys:String x:Key="ScreenSaver_Preview">Podgląd wygaszacza ekranu</sys:String>
    <sys:String x:Key="ScreenSaver_Preview_Help">Podgląd otwiera się natychmiast. Naciśnij dowolny klawisz, mysz lub przycisk pada, aby go zamknąć.</sys:String>
