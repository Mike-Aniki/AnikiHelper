    <sys:String x:Key="LOCInGameOverlayMediaFutureHint">Ten panel może później obsługiwać sterowanie UPS / Spotify bez dotykania logiki okna nakładki.</sys:String>

    <!-- ========= SPLASH FEATURES ========= -->
    <sys:String x:Key="SplashScreen">Ekran powitalny</sys:String>
    <sys:String x:Key="GameLaunchSplash_Title">Ekran uruchamiania gry</sys:String>
    <sys:String x:Key="GameLaunchSplash_Desc">Wyświetla obraz lub wideo podczas uruchamiania gry. Możesz zarządzać niestandardowymi ekranami powitalnymi z menu kontekstowego (kliknięcie prawym przyciskiem myszy) dla gry.</sys:String>
    <sys:String x:Key="GameLaunchSplash_Enable">Włącz ekran powitalny gry</sys:String>
    <sys:String x:Key="GameLaunchSplash_Help">Wyłącz tę opcję, jeśli chcesz, aby gry uruchamiały się bez ekranu powitalnego.</sys:String>

    <sys:String x:Key="LOCAnikiHelperSetCustomSplashImage">Ustaw obraz powitalny</sys:String>
    <sys:String x:Key="LOCAnikiHelperReplaceCustomSplashImage">Zmień obraz powitalny</sys:String>
    <sys:String x:Key="LOCAnikiHelperPreviewCustomSplashImage">Podgląd obrazu powitalnego</sys:String>
    <sys:String x:Key="LOCAnikiHelperRemoveCustomSplashImage">Usuń obraz powitalny</sys:String>
    <sys:String x:Key="LOCAnikiHelperOpenCustomSplashFolder">Otwórz folder obrazów powitalnych</sys:String>

    <sys:String x:Key="LOCAnikiHelperChooseSplashImageForGame">Wybierz obraz powitalny dla {0}</sys:String>
    <sys:String x:Key="LOCAnikiHelperNoCustomSplashImage">Nie ustawiono niestandardowego obrazu powitalnego dla tej gry.</sys:String>
    <sys:String x:Key="LOCAnikiHelperPreviewTitle">Podgląd obrazu powitalnego</sys:String>

    <sys:String x:Key="LOCAnikiHelperCustomSplashImageSaved">Zapisano obraz powitalny dla:</sys:String>
    <sys:String x:Key="LOCAnikiHelperCustomSplashImageRemoved">Usunięto obraz powitalny dla:</sys:String>
    <sys:String x:Key="LOCAnikiHelperSetCustomSplashImageFailed">Nie udało się ustawić obrazu powitalnego.</sys:String>
    <sys:String x:Key="LOCAnikiHelperRemoveCustomSplashImageFailed">Nie udało się usunąć obrazu powitalnego.</sys:String>
    <sys:String x:Key="LOCAnikiHelperPreviewSplashImageFailed">Nie udało się wyświetlić podglądu obrazu.</sys:String>
    <sys:String x:Key="LOCAnikiHelperOpenCustomSplashFolderFailed">Nie udało się otworzyć folderu obrazów powitalnych.</sys:String>

    <sys:String x:Key="GameLaunchSplash_Mode_Title">Tryb wyboru ekranu powitalnego</sys:String>
    <sys:String x:Key="GameLaunchSplash_Mode_Automatic">Priorytet gry</sys:String>
    <sys:String x:Key="GameLaunchSplash_Mode_CustomPriority">Niestandardowy priorytet</sys:String>
    <sys:String x:Key="GameLaunchSplash_Mode_AlwaysSource">Priorytet źródła</sys:String>
    <sys:String x:Key="GameLaunchSplash_Mode_AlwaysPlatform">Priorytet platformy</sys:String>
    <sys:String x:Key="GameLaunchSplash_Mode_AlwaysGlobal">Tylko ogólny</sys:String>
    <sys:String x:Key="GameLaunchSplash_Mode_Help">Wybierz źródło ekranu powitalnego, które jest sprawdzane jako pierwsze. Tryby priorytetowe przechodzą w razie potrzeby przez pozostałe źródła; opcja „Tylko ogólny” używa wyłącznie ekranu globalnego.</sys:String>
    <sys:String x:Key="LOCAnikiHelperOpenGameSplashFolder">Otwórz folder powitalny gry</sys:String>

    <sys:String x:Key="GameLaunchSplash_LogoPosition_Title">Pozycja logo</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_Help">Wybierz, gdzie logo gry pojawia się na ekranie powitalnym.</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_LeftTop">Lewy górny róg</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_LeftCenter">Lewy środek</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_LeftBottom">Lewy dolny róg</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_CenterTop">Środek góra</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_Center">Środek</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_CenterBottom">Środek dół</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_RightTop">Prawy górny róg</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_RightCenter">Prawy środek</sys:String>
    <sys:String x:Key="GameLaunchSplash_LogoPosition_RightBottom">Prawy dolny róg</sys:String>
    <sys:String x:Key="GameLaunchSplash_ShowLogo">Pokaż logo gry na ekranie powitalnym</sys:String>

    <sys:String x:Key="GameLaunchSplash_GlobalTimers_Title">Czas trwania ekranu powitalnego</sys:String>
    <sys:String x:Key="GameLaunchSplash_GlobalTimers_Help">Ekran powitalny pozostaje widoczny przez co najmniej minimalny czas, a następnie zamyka się automatycznie, gdy tylko właściwe okno gry jest gotowe. Jeśli wykrywanie się nie powiedzie, zostanie zamknięty po ustawionym maksymalnym czasie oczekiwania. Licznik niestandardowy dla pojedynczej gry zastępuje jedynie minimalny czas trwania.</sys:String>
    <sys:String x:Key="GameLaunchSplash_MinDuration_Title">Minimalny czas wyświetlania</sys:String>
    <sys:String x:Key="GameLaunchSplash_MinDuration_Help">Ustawia minimalny czas, przez jaki ekran powitalny pozostaje widoczny. Zwiększ tę wartość, jeśli ekran powitalny znika zbyt szybko.</sys:String>
    <sys:String x:Key="GameLaunchSplash_AutoDetectReady_Enable">Automatycznie wykrywaj, kiedy okno gry jest gotowe</sys:String>
    <sys:String x:Key="GameLaunchSplash_AutoDetectReady_Help">Po włączeniu Aniki Helper utrzymuje ekran powitalny widoczny przez co najmniej skonfigurowany minimalny czas, a następnie zamyka go po wykryciu właściwego okna gry. Niestandardowe timery dla poszczególnych gier zastępują minimalny czas trwania, ale nadal korzystają z automatycznego wykrywania.</sys:String>
    <sys:String x:Key="GameLaunchSplash_MaxDuration_Title">Zegar awaryjnego automatycznego zamknięcia</sys:String>
    <sys:String x:Key="GameLaunchSplash_MaxDuration_Help">Określa, jak długo Aniki Helper czeka na przejęcie fokusu przez grę. Jeśli gra nie pojawi się na pierwszym planie, ekran powitalny zamknie się automatycznie po tym czasie.</sys:String>
    <sys:String x:Key="GameLaunchSplash_DisabledGames_Title">Gry z wyłączonym ekranem startowym</sys:String>
    <sys:String x:Key="GameLaunchSplash_DisabledGames_Help">Gry, dla których wyłączono ekran startowy przez prawy przycisk → Aniki Helper → Splash Screen, pojawiają się tutaj. Odznacz grę, aby ponownie włączyć ekran startowy.</sys:String>
    <sys:String x:Key="GameLaunchSplash_DisabledGames_Clear">Wyczyść listę wyłączonych gier</sys:String>
    <sys:String x:Key="LOCAnikiHelperDisableSplashThisGame">Wyłącz ekran startowy dla tej gry</sys:String>
    <sys:String x:Key="LOCAnikiHelperEnableSplashThisGame">Włącz ekran startowy dla tej gry</sys:String>
    <sys:String x:Key="GameLaunchSplash_ResetTimer">Resetuj</sys:String>

    <sys:String x:Key="LOCAnikiHelperSetGameSplashMinimumTimer">Ustaw minimalny czas dla tej gry</sys:String>
    <sys:String x:Key="LOCAnikiHelperResetGameSplashMinimumTimer">Zresetuj minimalny czas dla tej gry</sys:String>
    <sys:String x:Key="LOCAnikiHelperSetGameSplashMinimumTimerPrompt">Minimalny czas trwania ekranu powitalnego dla tej gry, w sekundach:</sys:String>
    <sys:String x:Key="LOCAnikiHelperSetGameSplashMaximumWait">Set maximum wait for this game</sys:String>
    <sys:String x:Key="LOCAnikiHelperResetGameSplashMaximumWait">Reset maximum wait for this game</sys:String>
    <sys:String x:Key="LOCAnikiHelperSetGameSplashMaximumWaitPrompt">Maximum automatic-detection wait for this game, in seconds:</sys:String>
    <sys:String x:Key="LOCAnikiHelperInvalidTimerValue">Nieprawidłowa wartość czasu.</sys:String>

    <sys:String x:Key="GameLaunchSplash_VideoSound_Enable">Włącz dźwięk wideo powitalnego</sys:String>
    <sys:String x:Key="GameLaunchSplash_VideoSound_Help">Steruje poziomem głośności wyłącznie dla wideoekranów powitalnych. Ekrany powitalne w formie obrazów nie są dotknięte.</sys:String>
    <sys:String x:Key="LOCAnikiHelperManageSplashScreens">Zarządzaj ekranami powitalnymi</sys:String>
    <sys:String x:Key="GameLaunchSplash_VideoEndBehavior_Title">Gdy wideo powitalne kończy się przed czasem</sys:String>
    <sys:String x:Key="GameLaunchSplash_VideoEndBehavior_Help">Wybierz, co jest wyświetlane, jeśli wideo jest krótsze niż licznik czasu ekranu powitalnego.</sys:String>
    <sys:String x:Key="GameLaunchSplash_VideoEndBehavior_ShowGameBackground">Pokaż tło gry</sys:String>
    <sys:String x:Key="GameLaunchSplash_VideoEndBehavior_KeepLastFrame">Zachowaj ostatnią klatkę wideo</sys:String>

    <sys:String x:Key="GameLaunchSplash_Library_Title">Zarządzanie ekranem powitalnym</sys:String>
    <sys:String x:Key="GameLaunchSplash_Library_Help">Zarządzaj ekranem powitalnym używanym dla wybranego poziomu: globalnym, źródła lub platformy.</sys:String>
    <sys:String x:Key="GameLaunchSplash_ManageGlobal">Globalny ekran powitalny</sys:String>
    <sys:String x:Key="GameLaunchSplash_ManageSources">Ekrany powitalne według źródła</sys:String>
    <sys:String x:Key="GameLaunchSplash_ManagePlatforms">Ekrany powitalne według platformy</sys:String>

