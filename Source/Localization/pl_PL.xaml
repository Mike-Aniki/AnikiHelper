    <!-- ========= SOUND FEATURES ========= -->
    <sys:String x:Key="EventSounds_Title">Dźwięki zdarzeń</sys:String>
    <sys:String x:Key="EventSounds_Desc">Odtwarza efekty dźwiękowe dla zdarzeń takich jak uruchomienie gry, start/wyjście z Playnite oraz aktualizacje biblioteki. Działa z dźwiękami dołączonymi do motywu.</sys:String>
    <sys:String x:Key="EventSounds_Enable">Włącz dźwięki zdarzeń</sys:String>
    <sys:String x:Key="EventSounds_Help">Jeśli włączone, wyłącz dźwięki interfejsu/zdarzeń z wtyczki PlayniteSounds, aby uniknąć zdublowanego dźwięku.</sys:String>

    <!-- ========= GameOverlay FEATURES ========= -->
    <sys:String x:Key="KeyboardMouse_Tab">Klawiatura i mysz</sys:String>
    <sys:String x:Key="KeyboardMouse_Intro">Używaj wirtualnej klawiatury i steruj myszą systemu Windows bezpośrednio za pomocą kontrolera. Funkcje te działają niezależnie od nakładki w grze i pozostają dostępne podczas działania trybu pełnoekranowego Playnite.</sys:String>
    <sys:String x:Key="InGameOverlay_Tab">Nakładka w grze</sys:String>
    <sys:String x:Key="InGameOverlay_Title">Nakładka w grze</sys:String>
    <sys:String x:Key="InGameOverlay_Desc">Wyświetlaj panel szybkich akcji Aniki na wierzchu bieżącej gry.</sys:String>

    <sys:String x:Key="InGameOverlay_Settings_Title">Ustawienia nakładki</sys:String>
    <sys:String x:Key="InGameOverlay_Settings_Desc">Skonfiguruj nakładkę Aniki w grze oraz jej skrót klawiaturowy.</sys:String>

    <sys:String x:Key="InGameOverlay_Enable">Włącz nakładkę w grze</sys:String>
    <sys:String x:Key="InGameOverlay_Enable_Help">Włącza własną nakładkę w grze wtyczki Aniki Helper. Wyłącz tę opcję, jeśli wolisz używać nakładki Playnite lub innego rozwiązania.</sys:String>

    <sys:String x:Key="InGameOverlay_Hotkey_Title">Skrót nakładki</sys:String>
    <sys:String x:Key="InGameOverlay_Hotkey_Help">Wybierz skrót klawiaturowy używany do otwierania nakładki w grze. Zrestartuj Playnite po zmianie tego ustawienia.</sys:String>

    <sys:String x:Key="InGameOverlay_ControllerShortcut_Title">Skrót kontrolera</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Help">Wybierz skrót kontrolera używany do otwierania nakładki w grze. Obsługa przycisku Guide jest eksperymentalna i może być przechwytywana przez Steam, system Windows lub narzędzia kontrolera.</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_StartBack">Start + Back</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_BackY">Back + Y</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Guide">Przycisk Guide</sys:String>
    <sys:String x:Key="InGameOverlay_ControllerShortcut_Disabled">Wyłączone</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Title">Klawiatura wirtualna</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboard_Desc">Wybierz wirtualną klawiaturę używaną przez Aniki Helper. Można ją otworzyć za pomocą przycisku nakładki lub bezpośredniego skrótu na padzie podczas działania trybu pełnoekranowego Playnite.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Title">Dostawca klawiatury</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Aniki">Klawiatura Aniki</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Windows">Klawiatura systemu Windows</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardProvider_Help">Klawiatura systemu Windows używa ostatniego układu wybranego w systemie Windows. Wybierz układ pada raz w jej ustawieniach. Dostępność zależy od wersji systemu Windows.</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Title">Skrót bezpośredni</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_L3R3Hold">Przytrzymaj LS + RS (domyślnie)</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_BackX">Back / Select / View + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_GuideX">Guide + X</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Disabled">Wyłączone</sys:String>
    <sys:String x:Key="InGameOverlay_VirtualKeyboardShortcut_Help">Przytrzymaj LS + RS przez 600 ms. Kombinacja Guide + X może być przechwytywana przez Steam, Xbox Game Bar, system Windows lub narzędzia kontrolera.</sys:String>

    <sys:String x:Key="InGameOverlay_GamepadMouse_Title">Mysz sterowana padem</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouse_Desc">Używaj kontrolera jako myszy systemu Windows, gdy uruchomiony jest tryb pełnoekranowy Playnite. Prawy drążek porusza wskaźnikiem, lewy drążek przewija szybko, A to kliknięcie lewym przyciskiem, X to kliknięcie prawym przyciskiem, a LT / RT zapewniają precyzyjne przewijanie.</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Title">Skrót aktywacji</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_BackR3">Przytrzymaj Back + RS (domyślnie)</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_StartL3">Przytrzymaj Start + LS</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_GuideY">Przytrzymaj Guide + Y</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Disabled">Wyłączone</sys:String>
    <sys:String x:Key="InGameOverlay_GamepadMouseShortcut_Help">Przytrzymaj wybrany skrót przez 600 ms, aby włączyć lub wyłączyć mysz sterowaną padem. Można przytrzymać przycisk A podczas poruszania prawym drążkiem, aby przeciągać i upuszczać. Kombinacja Guide + Y może być przechwytywana przez Steam, Xbox Game Bar, system Windows lub narzędzia kontrolera.</sys:String>
    <sys:String x:Key="LOCGamepadMouseEnabledToast">Włączono mysz sterowaną padem</sys:String>
    <sys:String x:Key="LOCGamepadMouseDisabledToast">Wyłączono mysz sterowaną padem</sys:String>

    <sys:String x:Key="InGameOverlay_GameBehavior_Title">Zachowanie gry, gdy nakładka jest otwarta</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_DoNothing">Domyślnie: Nic nie rób</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_SuspendGame">Wstrzymaj grę, gdy nakładka jest otwarta</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_Help">Wybierz, czy Aniki Helper ma pozostawić grę uruchomioną normalnie, czy tymczasowo zamrozić proces gry, gdy nakładka jest otwarta, aby uniknąć podwójnego wprowadzania danych.</sys:String>
    <sys:String x:Key="InGameOverlay_GameBehavior_Warning">Ostrzeżenie: niezalecane w przypadku gier online, gier wieloosobowych, gier chronionych systemem antycheat lub gier uruchamianych jako administrator.</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Title">Nigdy nie wstrzymuj gier</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Help">Gry dodane przez kliknięcie prawym przyciskiem myszy → Aniki Helper → Ustawienia nakładki → Nigdy nie wstrzymuj tej gry pojawiają się tutaj. Odznacz grę, aby usunąć ją z listy nie wstrzymywanych.</sys:String>
    <sys:String x:Key="InGameOverlay_NeverSuspendList_Clear">Wyczyść listę nie wstrzymywanych</sys:String>
    <sys:String x:Key="LOCAnikiHelperOverlayNeverSuspendThisGame">Nigdy nie wstrzymuj tej gry</sys:String>
    <sys:String x:Key="LOCAnikiHelperOverlayAllowSuspendThisGame">Zezwól na wstrzymywanie tej gry</sys:String>

    <sys:String x:Key="InGameOverlay_Limitations_Title">Ograniczenia</sys:String>
    <sys:String x:Key="InGameOverlay_Limitations_Desc">Ta nakładka jest przezroczystym oknem wyświetlanym nad grą. Nie jest wstrzykiwana bezpośrednio do gry jak nakładki Steam czy Discord.</sys:String>
    <sys:String x:Key="InGameOverlay_Limitations_Help">Działa najlepiej z grami w trybie okienkowym bez obramowania lub pełnoekranowym okienkowym. Niektóre gry w wyłącznym trybie pełnoekranowym, systemy antycheat lub gry z uprawnieniami administratora mogą uniemożliwić prawidłowe wyświetlanie nakładki.</sys:String>
    <sys:String x:Key="LOCInGameOverlayFooterTitle">Centrum sterowania Aniki</sys:String>
    <sys:String x:Key="LOCInGameOverlayNoGameRunning">Brak uruchomionej gry</sys:String>
    <sys:String x:Key="LOCInGameOverlayNoActiveGame">Nie wykryto aktywnej gry</sys:String>
    <sys:String x:Key="LOCInGameOverlayLessThanOneMinute">mniej niż 1 min</sys:String>
    <sys:String x:Key="LOCInGameOverlayQuitDialogTitle">Zamknąć {0}?</sys:String>
    <sys:String x:Key="LOCInGameOverlayQuitDialogMessage">Spowoduje to próbę zamknięcia aktywnego okna gry.</sys:String>

    <sys:String x:Key="LOCInGameOverlayCancel">Anuluj</sys:String>
    <sys:String x:Key="LOCInGameOverlayConfirmQuit">Zamknij grę</sys:String>

