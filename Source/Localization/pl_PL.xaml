    <!-- ========= ANIKI SCREENSAVER ========= -->
    <sys:String x:Key="SettingsNav_ScreenSaver">Wygaszacz ekranu Aniki</sys:String>
    <sys:String x:Key="SettingsPage_ScreenSaverDesc">Automatycznie prezentuje gry z Twojej biblioteki po okresie bezczynności.</sys:String>
    <sys:String x:Key="ScreenSaver_Enable">Włącz wygaszacz ekranu Aniki</sys:String>
    <sys:String x:Key="ScreenSaver_Enable_Help">Wygaszacz ekranu uruchamia się tylko w trybie pełnoekranowym, gdy Playnite jest na pierwszym planie, żadna gra nie jest uruchomiona i nie jest otwarto żadne dodatkowe okno Aniki. Jakiekolwiek sterowanie natychmiast go zamyka.</sys:String>
    <sys:String x:Key="ScreenSaver_IdleDelay_Title">Uruchom po bezczynności</sys:String>
    <sys:String x:Key="ScreenSaver_ChangeInterval_Title">Zmieniaj grę co</sys:String>
    <sys:String x:Key="ScreenSaver_Source_Title">Źródło gier</sys:String>
    <sys:String x:Key="ScreenSaver_Source_Help">Wybierz, która część biblioteki Playnite ma być używana. Ukryte gry są zawsze wykluczone.</sys:String>
