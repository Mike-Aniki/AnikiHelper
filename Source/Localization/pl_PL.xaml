    <sys:String x:Key="SplashManager_DeleteConfirm">Usunąć ten plik ekranu powitalnego?{0}{1}</sys:String>
    <sys:String x:Key="SplashManager_SearchImages">Szukaj obrazów</sys:String>
    <sys:String x:Key="SplashManager_NoGameNameForSearch">Brak nazwy gry dostępnej dla tego wyszukiwania.</sys:String>

    <sys:String x:Key="SplashPicker_NoItemFound">Nie znaleziono elementów.</sys:String>
    <sys:String x:Key="SplashPicker_OpenFailed">Nie można otworzyć selektora ekranu powitalnego:</sys:String>
    <sys:String x:Key="SplashPicker_SourceTitle">Ekrany powitalne według źródła</sys:String>
    <sys:String x:Key="SplashPicker_SourceDescription">Wybierz źródło, aby zarządzać jego obrazami uruchamiania. Zostaną one użyte dla gier powiązanych z tym źródłem, takimi jak Steam, GOG, Epic, Xbox lub inne biblioteki.</sys:String>
    <sys:String x:Key="SplashPicker_SourceOpenFailed">Nie można otworzyć menedżera ekranów powitalnych źródła:</sys:String>
    <sys:String x:Key="SplashPicker_PlatformTitle">Ekrany powitalne według platformy</sys:String>
    <sys:String x:Key="SplashPicker_PlatformDescription">Wybierz platformę, aby zarządzać jej obrazami uruchamiania. Zostaną one użyte dla gier powiązanych z tą platformą.</sys:String>
    <sys:String x:Key="SplashPicker_PlatformOpenFailed">Nie można otworzyć menedżera ekranów powitalnych platformy:</sys:String>
