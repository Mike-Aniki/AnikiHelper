<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="AppTitle">Aniki Helper</sys:String>
    <sys:String x:Key="AppSubtitle">Ustawienia</sys:String>
    <sys:String x:Key="AppInfo">Aniki Helper zapewnia usługi Steam, integracje z zewnętrznymi wtyczkami oraz ekskluzywne funkcje Aniki dla kompatybilnych motywów.</sys:String>

    <sys:String x:Key="MoreOptionsDesktop">Więcej opcji jest dostępnych w ustawieniach wtyczki w trybie pulpitowym Playnite.</sys:String>
    <sys:String x:Key="GroupAdditionalFeatures">Dodatkowe funkcje</sys:String>

    <sys:String x:Key="GroupGeneral">Ogólne</sys:String>
    <sys:String x:Key="GroupNews">Wiadomości</sys:String>
    <sys:String x:Key="GroupDynamicColors">Kolory dynamiczne</sys:String>
    <sys:String x:Key="GameLaunchSplash_VideoVolume_Title">Głośność wideo</sys:String>
    <sys:String x:Key="GameLaunchSplash_BackgroundDimming_Title">Przyciemnienie tła</sys:String>
    <sys:String x:Key="GameLaunchSplash_BackgroundDimming_Help">Dostosowuje stałą ciemną nakładkę stosowaną do obrazów ekranu powitalnego. Wideo powitalne nie jest przyciemniane. Domyślnie: 37%.</sys:String>
    <sys:String x:Key="LOCDebugLogsTitle">Debugowanie</sys:String>
    <sys:String x:Key="LOCDebugLogsDescription">Włącz tę opcję tylko podczas rozwiązywania problemu i gdy musisz wysłać raport debugowania. Zapisuje ona szczegółowe informacje o Aniki Helper do pliku extensions.log i może generować dużo wpisów w dzienniku.</sys:String>
    <sys:String x:Key="LOCEnableDebugLogs">Włącz dzienniki debugowania</sys:String>
    <sys:String x:Key="LOCDebugLogsInfo">Dla czystego raportu debugowania: wyczyść plik dziennika, włącz tryb debugowania, odtwórz błąd, a następnie wyślij plik extensions.log. Tryb debugowania wyłącza się automatycznie po 24 godzinach lub przy następnym uruchomieniu Playnite.</sys:String>
    <sys:String x:Key="LOCClearLogFile">Wyczyść plik dziennika</sys:String>
    <sys:String x:Key="LOCOpenLogsFolder">Otwórz folder dzienników</sys:String>

    <!-- ========= HUB FEATURES ========= -->
    <sys:String x:Key="WelcomeHubStartup_Title">Ekran startowy</sys:String>
    <sys:String x:Key="WelcomeHubStartup_Desc">Wybierz, który ekran ma być pokazywany po uruchomieniu Playnite: Twoja biblioteka lub Hub.</sys:String>
    <sys:String x:Key="WelcomeHubStartup_Enable">Otwórz Hub przy starcie</sys:String>

    <sys:String x:Key="HubApps_Title">Funkcje i aplikacje Huba</sys:String>
    <sys:String x:Key="HubApps_Desc">Wyświetlaj do 4 wbudowanych funkcji Aniki lub narzędzi programowych Playnite bezpośrednio w Hubie.</sys:String>
    <sys:String x:Key="HubApps_Enable">Pokaż stronę Funkcje i aplikacje w Hubie</sys:String>
    <sys:String x:Key="HubApps_Slot1">Gniazdo 1</sys:String>
    <sys:String x:Key="HubApps_Slot2">Gniazdo 2</sys:String>
    <sys:String x:Key="HubApps_Slot3">Gniazdo 3</sys:String>
    <sys:String x:Key="HubApps_Slot4">Gniazdo 4</sys:String>
    <sys:String x:Key="HubApps_Help">Wybierz do 4 wbudowanych funkcji Aniki lub narzędzi programowych Playnite. Wbudowane funkcje obejmują przeglądarkę internetową, galerię zrzutów, znajomych Steam, sklep Steam, odtwarzacz muzyki oraz Aniki Media Center. Opcjonalnie możesz użyć własnego tła dla każdego gniazda; w przeciwnym razie motyw zapewnia domyślne tło dla funkcji Aniki i ogólną alternatywę dla narzędzi programowych.</sys:String>
    <sys:String x:Key="HubApps_SelectBackgroundDialog">Wybierz obraz tła dla tej karty aplikacji Huba.</sys:String>
    <sys:String x:Key="BrowseImage">Obraz...</sys:String>
    <sys:String x:Key="HubApps_None">Brak</sys:String>
    <sys:String x:Key="HubApps_GroupAnikiFeatures">FUNKCJE ANIKI</sys:String>
    <sys:String x:Key="HubApps_GroupSoftwareTools">NARZĘDZIA PROGRAMOWE</sys:String>
    <sys:String x:Key="HubFeature_WebBrowser">Przeglądarka internetowa Aniki</sys:String>
    <sys:String x:Key="HubFeature_MediaGallery">Galeria zrzutów</sys:String>
    <sys:String x:Key="HubFeature_SteamFriends">Znajomi Steam</sys:String>
    <sys:String x:Key="HubFeature_SteamStore">Sklep Steam</sys:String>
    <sys:String x:Key="HubFeature_MusicPlayer">Odtwarzacz muzyki</sys:String>
    <sys:String x:Key="HubFeature_VideoPlayer">Aniki Media Center</sys:String>
    <sys:String x:Key="HubFeature_MusicPlayerRequiresUPS">Aby otworzyć odtwarzacz muzyki, należy zainstalować wtyczkę UniPlaySong.</sys:String>
    <sys:String x:Key="HubApps_Loading">Ładowanie wybranych skrótów...</sys:String>
    <sys:String x:Key="HubApps_Empty">Wybierz funkcje lub aplikacje w ustawieniach Aniki Helper.</sys:String>
    <sys:String x:Key="LOCHubAppsTitle">Funkcje i aplikacje</sys:String>
    <sys:String x:Key="LOCHubAppsSubtitle">Wbudowane funkcje Aniki i wybrane narzędzia programowe</sys:String>

    <sys:String x:Key="WelcomeHubStartup_Help">Po wyłączeniu Playnite otworzy się bezpośrednio na Twojej bibliotece.</sys:String>
    <sys:String x:Key="HubVideoCenterPage_Enable">Pokaż stronę Aniki Media Center w Hubie</sys:String>
    <sys:String x:Key="HubVideoCenterPage_Help">Pokazuje do czterech kart z pamięci podręcznej mediów z sekcji Ostatnio oglądane i Ostatnio dodane. Strona ukrywa się automatycznie, gdy Media Center nie ma zawartości.</sys:String>

