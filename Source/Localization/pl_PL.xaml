    <sys:String x:Key="SettingsReset_SectionTitle">Przywróć ustawienia domyślne</sys:String>
    <sys:String x:Key="SettingsReset_Description">Przywróć wszystkie opcje Aniki Helper do ich oryginalnych wartości domyślnych.</sys:String>
    <sys:String x:Key="SettingsReset_ScopeNote">Połączone konta, ulubione w przeglądarce, historia wideo i dane wznawiania, zrzuty, dane poszczególnych gier, pamięć podręczna oraz konfiguracja motywu zostaną zachowane.</sys:String>
    <sys:String x:Key="SettingsReset_Button">Przywróć domyślne</sys:String>
    <sys:String x:Key="SettingsReset_Tooltip">Przywróć opcje Aniki Helper do ich wartości domyślnych.</sys:String>
    <sys:String x:Key="SettingsReset_Confirm">Przywrócić wszystkie opcje Aniki Helper do wartości domyślnych? Twoje obecne wybory opcji zostaną nadpisane, ale połączone konta i dane osobowe zostaną zachowane.</sys:String>
    <sys:String x:Key="SettingsReset_Success">Opcje Aniki Helper zostały przywrócone do wartości domyślnych.</sys:String>
    <sys:String x:Key="SettingsReset_Error">Nie można przywrócić ustawień domyślnych.</sys:String>

    <sys:String x:Key="VideoPlayer_NetworkLocations">Lokalizacje sieciowe</sys:String>
    <sys:String x:Key="VideoPlayer_NetworkFolders">Foldery sieciowe</sys:String>
    <sys:String x:Key="VideoPlayer_NetworkLocationsSubtitle">Skonfigurowane foldery sieciowe</sys:String>
    <sys:String x:Key="VideoPlayer_NetworkEmpty">Brak skonfigurowanych lokalizacji sieciowych. Dodaj je w Aniki Helper &gt; Ekskluzywne funkcje &gt; Aniki Media Center.</sys:String>
    <sys:String x:Key="VideoPlayer_NetworkUnavailable">Niedostępne</sys:String>
    <sys:String x:Key="VideoPlayer_NetworkMediaUnavailableRetry">Lokalizacja sieciowa niedostępna lub wybudza się. Spróbuj ponownie za chwilę.</sys:String>
    <sys:String x:Key="VideoPlayer_MediaUnavailableRetry">Media niedostępne. Spróbuj ponownie za chwilę.</sys:String>
    <sys:String x:Key="VideoPlayer_NetworkError">Nie można sprawdzić skonfigurowanych lokalizacji sieciowych.</sys:String>
    <sys:String x:Key="VideoPlayer_Network">SIEĆ</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_Title">Grafika online</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_TmdbConfigHelp">Gdy token jest skonfigurowany, TMDB jest preferowane dla filmów, seriali i anime. Dodaj swój token dostępu do interfejsu API TMDB poniżej, aby włączyć zlokalizowaną grafikę.</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_TmdbConfigTitle">GRAFIKA TMDB — FILMY I SERIALE</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_EnableHelp">Lokalna grafika ma zawsze priorytet. Z tokenem TMDB filmy i seriale najpierw próbują TMDB; TVMaze i AniList pozostają automatycznymi alternatywami bez klucza.</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_Enable">Włącz grafikę online</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_Desc">Automatycznie pobieraj grafikę, gdy brak obrazu lokalnego. Aniki wybiera odpowiedniego dostawcę automatycznie.</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_MoviesTitle">FILMY — TMDB</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_SeriesTitle">SERIALE TV — TMDB / TVMAZE</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_AnimeTitle">ANIME — TMDB / ANILIST</sys:String>
    <sys:String x:Key="VideoTvmaze_Enable">Włącz scraper seriali TVmaze</sys:String>
    <sys:String x:Key="VideoTvmaze_Help">Klucz API nie jest wymagany. TVmaze jest używane jako zapasowe źródło dla seriali, gdy TMDB jest niedostępne lub nie może znaleźć bezpiecznego dopasowania.</sys:String>
    <sys:String x:Key="VideoAnilist_Enable">Włącz scraper anime AniList</sys:String>
    <sys:String x:Key="VideoAnilist_Help">Klucz API nie jest wymagany. AniList to wyspecjalizowana alternatywa dla anime, gdy TMDB jest niedostępne lub nie może znaleźć bezpiecznego dopasowania, i pozostaje dostępna w selektorze grafik.</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_AutoRoutingHelp">Automatyczne routing z tokenem TMDB: film → TMDB; serial → TMDB, potem TVMaze; anime → TMDB, potem AniList/TVMaze. Bez tokena TVMaze i AniList pozostają dostępne automatycznie.</sys:String>
    <sys:String x:Key="VideoOnlineArtwork_Attribution">Token TMDB jest opcjonalny dla seriali i anime: włącza TMDB jako preferowanego dostawcę. TVMaze i AniList pozostają dostępne bez klucza.</sys:String>
    <sys:String x:Key="VideoTvmaze_StatusReady">Scraper TVmaze: Gotowy</sys:String>
    <sys:String x:Key="VideoTvmaze_StatusDisabled">Scraper TVmaze: Wyłączony</sys:String>
    <sys:String x:Key="VideoAnilist_StatusReady">Scraper AniList: Gotowy</sys:String>
    <sys:String x:Key="VideoAnilist_StatusDisabled">Scraper AniList: Wyłączony</sys:String>

    <sys:String x:Key="VideoTmdb_Title">Scraper grafiki TMDB</sys:String>
    <sys:String x:Key="VideoTmdb_Desc">Automatycznie pobieraj okładki, grafiki poziome, tapety i logo z TMDB dla filmów, seriali i anime, gdy lokalna grafika jest niedostępna.</sys:String>
    <sys:String x:Key="VideoTmdb_Enable">Włącz scraper grafiki TMDB</sys:String>
    <sys:String x:Key="VideoTmdb_EnableHelp">Grafika lokalna umieszczona obok mediów ma zawsze priorytet. TMDB jest używane tylko wtedy, gdy lokalna grafika jest niedostępna.</sys:String>
    <sys:String x:Key="VideoTmdb_Language">Preferowany język grafiki</sys:String>
    <sys:String x:Key="VideoTmdb_LanguageAuto">Użyj języka Playnite</sys:String>
    <sys:String x:Key="VideoTmdb_LanguageHelp">Grafika z tekstem preferuje ten język, następnie grafikę bez tekstu, oryginalny język mediów i angielski. Tapety preferują grafikę bez tekstu.</sys:String>
    <sys:String x:Key="VideoTmdb_Token">Token dostępu do interfejsu API TMDB</sys:String>
    <sys:String x:Key="VideoTmdb_TokenHelp">Utwórz bezpłatny deweloperski token dostępu do interfejsu API w ustawieniach swojego konta TMDB. Token jest przechowywanylokalnie i szyfrowany za pomocą Windows DPAPI.</sys:String>
    <sys:String x:Key="VideoTmdb_MatchingHelp">Wersja V2 oczyszcza nazwy wydań (tagi jakości, kodeków, języka, źródła i grupy wydań), wyodrębnia rok osobno, próbuje inteligentnych wariantów tytułów i ocenia dopasowania tytułu/roku przed ich zaakceptowaniem.</sys:String>
    <sys:String x:Key="VideoTmdb_PrivacyHelp">Gdy pobieranie jest wymagane, Aniki wysyła do TMDB wyłącznie oczyszczony tytuł mediów i wykryty rok. Ścieżki lokalne/sieciowe nigdy nie są wysyłane do TMDB ani przechowywane w czystym tekście w indeksach grafik.</sys:String>
    <sys:String x:Key="VideoTmdb_Attribution">Ten produkt korzysta z interfejsu API TMDB, ale nie jest przez TMDB wspierany ani certyfikowany.</sys:String>
    <sys:String x:Key="VideoTmdb_StatusDisabled">Scraper TMDB: Wyłączony</sys:String>
    <sys:String x:Key="VideoTmdb_StatusTokenMissing">Scraper TMDB: Brak tokena API</sys:String>
    <sys:String x:Key="VideoTmdb_StatusReady">Scraper TMDB: Gotowy</sys:String>

    <sys:String x:Key="VideoNetwork_Title">Lokalizacje sieciowe</sys:String>
    <sys:String x:Key="VideoNetwork_Desc">Skonfiguruj do 4 folderów sieciowych, które pojawią się w sekcji Lokalizacje sieciowe w Aniki Media Center.</sys:String>
    <sys:String x:Key="VideoNetwork_Help">Użyj ścieżki UNC, takiej jak \\NAS\Filmy, lub wybierz Przeglądaj. System Windows musi już mieć dostęp do chronionych udziałów; Aniki Helper nigdy nie przechowuje poświadczeń sieciowych.</sys:String>
