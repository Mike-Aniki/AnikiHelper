    <!-- Theme configuration backup -->
    <sys:String x:Key="ThemeConfiguration_SectionTitle">Konfiguracja motywu</sys:String>
    <sys:String x:Key="ThemeConfiguration_Help">Wyeksportuj plik ThemeSettings.json, który przechowuje ustawienia motywu, lub zastąp go konfiguracją zapisaną przez siebie lub udostępnioną przez innego użytkownika. Zaimportowana konfiguracja zostanie użyta przy następnym otwarciu trybu pełnoekranowego.</sys:String>
    <sys:String x:Key="ThemeConfiguration_ScopeNote">Ta kopia zapasowa dotyczy wyłącznie pliku konfiguracyjnego opcji motywu. Nie obejmuje logowania do Steam, innych ustawień Aniki Helper, statystyk miesięcznych, zainstalowanych wtyczek, danych gier ani mediów.</sys:String>
