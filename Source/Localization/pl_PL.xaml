    <!-- ========= DYNAMIC COLORS FEATURES ========= -->
    <sys:String x:Key="GroupDynColors">Kolory dynamiczne</sys:String>
    <sys:String x:Key="DynColors_Help">Użyj tego, jeśli kolory nie pasują do aktualnych tła gier.</sys:String>

    <sys:String x:Key="L_ClearColorCache">Zresetuj pamięć podręczną kolorów</sys:String>
    <sys:String x:Key="L_ClearColorCache_Desc">Kolory są przechowywane na podstawie tła każdej gry. Jeśli zmienisz tła, zapisane kolory mogą stać się nieaktualne.</sys:String>
    <sys:String x:Key="L_ClearColorCache_Tooltip">Wyczyść wszystkie zapisane dane kolorów i odbuduj je z obecnych tła.</sys:String>
    <sys:String x:Key="L_ClearColorCache_Done_Title">Aniki Helper</sys:String>
    <sys:String x:Key="L_ClearColorCache_Done_Body">Wyczyszczono pamięć podręczną kolorów. Kolory zostaną przebudowane automatycznie.</sys:String>
    <sys:String x:Key="L_ClearColorCache_Error_Title">Aniki Helper</sys:String>
    <sys:String x:Key="L_ClearColorCache_Error_Body">Nie udało się wyczyścić pamięci podręcznej kolorów:</sys:String>

    <sys:String x:Key="L_DynAutoPrecache_Title">Przetwarzanie kolorów tła</sys:String>
    <sys:String x:Key="L_EnableDynamicAutoPrecache">Wstępnie ładuj kolory w tle</sys:String>
    <sys:String x:Key="L_EnableDynamicAutoPrecache_Note">Poprawia płynność nawigacji. Może nieznacznie wpływać na wydajność na słabszych komputerach.</sys:String>
    <sys:String x:Key="L_EnableDynamicAutoPrecache_Tooltip">Skanuj bibliotekę i przygotowuj dane kolorów automatycznie w tle.</sys:String>
    <sys:String x:Key="L_CacheManagement_Title">Zarządzanie pamięcią podręczną</sys:String>
    <sys:String x:Key="L_EnableDynamicAutoPrecache_Desc">Po włączeniu kolory są generowane automatycznie dla Twojej biblioteki zamiast być tworzonymi podczas nawigacji.</sys:String>

    <sys:String x:Key="ConfirmClearCache">Zresetować pamięć podręczną kolorów? Kolory zostaną wygenerowane automatycznie.</sys:String>
    <sys:String x:Key="CacheClearedMsg">Wyczyszczono pamięć podręczną kolorów.</sys:String>

    <!-- ========= STEAM FEATURES ========= -->
    <sys:String x:Key="GroupSteamFeatures">Funkcje Steam</sys:String>

    <!-- Steam updates -->
    <sys:String x:Key="SteamUpdates_GroupTitle">Aktualizacje Steam</sys:String>
    <sys:String x:Key="SteamUpdates_GroupDesc">Po włączeniu wtyczka sprawdza aktualizacje gier bezpośrednio ze Steam. Pozwala to motywowowi wyświetlać zarówno nowe, jak i starsze wpisy aktualizacji.</sys:String>

    <sys:String x:Key="SteamUpdates_Title">Aktualizacje gier</sys:String>
    <sys:String x:Key="SteamUpdates_Desc">Sprawdza, czy Twoje gry ze Steam mają niedawne aktualizacje.</sys:String>
    <sys:String x:Key="SteamUpdates_Enable">Włącz sprawdzanie aktualizacji</sys:String>
    <sys:String x:Key="SteamUpdates_Enable_Help">Całkowicie włącza lub wyłącza sprawdzanie aktualizacji.</sys:String>

    <!-- Update data -->
    <sys:String x:Key="SteamInitCache_ProgressTitle">Dane aktualizacji</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressDesc">Wtyczka sprawdza aktualizacje gier ze Steam podczas przeglądania biblioteki. Możesz uruchomić pełne skanowanie biblioteki, aby wstępnie zapełnić dane aktualizacji dla wszystkich gier zamiast czekać na przeglądanie ich po kolei. Pomaga to uniknąć fałszywych powiadomień o aktualizacjach i poprawia wydajność podczas nawigacji.</sys:String>
    <sys:String x:Key="SteamInitCache">Skanuj bibliotekę</sys:String>
    <sys:String x:Key="SteamInitCache_Tooltip">Skanuje gry ze Steam i przygotowuje dane aktualizacji.</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressNote">Skanowanie biblioteki jest zalecane, aby uniknąć fałszywych powiadomień i poprawić wydajność.</sys:String>
    <sys:String x:Key="SteamInitCache_ProgressText">Skanowanie… {0}/{1}</sys:String>
    <sys:String x:Key="LOCSteamLastScan">Ostatnie skanowanie:</sys:String>
    <sys:String x:Key="ConfirmInitSteamCache">Skanować bibliotekę teraz?</sys:String>
    <sys:String x:Key="InitSteamCacheDoneMsg">Skanowanie zakończone.</sys:String>

    <!-- Current players -->
    <sys:String x:Key="SteamPlayers_GroupTitle">Aktualni gracze</sys:String>
    <sys:String x:Key="SteamPlayers_GroupDesc">Wyświetla liczbę graczy na żywo dla obsługiwanych gier ze Steam.</sys:String>

    <sys:String x:Key="SteamPlayers_Title">Aktualni gracze</sys:String>
    <sys:String x:Key="SteamPlayers_Desc">Pokazuje, ile osób obecnie gra w daną grę.</sys:String>
    <sys:String x:Key="SteamPlayers_Enable">Włącz licznik graczy</sys:String>
    <sys:String x:Key="SteamPlayers_Help">Włącza lub wyłącza wyświetlanie liczby graczy w motywie.</sys:String>

    <!-- Steam Store -->
    <sys:String x:Key="SteamStore_GroupTitle">Sklep Steam</sys:String>
    <sys:String x:Key="SteamStore_GroupDesc">Skonfiguruj sposób wyświetlania zawartości sklepu Steam w motywie.</sys:String>

    <sys:String x:Key="SteamStore_Language_Title">Język sklepu</sys:String>
    <sys:String x:Key="SteamStore_Language_Desc">Wybierz język używany dla zawartości sklepu Steam.</sys:String>
    <sys:String x:Key="SteamStore_Language_Label">Język</sys:String>

    <sys:String x:Key="SteamStore_Country_Title">Kraj sklepu</sys:String>
    <sys:String x:Key="SteamStore_Country_Desc">Wybierz kraj używany dla cen i waluty.</sys:String>
    <sys:String x:Key="SteamStore_Country_Label">Kraj</sys:String>
    <sys:String x:Key="SteamStore_Country_Help">Wpływa to na ceny regionalne i wyświetlanie waluty.</sys:String>

    <sys:String x:Key="SteamStore_Enable_Title">Integracja ze sklepem</sys:String>
    <sys:String x:Key="SteamStore_Enable">Włącz sklep Steam</sys:String>
    <sys:String x:Key="SteamStore_Enable_Desc">Włącz sekcje sklepu Steam wewnątrz motywu.</sys:String>
    <sys:String x:Key="SteamStore_Enable_Help">Po wyłączeniu przycisk sklepu przestanie pojawiać się w motywie.</sys:String>


    <!-- Steam account / connection -->
    <sys:String x:Key="SteamAccount_GroupTitle">Połączenie z kontem Steam</sys:String>
    <sys:String x:Key="SteamAccount_GroupDesc">Połącz się raz, aby korzystać ze znajomych Steam, mojej listy życzeń, sekcji „Dla Ciebie” i spersonalizowanych rekomendacji Steam.</sys:String>
    <sys:String x:Key="SteamAccount_ConnectButton">Połącz ze Steam</sys:String>
    <sys:String x:Key="SteamAccount_ReconnectButton">Połącz ponownie ze Steam</sys:String>
    <sys:String x:Key="SteamAccount_CheckButton">Sprawdź połączenie</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectButton">Rozłącz</sys:String>
    <sys:String x:Key="SteamAccount_StatusLabel">Status połączenia</sys:String>
    <sys:String x:Key="SteamAccount_SteamIdLabel">Konto Steam:</sys:String>
    <sys:String x:Key="SteamAccount_ConfiguredBadge">SKONFIGUROWANO</sys:String>
    <sys:String x:Key="SteamAccount_MissingBadge">BRAK</sys:String>
    <sys:String x:Key="SteamAccount_OptionalBadge">OPCJONALNIE</sys:String>
    <sys:String x:Key="SteamAccount_ConnectedTitle">Połączono ze Steam</sys:String>
    <sys:String x:Key="SteamAccount_ConnectedDesc">Twoja sesja Steam jest aktywna. Znajomi Steam, moja lista życzeń i sekcja „Dla Ciebie” są gotowe do użycia.</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectedTitle">Brak połączenia ze Steam</sys:String>
    <sys:String x:Key="SteamAccount_DisconnectedDesc">Połącz swoje konto Steam. Oficjalna strona logowania Steam otwiera się i zamyka automatycznie po zalogowaniu.</sys:String>
    <sys:String x:Key="SteamAccount_ProfileLabel">Wykryty profil Steam / SteamID</sys:String>
    <sys:String x:Key="SteamAccount_ApiKeyTitle">Klucz Steam Web API</sys:String>
    <sys:String x:Key="SteamAccount_ApiKeyDesc">Wymagany dla znajomych Steam i używany do ulepszania rekomendacji sklepu na podstawie posiadanych i ostatnio granych gier. Sklep może działać bez niego, ale dane znajomych i niektóre funkcje personalizacji będą niedostępne.</sys:String>
    <sys:String x:Key="SteamAccount_ManualSteamIdTitle">Zaawansowany zapasowy SteamID</sys:String>
    <sys:String x:Key="SteamAccount_ManualSteamIdDesc">Opcjonalnie. Użyj tego tylko wtedy, gdy automatyczne wykrywanie SteamID zawiedzie.</sys:String>
    <sys:String x:Key="SteamAccount_PrivacyNotice">Klucz Steam Web API nie jest wymagany, a Twoja lista znajomych Steam nie musi być publiczna.</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoTitle">Jedno połączenie Steam do wszystkiego</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoDesc">To samo połączenie obsługuje znajomych Steam, moją listę życzeń, sekcję „Dla Ciebie” oraz spersonalizowane rekomendacje. Jeśli sesja wygaśnie, po prostu połącz się ponownie.</sys:String>
    <sys:String x:Key="SteamAccount_UnifiedInfoPrivacy">Klucz API nie jest wymagany. Twoja lista znajomych Steam może pozostać prywatna.</sys:String>
    <sys:String x:Key="SteamAccount_TokenMissingTitle">Usługi Steam nie są gotowe</sys:String>
    <sys:String x:Key="SteamAccount_TokenMissingDesc">Twoje konto Steam jest połączone, ale sesja wymaga odświeżenia. Użyj opcji Sprawdź połączenie lub rozłącz się i połącz ponownie.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheTitle">Logowanie Steam stale się odświeża?</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheDesc">Uszkodzona pamięć podręczna sieci Web Playnite może uniemożliwić poprawne ładowanie strony logowania Steam.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheNote">To czyści współdzieloną pamięć podręczną przeglądarki Playnite i restartuje Playnite. Integracje oparte na przeglądarce mogą wymagać ponownego zalogowania. Ścieżka ręczna: Ustawienia Playnite → Zaawansowane → Wyczyść pamięć podręczną sieci Web.</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheButton">Wyczyść pamięć podręczną sieci i zrestartuj</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheConfirm">Playnite musi uruchomić się ponownie, aby wyczyścić współdzieloną pamięć podręczną sieci. Integracje oparte na przeglądarce mogą poprosić o ponowne zalogowanie. Kontynuować?</sys:String>
    <sys:String x:Key="SteamAccount_ClearWebCacheError">Nie można zrestartować Playnite i wyczyścić pamięci podręcznej sieci. Użyj opcji Ustawienia Playnite → Zaawansowane → Wyczyść pamięć podręczną sieci Web.</sys:String>
    <sys:String x:Key="SteamFullscreen_DisconnectedSummary">Logowanie Steam jest dostępne w ustawieniach Aniki Helper w trybie pulpitowym Playnite.</sys:String>
    <sys:String x:Key="SteamFullscreen_PrivacyHelp">Połącz się tam, wróć do trybu pełnoekranowego, a następnie wybierz Sprawdź połączenie.</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesLabel">Usługi Steam</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesReady">Gotowe</sys:String>
    <sys:String x:Key="SteamFullscreen_ServicesMissing">Wymagane odświeżenie</sys:String>
    <sys:String x:Key="SteamFullscreen_ConnectedSummary">Użyj opcji Sprawdź połączenie, jeśli wyświetlany status jest nieaktualny lub jeśli funkcja Steam przestanie działać.</sys:String>

    <sys:String x:Key="SteamFullscreen_AccountLabel">Powiązane konto Steam</sys:String>
    <sys:String x:Key="SteamFullscreen_SteamIdLabel">Wykryty lub skonfigurowany SteamID</sys:String>
    <sys:String x:Key="SteamFullscreen_ApiKeyLabel">Klucz Steam Web API</sys:String>

    <sys:String x:Key="SteamFullscreen_StatusReady">Skonfigurowano</sys:String>
    <sys:String x:Key="SteamFullscreen_StatusMissing">Brak</sys:String>

    <sys:String x:Key="SteamFullscreen_ConfigurationReady">Konfiguracja Steam jest kompletna.</sys:String>
    <sys:String x:Key="SteamFullscreen_ConfigurationMissing">Konfiguracja Steam jest niekompletna. Przełącz się do trybu pulpitowego, a następnie otwórz ustawienia Aniki Helper, aby połączyć konto Steam lub wpisać brakujące informacje.</sys:String>

    <!-- Steam Friends -->
    <sys:String x:Key="LOCSteamFriends_Title">Znajomi Steam</sys:String>
    <sys:String x:Key="LOCSteamFriends_Subtitle">Pokazuje status znajomych ze Steam w motywie Aniki: znajomych online, aktualne gry, karty profilu i powiadomienia w motywie.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Enable">Włącz integrację znajomych Steam</sys:String>
    <sys:String x:Key="LOCSteamFriends_EnableHelp">Włącza lub wyłącza dane znajomych Steam używane przez motyw.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Display">Wyświetlanie</sys:String>
    <sys:String x:Key="LOCSteamFriends_OnlineInfo">Motyw może wyświetlać do 15 znajomych online jednocześnie. Znajomi są priorytetyzowani według statusu: najpierw w grze, potem online, zaraz wracam i zajęty.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ShowOffline">Pokaż znajomych offline</sys:String>
    <sys:String x:Key="LOCSteamFriends_OfflineInfo">Znajomi offline są opcjonalni i ograniczeni do 40 jednocześnie, aby utrzymać płynność nawigacji.</sys:String>
    <sys:String x:Key="LOCSteamFriends_Notifications">Powiadomienia</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStart">Powiadamiaj, gdy znajomy uruchomi grę</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStartHelp">Wyświetla powiadomienie w motywie, gdy znajomy ze Steam zacznie grać.</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnect">Powiadamiaj, gdy znajomy przejdzie w stan online</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnectHelp">Wyświetla powiadomienie w motywie, gdy znajomy ze Steam przejdzie w stan online.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedDetails_Title">Szczegóły gry</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Section">Gry grane przez znajomych</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Refresh">Odśwież gry grane przez znajomych</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Help">Tworzy lokalną pamięć podręczną Steam używaną przez widok szczegółów do pokazywania znajomych, którzy grali już w wybraną grę. Skanowanie może chwilę potrwać w zależności od liczby znajomych.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Preparing">Przygotowywanie odświeżania gier granych przez znajomych...</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Refreshing">Odświeżanie gier granych przez znajomych... {0}/{1}</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Done">Odświeżono gry grane przez znajomych: przeskanaowano {0} znajomych.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_DoneMarker">odświeżono</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Error">Nie udało się odświeżyć gier granych przez znajomych.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_MissingConfig">Połącz swoje konto Steam w ustawieniach Aniki Helper.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_NoFriends">Połączona sesja Steam nie zwróciła żadnych znajomych ze Steam.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Empty">Pamięć podręczna gier granych przez znajomych nie została jeszcze utworzona.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Stale">Pamięć podręczna gier granych przez znajomych jest stara. Ostatnie odświeżenie: {0}.</sys:String>
    <sys:String x:Key="LOCSteamFriends_PlayedCache_Loaded">Wczytano pamięć podręczną gier granych przez znajomych. Ostatnie odświeżenie: {0}.</sys:String>
