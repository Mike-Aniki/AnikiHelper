    <!-- ========= ACHIEVEMENTS CACHE ========= -->
    <sys:String x:Key="AchievementCache_Title">Pamięć podręczna wspomnień osiągnięć</sys:String>
    <sys:String x:Key="AchievementCache_Desc">Przebudowuje wspomnienia osiągnięć z PlayniteAchievements. Użyj tego, jeśli brakuje ikon, ostatnich osiągnięć lub danych o rzadkości albo są one nieaktualne.</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild">Wspomnienia osiągnięć</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Button">Przebuduj pamięć podręczną</sys:String>
    <sys:String x:Key="AchievementCache_Rebuild_Help">Skanuje PlayniteAchievements i przebudowuje wspomnienia osiągnięć wyświetlane w motywie. W przypadku dużych bibliotek może to chwilę potrwać.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Scanning">Skanowanie osiągnięć...</sys:String>
    <sys:String x:Key="AchievementCache_Status_Done">Przebudowano pamięć podręczną wspomnień osiągnięć: {0} elementów.</sys:String>
    <sys:String x:Key="AchievementCache_Status_Failed">Nie udało się przebudować pamięci podręcznej wspomnień osiągnięć.</sys:String>
    <sys:String x:Key="LOCAnikiHelperRefreshAchievementCacheForGame">Odśwież wspomnienia tej gry</sys:String>
    <!-- ========= CUSTOM ICONS ========= -->
    <sys:String x:Key="CustomIcons_Title">Niestandardowe zasoby</sys:String>
    <sys:String x:Key="CustomIcons_Desc">Wybierz zewnętrzne foldery dla niestandardowych ikon filtrów, tła filtrów, ikon źródeł i obrazów banerów. Pliki te zastępują domyślne elementy wizualne motywu bez modyfikowania jego plików.</sys:String>
    <sys:String x:Key="CustomIcons_FilterFolder">Folder ikon filtrów</sys:String>
    <sys:String x:Key="CustomIcons_FilterBackgroundFolder">Folder tła filtrów</sys:String>
    <sys:String x:Key="CustomIcons_SourceFolder">Folder ikon źródeł</sys:String>
    <sys:String x:Key="CustomIcons_BannerAboveCoverFolder">Folder banerów nad okładką</sys:String>
    <sys:String x:Key="CustomIcons_BannerOnCoverFolder">Folder banerów na okładce</sys:String>
    <sys:String x:Key="CustomIcons_Help">Ikony filtrów i źródeł muszą być plikami PNG o dokładnych nazwach wyświetlanych w Playnite. Tła filtrów mogą używaćformatu JPG, JPEG, PNG, WEBP lub BMP z dokładną nazwą presetu filtra, na przykład Installed.jpg lub Favorites.png. Obraz domyślny (Default) jest używany, gdy brak dokładnego dopasowania. Użyj osobnych folderów dla banerów nad okładką i na okładce.</sys:String>
    <sys:String x:Key="BrowseFolder">Przeglądaj...</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterFolderDialog">Wybierz folder zawierający ikony PNG filtrów.</sys:String>
    <sys:String x:Key="CustomIcons_SelectFilterBackgroundFolderDialog">Wybierz folder zawierający obrazy tła filtrów.</sys:String>
    <sys:String x:Key="CustomIcons_SelectSourceFolderDialog">Wybierz folder zawierający ikony PNG źródeł.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerAboveCoverFolderDialog">Wybierz folder zawierający obrazy PNG banerów nad okładką.</sys:String>
    <sys:String x:Key="CustomIcons_SelectBannerOnCoverFolderDialog">Wybierz folder zawierający obrazy PNG banerów na okładce.</sys:String>

    <!-- ========= TRACK PLAYTIME FEATURES ========= -->
    <sys:String x:Key="GroupMonthly">Miesięczna historia</sys:String>
    <sys:String x:Key="ResetSectionTitle">Zresetuj śledzenie bieżącego miesiąca</sys:String>
    <sys:String x:Key="BackupSectionTitle">Zapisz i przywróć swoją historię</sys:String>

    <sys:String x:Key="MonthlyHelp">Śledzi Twój czas gry w każdym miesiącu, dzięki czemu motyw może wyświetlać statystyki, takie jak czas gry w tym miesiącu, grające gry oraz najczęściej grana gra.</sys:String>
    <sys:String x:Key="CurrentMonthData">Bieżący miesiąc:</sys:String>
    <sys:String x:Key="SnapshotTooltip">Pokazuje, kiedy rozpoczęło się śledzenie dla bieżącego miesiąca.</sys:String>

    <sys:String x:Key="ResetWarningText">Ostrzeżenie: to spowoduje usunięcie danych śledzenia dla bieżącego miesiąca.</sys:String>
    <sys:String x:Key="ResetBtn">Zresetuj śledzenie bieżącego miesiąca</sys:String>
    <sys:String x:Key="ResetBtnTooltip">Usuwa dane śledzenia bieżącego miesiąca i rozpoczyna od nowa od teraz.</sys:String>
    <sys:String x:Key="ResetBtntip">Nie używaj tego, chyba że naprawdę chcesz wymazać śledzenie z tego miesiąca. Statystyki miesięczne dla bieżącego miesiąca zaczną się od zera po zresetowaniu.</sys:String>

    <sys:String x:Key="ExportMonthlyBackupBtn">Eksportuj statystyki miesięczne</sys:String>
    <sys:String x:Key="ImportMonthlyBackupBtn">Importuj statystyki miesięczne</sys:String>
    <sys:String x:Key="ExportMonthlyBackupTooltip">Eksportuje wszystkie dane statystyk miesięcznych do pliku kopii zapasowej JSON.</sys:String>
    <sys:String x:Key="ImportMonthlyBackupTooltip">Przywraca dane statystyk miesięcznych z wcześniej wyeksportowanej kopii JSON.</sys:String>
    <sys:String x:Key="MonthlyBackupHelp">Eksportuj lub przywróć miesięczne statystyki gry zapisane przez Aniki Helper. Jest to przydatne przed ponowną instalacją Playnite lub zresetowaniem biblioteki.</sys:String>
    <sys:String x:Key="MonthlyBackup_SectionTitle">Miesięczne statystyki</sys:String>
    <sys:String x:Key="MonthlyBackup_ScopeNote">Ta kopia zapasowa zawiera wyłącznie dane statystyk miesięcznych. Nie wpływa na konfigurację motywu, konto Steam, wtyczki, gry ani media.</sys:String>
    <sys:String x:Key="DangerZone_Title">Strefa niebezpieczna</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Help">Trwale usuń wszystkie dane statystyk miesięcznych zapisane przez Aniki Helper. Śledzenie dla bieżącego miesiąca rozpocznie się od momentu usunięcia danych.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Warning">Tej operacji nie można cofnąć, chyba że wcześniej wyeksportowano kopię zapasową.</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsBtn">Usuń wszystkie statystyki miesięczne</sys:String>
    <sys:String x:Key="DeleteAllMonthlyStatsTooltip">Trwale usuwa wszystkie statystyki miesięczne i resetuje śledzenie bieżącego miesiąca od teraz.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Confirm">Czy na pewno chcesz trwale usunąć wszystkie dane statystyk miesięcznych? Śledzenie dla bieżącego miesiąca rozpocznie się od nowa od teraz. Tej operacji nie można cofnąć, chyba że wyeksportowano kopię zapasową.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Success">Wszystkie dane statystyk miesięcznych zostały usunięte. Śledzenie rozpoczyna się od nowa od teraz.</sys:String>
    <sys:String x:Key="MonthlyDeleteAll_Error">Błąd podczas usuwania danych statystyk miesięcznych:</sys:String>

