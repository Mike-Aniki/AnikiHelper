    <sys:String x:Key="VideoThumbnail_BrowseTitle">Wybierz plik ffmpeg.exe</sys:String>
    <sys:String x:Key="VideoThumbnail_FfmpegLabel">Ścieżka FFmpeg — miniatury</sys:String>
    <sys:String x:Key="VideoFfprobe_Label">Ścieżka FFprobe — wykrywanie rozdziałów</sys:String>
    <sys:String x:Key="VideoFfprobe_Help">Zazwyczaj plik ffprobe.exe znajduje się w tym samym folderze co ffmpeg.exe. Aniki wykrywa go tam automatycznie, jeśli to możliwe, ale możesz wybrać inny plik ręcznie.</sys:String>
