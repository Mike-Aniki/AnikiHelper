<UserControl x:Class="AnikiHelper.AnikiCommunityVisualPacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF0D1218">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CommunityPanelBrush" Color="#FF121A21"/>
        <SolidColorBrush x:Key="CommunityCardBrush" Color="#FF151E26"/>
        <SolidColorBrush x:Key="CommunityBorderBrush" Color="#FF2B3B47"/>
        <SolidColorBrush x:Key="CommunityAccentBrush" Color="#FF43B4C5"/>
        <SolidColorBrush x:Key="CommunityMutedBrush" Color="#FF9EB0BE"/>

        <Style x:Key="CommunityButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF1C2B35"/>
            <Setter Property="BorderBrush" Value="#FF3E5968"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF24404B"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CommunityAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommunityPrimaryButton" TargetType="Button" BasedOn="{StaticResource CommunityButton}">
            <Setter Property="Background" Value="#FF25616C"/>
            <Setter Property="BorderBrush" Value="{StaticResource CommunityAccentBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CommunityPanelBrush}"
                BorderBrush="{StaticResource CommunityBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding WindowTitle}"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding WindowDescription}"
                               Foreground="{StaticResource CommunityMutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,6,20,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{DynamicResource CommunityPack_Refresh}"
                        Style="{StaticResource CommunityButton}"
                        Width="130"
                        VerticalAlignment="Center"
                        Click="Refresh_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource CommunityMutedBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding CountText}"
                       Foreground="White"
                       FontWeight="SemiBold"
                       Margin="18,0,0,0"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock Text="{Binding EmptyText}"
                       Foreground="{StaticResource CommunityMutedBrush}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Packs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="304"
                                    Margin="0,0,12,12"
                                    Background="{StaticResource CommunityCardBrush}"
                                    BorderBrush="{StaticResource CommunityBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="9">
                                <StackPanel>
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Height" Value="158"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowPreview}" Value="False">
                                                        <Setter Property="Height" Value="44"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border Background="#FF090D11"
                                                BorderBrush="#FF31424E"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowPreview}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Image Source="{Binding PreviewImage}"
                                                       Stretch="UniformToFill"/>
                                                <TextBlock Text="{DynamicResource CommunityPack_NoPreview}"
                                                           Foreground="#8FFFFFFF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Padding="7,3"
                                                CornerRadius="3"
                                                Background="#DD8A6125">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Featured}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{DynamicResource CommunityPack_Featured}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="10"/>
                                        </Border>

                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Padding="7,3"
                                                CornerRadius="3"
                                                Background="{Binding StatusBackground}">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="10"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="2,10,2,0"/>

                                    <Grid Margin="2,4,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding AuthorDisplay}"
                                                   Foreground="#D8FFFFFF"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding VersionDisplay}"
                                                   Foreground="{StaticResource CommunityMutedBrush}"
                                                   FontSize="11"
                                                   Margin="8,0,0,0"/>
                                    </Grid>

                                    <Border Margin="2,7,2,0"
                                            Padding="7,3"
                                            CornerRadius="4"
                                            Background="#338A6125"
                                            BorderBrush="#668A6125"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasParentCompletePack}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ParentCompletePackDisplay}"
                                                   Foreground="#FFE2BE78"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource CommunityMutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Height="48"
                                               Margin="2,8,2,8"/>

                                    <Button Content="{Binding ActionText}"
                                            IsEnabled="{Binding CanAction}"
                                            Style="{StaticResource CommunityPrimaryButton}"
                                            Click="PackAction_Click"
                                            Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
