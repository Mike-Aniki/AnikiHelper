<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pctrls="clr-namespace:Playnite.FullscreenApp.Controls;assembly=Playnite.FullscreenApp"
    xmlns:pin="clr-namespace:Playnite.Input;assembly=Playnite"
    KeyboardNavigation.TabNavigation="Cycle"
    KeyboardNavigation.DirectionalNavigation="Contained">

    <UserControl.Resources>
        <!-- Deliberately fixed semantic accent for Complete Pack membership/content metadata. -->
        <SolidColorBrush x:Key="CommunityPackInfoAccentBrush" Color="#F2C96D"/>

        <LinearGradientBrush x:Key="CommunityPreviewFadeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource Transparent}" Offset="0.24"/>
            <GradientStop Color="{DynamicResource HubBannerBackground}" Offset="0.58"/>
            <GradientStop Color="{DynamicResource HubCardBottomBackground}" Offset="1"/>
        </LinearGradientBrush>

        <!-- Community top-bar categories use the same visual language as the Hub top bar. -->
        <Style x:Key="CommunityTopBarTabStyle" TargetType="{x:Type pctrls:ButtonEx}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type pctrls:ButtonEx}">
                        <Grid x:Name="Root" SnapsToDevicePixels="True">
                            <Border x:Name="HoverBackground"
                                    CornerRadius="9"
                                    Background="Transparent"
                                    Opacity="0"/>
                            <ContentPresenter x:Name="ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{DynamicResource FontMain}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              Opacity="0.78"/>
                            <Border x:Name="FocusBorder"
                                    Height="3"
                                    Width="74"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,1"
                                    CornerRadius="2"
                                    Background="{DynamicResource FocusGameBorderBrush}"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContentHost" Property="Opacity" Value="0.96"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="ContentHost" Property="Opacity" Value="1"/>
                                <Setter TargetName="FocusBorder" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverBackground" Property="Opacity" Value="1"/>
                                <Setter TargetName="HoverBackground" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommunityTopBarToolStyle" TargetType="{x:Type pctrls:ButtonEx}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="122"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type pctrls:ButtonEx}">
                        <Grid SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{DynamicResource FontMain}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              Opacity="0.76"/>
                            <Border x:Name="FocusBorder"
                                    Height="3"
                                    Width="82"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    CornerRadius="2"
                                    Background="{DynamicResource FocusGameBorderBrush}"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContentHost" Property="Opacity" Value="0.96"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="ContentHost" Property="Opacity" Value="1"/>
                                <Setter TargetName="FocusBorder" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same focus model as the Hub cards: the card border itself changes and scales. -->
        <Style x:Key="CommunityCardButtonStyle" TargetType="{x:Type pctrls:ButtonEx}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type pctrls:ButtonEx}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The Hub border visuals are kept here, but the scale is intentionally NOT here.
             This Border lives inside the 16:9 Viewbox; scaling it here would look like an internal zoom. -->
        <Style x:Key="CommunityCardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource HubBannerBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HubCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type pctrls:ButtonEx}}}"
                             Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CommunityDetailsButtonStyle" TargetType="{x:Type pctrls:ButtonEx}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundNoFocus}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HubCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontMain}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type pctrls:ButtonEx}">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="ButtonBorder"
                                    CornerRadius="11"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="3"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonDetailsColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundMenu}"
          Opacity="0">

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.68">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Real controller shortcuts. The footer below uses the theme's ButtonBottomMenu styles,
             so icons automatically follow the user's selected controller icon pack. -->
        <Grid.InputBindings>
            <pin:GameControllerInputBinding Button="B" Command="{Binding BackCommand}"/>
            <pin:GameControllerInputBinding Button="LeftShoulder" Command="{Binding PreviousCategoryCommand}"/>
            <pin:GameControllerInputBinding Button="RightShoulder" Command="{Binding NextCategoryCommand}"/>
            <pin:GameControllerInputBinding Button="X" Command="{Binding SortShortcutCommand}"/>
        </Grid.InputBindings>

        <!-- Subtle content dimmer: keeps the active Theme Color but lets artwork/cards stand out. -->
        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Background="{DynamicResource OverlayMenu}"
                Opacity="0.18"
                IsHitTestVisible="False"/>

        <!-- Hub-style glass top bar -->
        <Grid Grid.Row="0" Panel.ZIndex="10">
            <Border Background="{DynamicResource TopBar}" Opacity="{DynamicResource OpacityBar}"/>
            <Border Background="{DynamicResource GlassMainBrush}" Opacity="{DynamicResource OpacityBar}" IsHitTestVisible="False"/>
            <Border Height="1.5" VerticalAlignment="Bottom" Background="{DynamicResource SeparatorTopBarBrush}" Opacity="{DynamicResource OpacityBar}"/>

            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="{Binding ActiveSectionTitle}"
                           FontSize="19"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>

                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding Tabs}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <pctrls:ButtonEx Tag="SelectTab" Style="{StaticResource CommunityTopBarTabStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="✦"
                                               FontFamily="Segoe UI Symbol"
                                               Foreground="{DynamicResource TextHighlightBrush}"
                                               FontSize="11"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="{DynamicResource FontMain}"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNew}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </pctrls:ButtonEx>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <pctrls:ButtonEx Content="{Binding SortText}" Tag="CycleSort" Style="{StaticResource CommunityTopBarToolStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Active section header -->
        <Grid Grid.Row="1" Margin="34,0,34,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextAltBrush}"
                           FontSize="14"
                           Margin="0,0,20,0"
                           TextWrapping="Wrap"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding CountText}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <TextBlock Text="{Binding EmptyText}"
                       Foreground="{DynamicResource TextAltBrush}"
                       FontSize="23"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer x:Name="CatalogScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Focusable="False">
                <ItemsControl ItemsSource="{Binding Packs}"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.TabNavigation="Continue"
                              Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid IsItemsHost="True" Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Pure XAML 16:9 card: Viewbox keeps the logical canvas ratio.
                                     No converter and no runtime size calculation are needed. -->
                                <Viewbox Margin="17,8,17,17"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Top"
                                         Stretch="Uniform"
                                         StretchDirection="Both"
                                         UseLayoutRounding="True"
                                         SnapsToDevicePixels="True"
                                         RenderTransformOrigin="0.5,0.5"
                                         Tag="CommunityCard">
                                    <!-- The WHOLE 16:9 card scales, outside its logical 560x315 canvas.
                                         This reproduces the Hub focus without zooming the artwork inside the card. -->
                                    <Viewbox.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Viewbox.RenderTransform>
                                    <Viewbox.Style>
                                        <Style TargetType="Viewbox">
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                 To="1.035" Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                 To="1.035" Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                 To="1" Duration="0:0:0.14">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                 To="1" Duration="0:0:0.14">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Viewbox.Style>
                                    <Border Width="560"
                                            Height="315"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False">
                                    <pctrls:ButtonEx Tag="CardAction"
                                                     Style="{StaticResource CommunityCardButtonStyle}"
                                                     HorizontalContentAlignment="Stretch"
                                                     VerticalContentAlignment="Stretch"
                                                     Focusable="True">
                                        <Border CornerRadius="18"
                                                Style="{StaticResource CommunityCardBorderStyle}">
                                            <Grid>
                                                <!-- Same full-card opacity-mask pattern used by the Hub cards.
                                                     This avoids 1px leaks / square corners at fractional DPI scales. -->
                                                <Border x:Name="CommunityCardMask"
                                                        Background="{DynamicResource BlackColorBrush}"
                                                        CornerRadius="16"/>

                                                <Grid>
                                                    <Grid.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=CommunityCardMask}"
                                                                     Stretch="Fill"/>
                                                    </Grid.OpacityMask>

                                                <!-- Artwork-only cards. Detailed description/actions now live in Pack Details. -->
                                                <Grid ClipToBounds="True">
                                                    <Border x:Name="ArtworkMask"
                                                            CornerRadius="16"
                                                            Background="{DynamicResource HubCardMaskImageBrush}"/>
                                                    <Image Source="{Binding PreviewImage}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="Fant">
                                                        <Image.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=ArtworkMask}"
                                                                         Stretch="Fill"
                                                                         RenderOptions.BitmapScalingMode="Fant"/>
                                                        </Image.OpacityMask>
                                                    </Image>

                                                    <TextBlock Text="{DynamicResource CommunityPack_NoPreview}"
                                                               Foreground="{DynamicResource TextAltBrush}"
                                                               FontSize="17"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Border Background="{DynamicResource HubCardImageDimBrush}" Opacity="0.34"/>
                                                    <Border Background="{StaticResource CommunityPreviewFadeBrush}"/>

                                                    <!-- Shop cards stay intentionally minimal. Full metadata and Complete Pack contents live in Pack Details. -->
                                                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="22"
                                                                   FontWeight="SemiBold"
                                                                   LineHeight="24"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="50"
                                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>

                                                        <TextBlock Text="{Binding AuthorDisplay}"
                                                                   Foreground="{DynamicResource TextAltBrush}"
                                                                   FontSize="15"
                                                                   Opacity="0.9"
                                                                   Margin="0,5,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>

                                                        <!-- Generated child packs keep only their Complete Pack reference on the shop card, at the very bottom. -->
                                                        <TextBlock Text="{Binding ParentCompletePackDisplayWithoutIcon}"
                                                                   Foreground="{StaticResource CommunityPackInfoAccentBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,5,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontFamily" Value="{DynamicResource FontMain}"/>
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasParentCompletePack}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Margin="12">
                                                        <Border Margin="0,0,7,0"
                                                                Padding="10,4"
                                                                CornerRadius="8"
                                                                Background="{DynamicResource HubSuggestedGameBannerBackgroundBrush}"
                                                                BorderBrush="{DynamicResource TextHighlightBrush}"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Featured}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{DynamicResource CommunityPack_Featured}"
                                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                                        </Border>

                                                        <Border Padding="10,4"
                                                                CornerRadius="8"
                                                                Background="{DynamicResource HubSuggestedGameBannerBackgroundBrush}"
                                                                BorderBrush="{DynamicResource TextHighlightBrush}"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{DynamicResource CommunityHub_NewBadge}"
                                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                                        </Border>

                                                        <!-- Popular discovery badge: no public download score. -->
                                                        <Border Margin="7,0,0,0"
                                                                Padding="11,4"
                                                                CornerRadius="8"
                                                                Background="{DynamicResource HubSuggestedGameBannerBackgroundBrush}"
                                                                BorderBrush="{DynamicResource TextHighlightBrush}"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPopular}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="✦"
                                                                           FontFamily="Segoe UI Symbol"
                                                                           Foreground="{DynamicResource TextHighlightBrush}"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,5,0"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                                                <TextBlock Text="{DynamicResource CommunityHub_PopularBadge}"
                                                                           Foreground="{DynamicResource TextHighlightBrush}"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"
                                                                           VerticalAlignment="Center"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="12"
                                                            Padding="11,5"
                                                            CornerRadius="9"
                                                            BorderThickness="1"
                                                            BorderBrush="{DynamicResource FocusGameBorderBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Background" Value="{DynamicResource HubSuggestedGameBannerBackgroundBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Background" Value="{DynamicResource HubSuggestedGameBannerBackgroundBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource TextHighlightBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontSize="13"
                                                                   FontWeight="Bold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                                    </Border>
                                                </Grid>

                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </pctrls:ButtonEx>
                                    </Border>
                                </Viewbox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Real Community Packs loading state. The catalog content stays hidden until RefreshAsync completes. -->
        <Grid Grid.Row="1"
              Grid.RowSpan="2"
              Panel.ZIndex="30"
              IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="34"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>

                <ProgressBar Width="360"
                             Height="6"
                             Margin="0,18,0,0"
                             IsIndeterminate="True"/>
            </StackPanel>
        </Grid>

        <!-- Native Aniki bottom bar. These styles resolve IconAButton/IconBButton/etc. dynamically
             from the active controller-icon resources exactly like Main/Screenshot views. -->
        <Border Grid.Row="3"
                Height="52"
                Padding="16,0"
                VerticalAlignment="Bottom"
                Background="{DynamicResource BottomBar}"
                Panel.ZIndex="20">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Effect="{DynamicResource SoftTextShadow}"
                            Opacity="0.75">
                    <StackPanel.LayoutTransform>
                        <ScaleTransform ScaleX="0.82" ScaleY="0.82"/>
                    </StackPanel.LayoutTransform>
                    <pctrls:ButtonEx Style="{DynamicResource ButtonBottomMenuShouldersDark}"
                                     Content="{DynamicResource LOCSwitchSection}"/>
                    <pctrls:ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                     Tag="X"
                                     Content="{DynamicResource LOCSortby}"/>
                    <pctrls:ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                     Tag="B"
                                     Command="{Binding BackCommand}"
                                     Content="{DynamicResource LOCBackLabel}"/>
                    <pctrls:ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                     Tag="A"
                                     Content="{Binding FooterPrimaryActionText}"/>
                </StackPanel>
            </Grid>
        </Border>


        <!-- Pack Details modal. The preview keeps a strict 16:9 frame and actions live beside it. -->
        <Grid Grid.RowSpan="4"
              Panel.ZIndex="800"
              KeyboardNavigation.DirectionalNavigation="Contained"
              KeyboardNavigation.TabNavigation="Cycle">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource HubBannerBackgroundBrush}" Opacity="0.94"/>

            <Border Margin="52,44"
                    MaxWidth="1540"
                    MaxHeight="650"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    CornerRadius="24"
                    Background="{DynamicResource BackgroundMenu}"
                    BorderBrush="{DynamicResource HubCardBorderBrush}"
                    BorderThickness="2"
                    Padding="30">
                <!-- Keep Pack Details on one logical canvas and only scale it DOWN when DPI/window space requires it.
                     This prevents fixed WPF DIP sizes (680px preview, fonts, margins, buttons) from becoming physically
                     oversized at 125%/150% Windows scaling while preserving the exact layout at normal size. -->
                <Viewbox Stretch="Uniform"
                         StretchDirection="DownOnly"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Grid Width="1480" Height="454.5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58"/>
                            <RowDefinition Height="396.5"/>
                        </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DetailsTitle}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                        <Border Grid.Column="1"
                                CornerRadius="8"
                                Padding="12,5"
                                VerticalAlignment="Center"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource HubSuggestedGameBannerBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource HubCardBorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPack.IsInstalled}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HubSuggestedGameBannerBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPack.UpdateAvailable}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HubSuggestedGameBannerBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource TextHighlightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SelectedPack.StatusLabel}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                        </Border>
                    </Grid>

                    <!-- The right column has the exact same height as the 16:9 preview, so its actions align with the image bottom. -->
                    <Grid Grid.Row="1" Margin="0,14,0,0" Height="382.5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="680"/>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*" MinWidth="330"/>
                        </Grid.ColumnDefinitions>

                        <!-- Strict 16:9 preview: 680 x 382.5. A real opacity mask clips the artwork to the rounded inner frame. -->
                        <Border Grid.Column="0"
                                Width="680"
                                Height="382.5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                CornerRadius="18"
                                Background="{DynamicResource HubBannerBackgroundBrush}"
                                BorderBrush="{DynamicResource HubCardBorderBrush}"
                                BorderThickness="2">
                            <Grid>
                                <Border x:Name="DetailsPreviewMask"
                                        Margin="2"
                                        CornerRadius="16"
                                        Background="{DynamicResource BlackColorBrush}"/>

                                <Grid Margin="2">
                                    <Grid.OpacityMask>
                                        <VisualBrush Visual="{Binding ElementName=DetailsPreviewMask}"
                                                     Stretch="Fill"
                                                     RenderOptions.BitmapScalingMode="Fant"/>
                                    </Grid.OpacityMask>

                                    <Image Source="{Binding SelectedPack.PreviewImage}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="Fant"/>

                                    <TextBlock Text="{DynamicResource CommunityPack_NoPreview}"
                                               Foreground="{DynamicResource TextAltBrush}"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="{DynamicResource FontMain}"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPack.HasPreview}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Pack metadata + description + actions -->
                        <Grid Grid.Column="2" Height="382.5" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding SelectedPack.Name}"
                                       FontSize="34"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="82"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding SelectedPack.AuthorLine}"
                                       Foreground="{DynamicResource TextAltBrush}"
                                       FontSize="18"
                                       Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>

                            <WrapPanel Grid.Row="2" Margin="0,13,0,0">
                                <Border Background="{DynamicResource ButtonBackgroundNoFocus}" BorderBrush="{DynamicResource HubCardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,7,6">
                                    <TextBlock Text="{Binding SelectedPack.PackTypeDisplay}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                </Border>
                                <Border Background="{DynamicResource ButtonBackgroundNoFocus}" BorderBrush="{DynamicResource HubCardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,7,6">
                                    <TextBlock Text="{Binding SelectedPack.VersionDisplay}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                </Border>
                                <Border Background="{DynamicResource ButtonBackgroundNoFocus}" BorderBrush="{DynamicResource HubCardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,7,6">
                                    <TextBlock Text="{Binding SelectedPack.DownloadCountDisplay}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                </Border>
                                <Border Background="{DynamicResource HubSuggestedGameBannerBackgroundBrush}" BorderBrush="{DynamicResource TextHighlightBrush}" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,7,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPack.Featured}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{DynamicResource CommunityPack_Featured}"
                                               Foreground="{DynamicResource TextHighlightBrush}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                </Border>
                                <Border Background="{DynamicResource HubSuggestedGameBannerBackgroundBrush}" BorderBrush="{DynamicResource TextHighlightBrush}" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,7,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPack.IsPopular}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{DynamicResource CommunityHub_PopularBadge}"
                                               Foreground="{DynamicResource TextHighlightBrush}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                </Border>
                            </WrapPanel>

                            <StackPanel Grid.Row="3" Margin="0,3,0,0">
                                <TextBlock Text="{Binding SelectedPack.ReleaseDateDisplay}"
                                           Foreground="{DynamicResource TextAltBrush}"
                                           FontSize="15"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                <TextBlock Text="{Binding SelectedPack.ParentCompletePackDisplayWithoutIcon}"
                                           Foreground="{StaticResource CommunityPackInfoAccentBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{DynamicResource FontMain}"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPack.HasParentCompletePack}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Complete Pack contents. Only the components actually present in componentIds are shown. -->
                            <StackPanel Grid.Row="4" Margin="0,9,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPack.HasCompleteComponents}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{DynamicResource CommunityPack_IncludesLabel}"
                                           Foreground="{StaticResource CommunityPackInfoAccentBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                <WrapPanel>
                                    <Border Background="{DynamicResource ButtonBackgroundNoFocus}" BorderBrush="{StaticResource CommunityPackInfoAccentBrush}" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,7,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPack.HasVisualComponent}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{DynamicResource CommunityHub_TabVisual}"
                                                   Foreground="{StaticResource CommunityPackInfoAccentBrush}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                    </Border>
                                    <Border Background="{DynamicResource ButtonBackgroundNoFocus}" BorderBrush="{StaticResource CommunityPackInfoAccentBrush}" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,7,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPack.HasLoginComponent}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{DynamicResource CommunityHub_TabLogin}"
                                                   Foreground="{StaticResource CommunityPackInfoAccentBrush}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                    </Border>
                                    <Border Background="{DynamicResource ButtonBackgroundNoFocus}" BorderBrush="{StaticResource CommunityPackInfoAccentBrush}" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,7,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPack.HasColorComponent}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{DynamicResource CommunityHub_TabColor}"
                                                   Foreground="{StaticResource CommunityPackInfoAccentBrush}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                    </Border>
                                    <Border Background="{DynamicResource ButtonBackgroundNoFocus}" BorderBrush="{StaticResource CommunityPackInfoAccentBrush}" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,7,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPack.HasSoundComponent}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{DynamicResource CommunityHub_TabSound}"
                                                   Foreground="{StaticResource CommunityPackInfoAccentBrush}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <ScrollViewer Grid.Row="5"
                                          Margin="0,10,0,8"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <TextBlock Text="{Binding SelectedPack.Description}"
                                           Foreground="{DynamicResource TextAltBrush}"
                                           FontSize="17"
                                           LineHeight="22"
                                           TextWrapping="Wrap"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                            </ScrollViewer>

                            <!-- Actions are on the information side and share the preview's bottom baseline. -->
                            <WrapPanel Grid.Row="6"
                                       VerticalAlignment="Bottom"
                                       Margin="0,4,0,0">
                                <pctrls:ButtonEx Tag="DetailsInstallOrUpdate"
                                                 Content="{Binding SelectedPack.ActionText}"
                                                 IsEnabled="{Binding SelectedPack.CanAction}">
                                    <pctrls:ButtonEx.Style>
                                        <Style TargetType="{x:Type pctrls:ButtonEx}" BasedOn="{StaticResource CommunityDetailsButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPack.HasInstallOrUpdateAction}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </pctrls:ButtonEx.Style>
                                </pctrls:ButtonEx>

                                <pctrls:ButtonEx Tag="DetailsUninstall"
                                                 Content="{DynamicResource CommunityPack_Uninstall}"
                                                 IsEnabled="{Binding SelectedPack.CanUninstall}">
                                    <pctrls:ButtonEx.Style>
                                        <Style TargetType="{x:Type pctrls:ButtonEx}" BasedOn="{StaticResource CommunityDetailsButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPack.IsInstalled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </pctrls:ButtonEx.Style>
                                </pctrls:ButtonEx>

                                <pctrls:ButtonEx Tag="DetailsReport"
                                                 Content="{Binding DetailsReportText}"
                                                 Style="{StaticResource CommunityDetailsButtonStyle}"/>

                                <pctrls:ButtonEx Tag="DetailsClose"
                                                 Content="{Binding DetailsBackText}"
                                                 Style="{StaticResource CommunityDetailsButtonStyle}"/>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Grid>
                </Viewbox>
            </Border>
        </Grid>

        <!-- The Playnite dialog is a separate modal window; this layer dims the Community Hub behind it. -->
        <Border Grid.RowSpan="4"
                Panel.ZIndex="900"
                Background="{DynamicResource HubBannerBackgroundBrush}"
                Opacity="0.72"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDialogOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
