                                            <TextBlock Text="{DynamicResource SettingsHome_SteamFriends}" Style="{StaticResource SettingsHomeStatusLabel}"/>
                                            <TextBlock Grid.Column="1"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SettingsHomeStatusValue}"><Setter Property="Text" Value="{DynamicResource SettingsStatus_Disabled}"/><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Settings.SteamFriendsEnabled}" Value="True"><Setter Property="Text" Value="{DynamicResource SettingsStatus_Enabled}"/><Setter Property="Foreground" Value="#FF70D89B"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </Grid>

                                        <Grid Style="{StaticResource SettingsHomeStatusRow}">
