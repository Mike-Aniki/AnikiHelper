                                                    <Setter Property="Text" Value="{DynamicResource SettingsStatus_NotInstalled}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HomeScreenshotUtilitiesLocalProviderInstalled}" Value="True">
                                                            <Setter Property="Text" Value="{DynamicResource SettingsStatus_Installed}"/>
                                                            <Setter Property="Foreground" Value="#FF70D89B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2"
                                                Content="{DynamicResource SettingsHome_Install}"
