                                                                Foreground="#FFFF8A8A"/>
                                                    </StackPanel>
                                
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="1"
                                                               Grid.ColumnSpan="2"
                                                               Text="{DynamicResource SteamAccount_UnifiedInfoPrivacy}"
                                                               Style="{StaticResource SmallNoteText}"
                                                               Foreground="#FF5BE39A"
                                                               Margin="10,10,0,0"
                                                               TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                
                                
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
