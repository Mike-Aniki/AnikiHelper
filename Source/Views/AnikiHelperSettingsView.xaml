                                                                    <Setter Property="Fill" Value="#26FFB000"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Settings.SteamAccountConnected}" Value="True">
                                                                            <Setter Property="Fill" Value="#2636D17A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                
                                                        <TextBlock Text="!"
                                                                   FontWeight="Bold"
                                                                   FontSize="16"
                                                                   Foreground="#FFFFB000"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Settings.SteamAccountConnected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                
                                                        <TextBlock Text="✓"
                                                                   FontFamily="Segoe UI Symbol"
                                                                   FontWeight="Bold"
                                                                   FontSize="15"
                                                                   Foreground="#FF36D17A"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Settings.SteamAccountConnected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                
                                                    <!-- Disconnected state -->
                                                    <StackPanel Grid.Column="1"
                                                                Margin="10,0,20,0"
                                                                VerticalAlignment="Center">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Settings.SteamAccountConnected}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                
                                                        <TextBlock Text="{DynamicResource SteamAccount_DisconnectedTitle}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="15"
                                                                   Foreground="White"
                                                                   TextWrapping="Wrap"/>
