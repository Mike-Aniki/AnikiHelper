                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="11"
                                                                   Margin="0,5,0,0"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                
                                                    <!-- Connected state -->
                                                    <StackPanel Grid.Column="1"
                                                                Margin="10,0,20,0"
                                                                VerticalAlignment="Center">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Settings.SteamAccountConnected}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                
                                                        <TextBlock Text="{DynamicResource SteamAccount_ConnectedTitle}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="15"
                                                                   Foreground="White"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{DynamicResource SteamAccount_ConnectedDesc}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   Margin="0,3,0,0"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Settings.SteamAccountStatus}"
                                                                   FontSize="11"
                                                                   Margin="0,5,0,0"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#FFFFC247"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Settings.SteamAccountServicesReady}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FF5BE39A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                            <TextBlock Text="{DynamicResource SteamAccount_SteamIdLabel}"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,0,5,0"/>
                                                            <TextBlock Text="{Binding Settings.SteamAccountDisplayName}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                
                                                    <!-- Actions when disconnected -->
                                                    <Grid Grid.Column="2"
                                                          VerticalAlignment="Center">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Settings.SteamAccountConnected}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Settings.SteamAccountBusy}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Opacity" Value="0.55"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Button Style="{StaticResource SettingsInlineButton}" Content="{DynamicResource SteamAccount_ConnectButton}"
                                                                Command="{Binding Settings.ConnectSteamAccountCommand}"
                                                                Padding="14,7"
                                                                MinWidth="150"/>
                                                    </Grid>
                                
                                                    <!-- Actions when connected -->
                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Settings.SteamAccountConnected}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Settings.SteamAccountBusy}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Opacity" Value="0.55"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                
                                                        <Button Style="{StaticResource SettingsInlineButton}" Content="{DynamicResource SteamAccount_CheckButton}"
