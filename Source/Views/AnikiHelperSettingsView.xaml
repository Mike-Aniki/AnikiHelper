                                                           Text="{DynamicResource GroupDynColors}"/>
                                            </Grid>
                                        </Border>
                                
                                        <StackPanel Margin="12,10,12,12">
                                
                                            <TextBlock Text="{DynamicResource L_DynAutoPrecache_Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       Margin="0,4,0,4"
                                                       TextWrapping="Wrap"/>
                                
                                            <TextBlock Text="{DynamicResource L_EnableDynamicAutoPrecache_Desc}"
                                                       Style="{StaticResource SectionDescription}"
                                                       Margin="0,4,0,4"
                                                       TextWrapping="Wrap"/>
                                
                                            <CheckBox Content="{DynamicResource L_EnableDynamicAutoPrecache}"
                                                      IsChecked="{Binding Settings.DynamicAutoPrecacheUserEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="{DynamicResource L_EnableDynamicAutoPrecache_Tooltip}"
                                                      Margin="0,4,0,4"/>
                                
                                            <TextBlock Text="{DynamicResource L_EnableDynamicAutoPrecache_Note}"
                                                       Style="{StaticResource SmallNoteText}"/>
                                
                                            <Border Style="{StaticResource SectionSeparator}"/>
                                
                                            <TextBlock Text="{DynamicResource L_CacheManagement_Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       Margin="0,0,0,4"
                                                       TextWrapping="Wrap"/>
                                
                                            <TextBlock Text="{DynamicResource L_ClearColorCache_Desc}"
                                                       Style="{StaticResource SectionDescription}"
                                                       Margin="0,4,0,4"
                                                       TextWrapping="Wrap"/>
                                
                                            <Button Content="{DynamicResource L_ClearColorCache}"
                                                    Margin="0,4,0,4"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="ClearColorCache_Click"
                                                    ToolTip="{DynamicResource L_ClearColorCache_Tooltip}"/>
                                
                                            <TextBlock Text="{DynamicResource DynColors_Help}"
                                                       Style="{StaticResource SmallNoteText}"/>
                                
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource SettingsNav_Diagnostics}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,8,22,26">
                            <Border Style="{StaticResource SettingsPageHeaderCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="5"
                                            CornerRadius="3"
                                            Background="{StaticResource HomeGoldBrush}"
                                            VerticalAlignment="Stretch"/>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="{DynamicResource SettingsNav_Diagnostics}" Style="{StaticResource SettingsPageTitle}"/>
                                        <TextBlock Text="{DynamicResource SettingsPage_DiagnosticsDesc}" Style="{StaticResource SettingsPageDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                                            <!-- ========= DEBUG ========= -->
                                            <Border Style="{StaticResource SectionCard}">
                                                <StackPanel>
                                
                                                    <Border Style="{StaticResource SectionHeaderBar}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                
                                                            <Border Grid.Column="0"
                                                                    Background="{StaticResource AccentBrush}"
                                                                    CornerRadius="2"
                                                                    Margin="0,2,8,2"/>
                                
                                                            <TextBlock Grid.Column="1"
                                                                       Style="{StaticResource SectionHeaderTitle}"
                                                                       Text="{DynamicResource LOCDebugLogsTitle}"/>
                                                        </Grid>
                                                    </Border>
                                
                                                    <StackPanel Margin="12,10,12,12">
                                
                                                        <TextBlock Text="{DynamicResource LOCDebugLogsDescription}"
                                                                   Style="{StaticResource SectionDescription}"
                                                                   TextWrapping="Wrap"/>
                                
                                                        <CheckBox Content="{DynamicResource LOCEnableDebugLogs}"
                                                                  IsChecked="{Binding Settings.EnableDebugLogs, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="0,4,0,8"/>
                                
                                                        <TextBlock Text="{DynamicResource LOCDebugLogsInfo}"
                                                                   Style="{StaticResource SmallNoteText}"
                                                                   Margin="0,4,0,8"/>
                                
                                                        <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                                
                                                            <Button Style="{StaticResource SettingsInlineButton}" Content="{DynamicResource LOCClearLogFile}"
                                Click="ClearLogFile_Click"
                                Margin="0,0,8,0"/>
                                
                                                            <Button Style="{StaticResource SettingsInlineButton}" Content="{DynamicResource LOCOpenLogsFolder}"
                                Click="OpenLogsFolder_Click"/>
                                
                                                        </StackPanel>
                                
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
