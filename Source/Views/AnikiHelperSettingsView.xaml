<UserControl x:Class="AnikiHelper.AnikiHelperSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="639"
             d:DesignHeight="399"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <SolidColorBrush x:Key="Surface1Brush" Color="#E61A2026"/>

        <!-- Borders / separators -->
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushHover" Color="#3DFFFFFF"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#1FFFFFFF"/>

        <!-- Text -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3B3B3"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8A8A"/>

        <!-- Single accent (keep your identity here) -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF32CFE5"/>
        <SolidColorBrush x:Key="HomeGoldBrush" Color="#FFE6B86A"/>
        <SolidColorBrush x:Key="HomeCyanBrush" Color="#FF32CFE5"/>
        <SolidColorBrush x:Key="HomeGreenBrush" Color="#FF70D89B"/>
        <SolidColorBrush x:Key="HomePanelBorderBrush" Color="#38FFFFFF"/>

        <!-- Cards -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="#3547D7E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F21D2329" Offset="0"/>
                        <GradientStop Color="#EC14191F" Offset="0.68"/>
                        <GradientStop Color="#E90D1319" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.28"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section header inside card -->
        <Style x:Key="SectionHeaderBar" TargetType="Border">
            <Setter Property="Background" Value="#10101820"/>
            <Setter Property="BorderBrush" Value="#2A32CFE5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="10,10,0,0"/>
            <Setter Property="Padding" Value="12,10,12,11"/>
            <Setter Property="Margin" Value="-6,-6,-6,12"/>
        </Style>
        <Style x:Key="SectionHeaderTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HomeGoldBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B9C3C9CD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#2832CFE5"/>
            <Setter Property="Margin" Value="0,14,0,14"/>
        </Style>
        <Style x:Key="SmallNoteText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#91A0A8AD"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Buttons: flat clean -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#1732CFE5"/>
            <Setter Property="BorderBrush" Value="#6A32CFE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="8,2"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2732CFE5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#B032CFE5"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#32CFE5" BlurRadius="12" ShadowDepth="0" Opacity="0.20"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1232CFE5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource HomeGoldBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#26FF5C5C"/>
            <Setter Property="BorderBrush" Value="#A6FF5C5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="8,2"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3DFF5C5C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E6FF7474"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF5C5C" BlurRadius="12" ShadowDepth="0" Opacity="0.22"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1FFF5C5C"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource HomeGoldBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Settings navigation -->
        <Style x:Key="SettingsTopTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,12,18,8"/>
            <Setter Property="Margin" Value="2,0,8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent"
                              SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <Border x:Name="SelectedLine"
                                    Grid.Row="1"
                                    Height="3"
                                    Margin="10,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"
                                    Background="#E6B86A"
                                    CornerRadius="2"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectedLine" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsSideTabItemStyle" TargetType="TabItem">
            <Setter Property="Width" Value="228"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,14,6"/>
            <Setter Property="Padding" Value="17,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="SideTabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="4,0,0,0"
                                CornerRadius="0,10,10,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SideTabBorder" Property="Background" Value="#2032CFE5"/>
                                <Setter TargetName="SideTabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SideTabBorder" Property="Background" Value="#1432CFE5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsPageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="SettingsPageDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB9BFC4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="SettingsHomeHeroCard" TargetType="Border">
            <Setter Property="Margin" Value="0,6,0,12"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderBrush" Value="#3547D7E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F0182029" Offset="0"/>
                        <GradientStop Color="#F00C151D" Offset="0.55"/>
                        <GradientStop Color="#E6071119" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="2" Opacity="0.32"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsHomeHeroBadge" TargetType="Border">
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="74"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="BorderBrush" Value="#A8E6B86A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3A32CFE5" Offset="0"/>
                        <GradientStop Color="#2AE6B86A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#32CFE5" BlurRadius="18" ShadowDepth="0" Opacity="0.32"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsHomeSummaryChip" TargetType="Border">
            <Setter Property="MinWidth" Value="135"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#B8141B22"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsHomeCard" TargetType="Border">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MinHeight" Value="255"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="{StaticResource HomePanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EF20252B" Offset="0"/>
                        <GradientStop Color="#EA151A20" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.28"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsHomeHeaderBadge" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingsHomeCardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingsHomeStatusLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8D0D5D9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingsHomeStatusValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="SettingsHomeStatusRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>

        <Style x:Key="SettingsHomeInstallButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#6BE6B86A"/>
            <Setter Property="Background" Value="#18E6B86A"/>
        </Style>

        <Style x:Key="SettingsHomeActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="BorderBrush" Value="#6A32CFE5"/>
            <Setter Property="Background" Value="#1532CFE5"/>
        </Style>


        <Style x:Key="SettingsPageHeaderCard" TargetType="Border">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#3047D7E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E8182028" Offset="0"/>
                        <GradientStop Color="#DB10171D" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="1" Opacity="0.22"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsInlineButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16,12,16,16">
        <TabControl x:Name="MainSettingsTabs" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsTopTabItemStyle}">

            <TabItem Header="{DynamicResource SettingsNav_Home}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,8,18,24">
                        <Border Style="{StaticResource SettingsHomeHeroCard}">
                            <Grid>
                                <Border Margin="-22"
                                        CornerRadius="20"
                                        BorderThickness="0"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <RadialGradientBrush Center="1,0.5"
                                                             GradientOrigin="1,0.5"
                                                             RadiusX="0.38"
                                                             RadiusY="1">
                                            <GradientStop Color="#2632CFE5" Offset="0"/>
                                            <GradientStop Color="#1232CFE5" Offset="0.50"/>
                                            <GradientStop Color="#0032CFE5" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource SettingsHomeHeroBadge}">
                                        <Image Source="{Binding HomePluginIconPath}"
                                               Width="52"
                                               Height="52"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource AppTitle}" Style="{StaticResource SettingsPageTitle}" FontSize="34"/>
                                        <TextBlock Text="{DynamicResource SettingsHome_Intro}" Style="{StaticResource SettingsPageDescription}" FontSize="14" MaxWidth="760" Margin="0,7,0,0" HorizontalAlignment="Left" TextAlignment="Left"/>
                                    </StackPanel>

                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Margin="-6,0,-6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Theme features and active Fullscreen theme -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsHomeCard}" BorderBrush="#58E6B86A">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SettingsHomeHeaderBadge}" Background="#22E6B86A" BorderBrush="#70E6B86A">
                                            <TextBlock Text="T" Foreground="{StaticResource HomeGoldBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource SettingsNav_ThemeFeatures}" Style="{StaticResource SettingsHomeCardTitle}"/>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HomeCompatibleThemeDetected}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Grid Style="{StaticResource SettingsHomeStatusRow}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource SettingsHome_ActiveTheme}" Style="{StaticResource SettingsHomeStatusLabel}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding HomeActiveFullscreenThemeName}" Style="{StaticResource SettingsHomeStatusValue}" MaxWidth="300"/>
                                            </Grid>

                                            <Grid Style="{StaticResource SettingsHomeStatusRow}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource SettingsHome_HelperIntegration}" Style="{StaticResource SettingsHomeStatusLabel}"/>
                                                <Border Grid.Column="1" Background="#1E39C878" CornerRadius="8" Padding="10,4">
                                                    <TextBlock Text="{DynamicResource SettingsHome_Compatible}" Foreground="#FF70D89B" FontWeight="SemiBold" FontSize="12"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HomeCompatibleThemeDetected}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{DynamicResource SettingsHome_NoCompatibleTheme}" Foreground="#FFE5A16A" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                            <TextBlock Text="{DynamicResource SettingsHome_NoCompatibleThemeNote}" Style="{StaticResource SectionDescription}" Margin="0,6,0,0"/>
                                        </StackPanel>

                                        <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,4,0,5"/>

                                        <Grid Style="{StaticResource SettingsHomeStatusRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource SettingsHome_WelcomeHub}" Style="{StaticResource SettingsHomeStatusLabel}"/>
